@using SIGAC.Domain
@* Teléfono con selector de código de país (bandera + código, buscable,
   Costa Rica por defecto). Se bindean dos valores: el código de país sin "+"
   (CodigoPais) y el número local (Value). El tope de dígitos y la ayuda salen
   de ReglasTelefono según el país elegido, que es la misma fuente que usa el
   validador del servidor. *@

<div class="sigac-phone-input @Class">
    <div class="sigac-phone-code">
        <MudAutocomplete T="Pais" Value="_pais" ValueChanged="OnPaisChangedAsync"
                          SearchFunc="BuscarPaisesAsync"
                          ToStringFunc="@(p => p is null ? string.Empty : $"{p.Bandera} +{p.CodigoTelefono}")"
                          Label="Código" Variant="Variant.Outlined"
                          CoerceText="true" ResetValueOnEmptyText="true" Clearable="false"
                          OpenOnFocus="true" SelectOnActivation="true"
                          aria-label="Código de país del teléfono">
            <ItemTemplate Context="pais">
                <div class="d-flex align-center" style="gap: 0.5rem; width: 100%;">
                    <span>@pais.Bandera</span>
                    <span>@pais.Nombre</span>
                    <MudSpacer />
                    <span class="mud-text-secondary">+@pais.CodigoTelefono</span>
                </div>
            </ItemTemplate>
        </MudAutocomplete>
    </div>

    <MudTextField T="string" Value="@Value" ValueChanged="OnNumeroChangedAsync" Immediate="true" Label="@Label"
                  Variant="Variant.Outlined" Class="sigac-phone-number"
                  InputMode="InputMode.tel"
                  MaxLength="ReglasTelefono.LongitudMaximaNumeroPara(_pais.CodigoTelefono)"
                  HelperText="@ReglasTelefono.DescribirNumero(_pais.CodigoTelefono)" />
</div>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    // Código de país sin "+" ("506"). Vacío equivale a Costa Rica, que es lo que
    // muestra el selector por defecto y lo que asume el validador.
    [Parameter]
    public string? CodigoPais { get; set; }

    [Parameter]
    public EventCallback<string?> CodigoPaisChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Teléfono (opcional)";

    [Parameter]
    public string? Class { get; set; }

    private Pais _pais = Paises.CostaRica;

    protected override void OnParametersSet()
    {
        // Solo se reemplaza el país cuando el código cambió desde afuera (al cargar
        // un registro para editar, o al limpiar el formulario). Si el código es el
        // mismo se respeta el país elegido: +1 puede ser Canadá o Estados Unidos.
        var codigo = string.IsNullOrWhiteSpace(CodigoPais) ? Paises.CostaRica.CodigoTelefono : CodigoPais;

        if (_pais.CodigoTelefono != codigo)
            _pais = Paises.PorCodigo(codigo);
    }

    private Task<IEnumerable<Pais>> BuscarPaisesAsync(string valor, CancellationToken token)
    {
        // Al enfocar sin haber tocado nada, MudBlazor busca con el texto que
        // ya muestra el campo (el país actualmente elegido, formateado por
        // ToStringFunc) en vez de una cadena vacía — efecto de CoerceText.
        // Ningún país tiene ese emoji+código en su nombre, así que sin este
        // caso especial la lista salía vacía al hacer foco/clic y solo
        // aparecía después de tipear (que sí dispara una búsqueda real).
        var formateado = $"{_pais.Bandera} +{_pais.CodigoTelefono}";
        IEnumerable<Pais> resultado = string.IsNullOrWhiteSpace(valor) || valor == formateado
            ? Paises.Todos
            : Paises.Todos.Where(p =>
                p.Nombre.Contains(valor, StringComparison.OrdinalIgnoreCase)
                || p.CodigoTelefono.Contains(valor, StringComparison.OrdinalIgnoreCase)
                || p.Iso2.Contains(valor, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(resultado);
    }

    private Task OnPaisChangedAsync(Pais pais)
    {
        _pais = pais ?? Paises.CostaRica;
        return CodigoPaisChanged.InvokeAsync(_pais.CodigoTelefono);
    }

    // Descarta lo que no es dígito y recorta al máximo del país mientras se
    // escribe. Es comodidad: el validador vuelve a comprobar el número completo.
    private Task OnNumeroChangedAsync(string? valor)
    {
        var filtrado = ReglasTelefono.FiltrarNumero(_pais.CodigoTelefono, valor);
        return ValueChanged.InvokeAsync(filtrado.Length == 0 ? null : filtrado);
    }
}
