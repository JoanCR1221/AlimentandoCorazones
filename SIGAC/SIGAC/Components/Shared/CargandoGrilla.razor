@* Contenido de LoadingContent para MudDataGrid: reemplaza la fila en blanco
   que se ve un instante mientras se resuelve la consulta (server-side y las
   pantallas con su propio bool "cargando"). *@
<div class="ac-cargando" role="status" aria-live="polite">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
    <span>Cargando…</span>
</div>
