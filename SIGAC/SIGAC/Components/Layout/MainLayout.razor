@inherits LayoutComponentBase
@inject AparienciaService Apariencia
@implements IDisposable

<MudThemeProvider IsDarkMode="@Apariencia.EsOscuro"
                  Theme="@Apariencia.Tema"
                  @key="@($"{Apariencia.EsOscuro}-{Apariencia.AltoContraste}")" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Abrir menú de navegación"
                       OnClick="ToggleDrawer" />
        <a href="/" class="sigac-brand" aria-label="Ir al inicio">
            <img src="img/logo.png" alt="Logo de Alimentando Corazones" class="sigac-logo" />
            <span class="sigac-brand-texto">
                <MudText Typo="Typo.h6" Class="sigac-brand-nombre">SIGAC</MudText>
                <span class="sigac-brand-lema d-none d-md-block">Alimentando Corazones</span>
            </span>
        </a>
        <MudSpacer />
        <SesionToolbar />
        <AparienciaToolbar />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader Class="pa-4 sigac-drawer-encabezado">
            <MudText Typo="Typo.h6">Panel administrativo</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="sigac-main">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Apariencia.OnChange += StateHasChanged;
            await Apariencia.InitializeAsync();
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        Apariencia.OnChange -= StateHasChanged;
    }
}
