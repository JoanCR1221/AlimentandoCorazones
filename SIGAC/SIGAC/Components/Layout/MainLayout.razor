@inherits LayoutComponentBase
@inject AparienciaService Apariencia
@implements IDisposable

<MudThemeProvider IsDarkMode="@Apariencia.EsOscuro"
                  Theme="@Apariencia.Tema"
                  @key="@($"{Apariencia.EsOscuro}-{Apariencia.AltoContraste}")" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Clima de fondo en modo claro (From Uiverse.io by Danishrehman786): capas
   fijas de textura, solo visibles cuando data-theme="light" (ver
   MainLayout.razor.css). El filtro SVG "cosmic-texture" no venía incluido
   en el CSS que se pasó, solo la clase que lo referencia; se agregó acá
   para que .cosmic-element no quede sin efecto. *@
<div class="sigac-clima-dia" aria-hidden="true">
    <div class="cosmic-element"></div>
    <div class="stars-layer"></div>
    <div class="wind-wave"></div>
    <div class="ice-crystal"></div>
</div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <filter id="cosmic-texture">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" result="noise" />
        <feColorMatrix in="noise" type="matrix" values="0 0 0 0 0.99  0 0 0 0 0.97  0 0 0 0 0.90  0 0 0 0.12 0" />
    </filter>
</svg>

<MudLayout>
    <MudAppBar Elevation="1" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Abrir menú de navegación"
                       OnClick="ToggleDrawer" />
        <a href="/" class="sigac-brand" aria-label="Ir al inicio">
            <img src="Logo.png" alt="Logo de Alimentando Corazones" class="sigac-logo" />
            <MudText Typo="Typo.h6" Class="ml-2">SIGAC</MudText>
        </a>
        <MudSpacer />
        <AparienciaToolbar />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader Class="pa-4">
            <MudText Typo="Typo.h6">Panel administrativo</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="sigac-main">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Apariencia.OnChange += StateHasChanged;
            await Apariencia.InitializeAsync();
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        Apariencia.OnChange -= StateHasChanged;
    }
}
