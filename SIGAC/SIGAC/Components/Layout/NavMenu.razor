@inject NavigationManager Navigation
@implements IDisposable

<MudNavMenu Class="pa-2">
    <MudText Typo="Typo.subtitle2" Class="px-4 py-2 mud-text-secondary">Navegación</MudText>

    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Inicio
    </MudNavLink>

    <MudNavGroup Title="Beneficiarios"
                 Icon="@Icons.Material.Filled.People"
                 Expanded="_beneficiariosExpandido"
                 ExpandedChanged="OnBeneficiariosExpandedChanged">
        <MudNavLink Href="/beneficiarios" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People">
            Ver Beneficiarios
        </MudNavLink>
        <MudNavLink Href="/beneficiarios/registrar" Icon="@Icons.Material.Filled.PersonAdd">
            Registrar Beneficiario
        </MudNavLink>
        <MudNavLink Href="/donaciones/entregas/registrar" Icon="@Icons.Material.Filled.LocalShipping">
            Entregar Donación
        </MudNavLink>
        <MudNavLink Href="/donaciones/entregas/historial" Icon="@Icons.Material.Filled.History">
            Historial de Entregas
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Asistencia"
                 Icon="@Icons.Material.Filled.Restaurant"
                 Expanded="_asistenciaExpandido"
                 ExpandedChanged="OnAsistenciaExpandedChanged">
        <MudNavLink Href="/asistencia/historial" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.History">
            Ver Asistencia
        </MudNavLink>
        <MudNavLink Href="/asistencia/registrar" Icon="@Icons.Material.Filled.Restaurant">
            Agregar Asistencia
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Inventario"
                 Icon="@Icons.Material.Filled.Inventory"
                 Expanded="_inventarioExpandido"
                 ExpandedChanged="OnInventarioExpandedChanged">
        <MudNavLink Href="/inventario/existencias" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Inventory2">
            Ver Existencias
        </MudNavLink>
        <MudNavLink Href="/inventario/entradas/registrar" Icon="@Icons.Material.Filled.AddBox">
            Registrar Entrada
        </MudNavLink>
        <MudNavLink Href="/inventario/prestamos/solicitar" Icon="@Icons.Material.Filled.Handshake">
            Solicitar Préstamo
        </MudNavLink>
        <MudNavLink Href="/inventario/prestamos/gestionar" Icon="@Icons.Material.Filled.FactCheck">
            Gestionar Solicitudes
        </MudNavLink>
        <MudNavLink Href="/inventario/movimientos/historial" Icon="@Icons.Material.Filled.History">
            Historial de Movimientos
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Donaciones"
                 Icon="@Icons.Material.Filled.VolunteerActivism"
                 Expanded="_donacionesExpandido"
                 ExpandedChanged="OnDonacionesExpandedChanged">
        <MudNavLink Href="/donantes" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People">
            Ver Donantes
        </MudNavLink>
        <MudNavLink Href="/donantes/registrar" Icon="@Icons.Material.Filled.PersonAdd">
            Registrar Donante
        </MudNavLink>
        <MudNavLink Href="/donaciones/dinero/registrar" Icon="@Icons.Material.Filled.AttachMoney">
            Donación en Dinero
        </MudNavLink>
        <MudNavLink Href="/donaciones/especie/registrar" Icon="@Icons.Material.Filled.Redeem">
            Donación en Especie
        </MudNavLink>
        <MudNavLink Href="/donaciones/historial" Icon="@Icons.Material.Filled.History">
            Historial de Donaciones
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Gastos Operativos"
                 Icon="@Icons.Material.Filled.Receipt"
                 Expanded="_gastosExpandido"
                 ExpandedChanged="OnGastosExpandedChanged">
        <MudNavLink Href="/gastos" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ReceiptLong">
            Ver Gastos
        </MudNavLink>
        <MudNavLink Href="/gastos/registrar" Icon="@Icons.Material.Filled.PostAdd">
            Registrar Gasto
        </MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-2" />

    <MudNavLink Href="/configuracion" Icon="@Icons.Material.Filled.Settings">
        Configuraciones
    </MudNavLink>
</MudNavMenu>

@code {
    private bool _beneficiariosExpandido;
    private bool _asistenciaExpandido;
    private bool _inventarioExpandido;
    private bool _donacionesExpandido;
    private bool _gastosExpandido;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _beneficiariosExpandido = EstaEnBeneficiarios();
        _asistenciaExpandido = EstaEnAsistencia();
        _inventarioExpandido = EstaEnInventario();
        _donacionesExpandido = EstaEnDonaciones();
        _gastosExpandido = EstaEnGastos();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var expandirBeneficiarios = EstaEnBeneficiarios();
        var expandirAsistencia = EstaEnAsistencia();
        var expandirInventario = EstaEnInventario();
        var expandirDonaciones = EstaEnDonaciones();
        var expandirGastos = EstaEnGastos();

        if (_beneficiariosExpandido != expandirBeneficiarios || _asistenciaExpandido != expandirAsistencia
            || _inventarioExpandido != expandirInventario || _donacionesExpandido != expandirDonaciones
            || _gastosExpandido != expandirGastos)
        {
            _beneficiariosExpandido = expandirBeneficiarios;
            _asistenciaExpandido = expandirAsistencia;
            _inventarioExpandido = expandirInventario;
            _donacionesExpandido = expandirDonaciones;
            _gastosExpandido = expandirGastos;
            InvokeAsync(StateHasChanged);
        }
    }

    private bool EstaEnBeneficiarios()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);

        // "Entregar Donación" e "Historial de Entregas" viven acá aunque su ruta
        // siga siendo /donaciones/entregas/...: son la salida de una donación
        // hacia un beneficiario o una comunidad, no el alta de la donación en sí.
        return ruta.StartsWith("beneficiarios", StringComparison.OrdinalIgnoreCase)
            || ruta.StartsWith("donaciones/entregas", StringComparison.OrdinalIgnoreCase);
    }

    private bool EstaEnAsistencia()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);
        return ruta.StartsWith("asistencia", StringComparison.OrdinalIgnoreCase);
    }

    private bool EstaEnInventario()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);
        return ruta.StartsWith("inventario", StringComparison.OrdinalIgnoreCase);
    }

    // Dos prefijos y no uno: Donantes y Donaciones son pantallas del mismo grupo
    // de navegación pero con rutas separadas ("/donantes/..." y "/donaciones/...").
    // Excluye donaciones/entregas a propósito: esas dos pantallas se mudaron al
    // grupo Beneficiarios (ver EstaEnBeneficiarios), aunque la ruta no cambió.
    private bool EstaEnDonaciones()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);
        return ruta.StartsWith("donantes", StringComparison.OrdinalIgnoreCase)
            || (ruta.StartsWith("donaciones", StringComparison.OrdinalIgnoreCase)
                && !ruta.StartsWith("donaciones/entregas", StringComparison.OrdinalIgnoreCase));
    }

    private bool EstaEnGastos()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);
        return ruta.StartsWith("gastos", StringComparison.OrdinalIgnoreCase);
    }

    private void OnBeneficiariosExpandedChanged(bool expandido)
    {
        _beneficiariosExpandido = expandido;

        // Al abrir el grupo, ir al listado; Registrar aparece debajo.
        if (expandido && !EstaEnBeneficiarios())
        {
            Navigation.NavigateTo("/beneficiarios");
        }
    }

    private void OnAsistenciaExpandedChanged(bool expandido)
    {
        _asistenciaExpandido = expandido;

        // Al abrir el grupo, ir al historial; Agregar aparece debajo.
        if (expandido && !EstaEnAsistencia())
        {
            Navigation.NavigateTo("/asistencia/historial");
        }
    }

    private void OnInventarioExpandedChanged(bool expandido)
    {
        _inventarioExpandido = expandido;

        // Al abrir el grupo, ir a existencias; Registrar entrada aparece debajo.
        if (expandido && !EstaEnInventario())
        {
            Navigation.NavigateTo("/inventario/existencias");
        }
    }

    private void OnDonacionesExpandedChanged(bool expandido)
    {
        _donacionesExpandido = expandido;

        // Al abrir el grupo, ir al listado de donantes; el resto aparece debajo.
        if (expandido && !EstaEnDonaciones())
        {
            Navigation.NavigateTo("/donantes");
        }
    }

    private void OnGastosExpandedChanged(bool expandido)
    {
        _gastosExpandido = expandido;

        // Al abrir el grupo, ir al listado; Registrar aparece debajo.
        if (expandido && !EstaEnGastos())
        {
            Navigation.NavigateTo("/gastos");
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
