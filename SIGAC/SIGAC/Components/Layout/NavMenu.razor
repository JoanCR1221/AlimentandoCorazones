@inject NavigationManager Navigation
@implements IDisposable

<MudNavMenu Class="pa-2">
    <MudText Typo="Typo.subtitle2" Class="px-4 py-2 mud-text-secondary">Navegación</MudText>

    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Inicio
    </MudNavLink>

    <MudNavGroup Title="Ver Beneficiarios"
                 Icon="@Icons.Material.Filled.People"
                 Expanded="_beneficiariosExpandido"
                 ExpandedChanged="OnBeneficiariosExpandedChanged">
        <MudNavLink Href="/beneficiarios/registrar" Icon="@Icons.Material.Filled.PersonAdd">
            Registrar Beneficiario
        </MudNavLink>
    </MudNavGroup>

    <MudNavLink Href="/asistencia/registrar" Icon="@Icons.Material.Filled.Restaurant">
        Agregar Asistencia
    </MudNavLink>
    <MudNavLink Href="/asistencia/historial" Icon="@Icons.Material.Filled.History">
        Historial de Asistencia
    </MudNavLink>

    <MudDivider Class="my-2" />

    <MudNavLink Href="/prototipos" Icon="@Icons.Material.Filled.Palette">
        Prototipos de apariencia
    </MudNavLink>
</MudNavMenu>

@code {
    private bool _beneficiariosExpandido;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _beneficiariosExpandido = EstaEnBeneficiarios();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var expandir = EstaEnBeneficiarios();
        if (_beneficiariosExpandido != expandir)
        {
            _beneficiariosExpandido = expandir;
            InvokeAsync(StateHasChanged);
        }
    }

    private bool EstaEnBeneficiarios()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);
        return ruta.StartsWith("beneficiarios", StringComparison.OrdinalIgnoreCase);
    }

    private void OnBeneficiariosExpandedChanged(bool expandido)
    {
        _beneficiariosExpandido = expandido;

        // Al abrir el grupo, ir al listado; Registrar aparece debajo.
        if (expandido && !EstaEnBeneficiarios())
        {
            Navigation.NavigateTo("/beneficiarios");
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
