@inherits LayoutComponentBase

@* Layout de la pantalla de inicio de sesión: sin AppBar, sin menú y sin el
   servicio de apariencia (que depende de JS interop y del circuito
   interactivo, y esta página se renderiza en modo estático). Solo la
   tarjeta centrada sobre un degradado de marca, con el banner como paisaje
   decorativo al pie (alt vacío: el banner repite el nombre y el versículo,
   y la tarjeta ya se identifica con el logo). *@
<div class="login-fondo">
    <main class="login-contenedor">
        @Body
    </main>
    <img src="img/banner.png" alt="" aria-hidden="true" class="login-paisaje" />
</div>
