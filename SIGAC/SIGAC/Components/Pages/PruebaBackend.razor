@page "/prueba-backend"
@rendermode InteractiveServer
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Interfaces
@inject IBeneficiariosService BeneficiariosService

<h3>Prueba del módulo de Beneficiarios</h3>

<button class="btn btn-primary" @onclick="RegistrarPrueba">Registrar beneficiario de prueba</button>

@if (!string.IsNullOrEmpty(mensaje))
{
    <p style="color:green">@mensaje</p>
}
@if (!string.IsNullOrEmpty(error))
{
    <p style="color:red">@error</p>
}

<h4>Beneficiarios registrados</h4>
<button class="btn btn-secondary" @onclick="Cargar">Recargar lista</button>

<table class="table">
    <thead>
        <tr><th>Id</th><th>Nombre</th><th>Categoría</th><th>Tipo Documento</th><th>Número de Identidad</th><th>Estado</th></tr>
    </thead>
    <tbody>
        @foreach (var b in beneficiarios)
        {
            <tr>
                <td>@b.Id</td>
                <td>@b.Nombre</td>
                <td>@b.Categoria</td>
                <td>@b.TipoDocumento</td>
                <td>@b.NumIdentidad</td>
                <td>@(b.Estado ? "Activo" : "Inactivo")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string? mensaje;
    private string? error;
    private IEnumerable<BeneficiarioListaDto> beneficiarios = new List<BeneficiarioListaDto>();

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }
    private async Task RegistrarPrueba()
    {
        mensaje = null;
        error = null;
        try
        {
            await BeneficiariosService.RegistrarBeneficiarioAsync(new BeneficiarioCrearDto
            {
                Nombre = $"Beneficiario Prueba {DateTime.Now:HHmmss}",
                FechaNacimiento = new DateTime(2000, 1, 1),
                Categoria = "General",
                Telefono = "8888-0000",
                Direccion = "Sin dirección",
                TipoDocumento = "DIMEX",
                NumIdentidad = "123456789"
               
            });
            mensaje = "Beneficiario registrado correctamente.";
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Cargar()
    {
        beneficiarios = await BeneficiariosService.ObtenerBeneficiariosAsync(new FiltrosBeneficiarioDto());
    }
}