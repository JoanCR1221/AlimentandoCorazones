@page "/alquileres/arrendatarios/registrar"
@attribute [Authorize(Policy = Permisos.Alquileres.RegistrarArrendatario)]
@using SIGAC.Application.DTOs.Alquileres
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Application.Validators
@inject IArrendatariosService ArrendatariosService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Registrar arrendatario — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Registrar arrendatario"
                  Descripcion="Persona o entidad que alquila un espacio de la asociación." />

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            @* El documento va primero: con cédula nacional o jurídica completa se
               consulta Hacienda y se rellena el nombre. Opcional ("Sin documento"); si
               se indica, no puede repetirse. Admite documentos extranjeros
               (pasaporte, DIMEX u otro). *@
            <CamposDocumento Tipos="TiposDocumento.TodosParaOrganizaciones" Origen="modelo"
                             TipoDocumento="@modelo.TipoDocumento" AlCambiarTipoDocumento="OnTipoDocumentoCambiado"
                             @bind-TipoDocumentoOtro="modelo.TipoDocumentoOtro"
                             @bind-NumIdentidad="modelo.Identificacion"
                             @bind-Nombre="modelo.Nombre" />

            <MudTextField @bind-Value="modelo.Nombre" For="@(() => modelo.Nombre)" Label="Nombre" Variant="Variant.Outlined" Class="mt-4"
                          MaxLength="ArrendatarioValidator.LongitudMaximaNombre"
                          HelperText="Persona física, razón social o nombre del grupo." />

            @* Mismo catálogo cerrado que Donantes: SIGAC.Domain.TiposPersonaDonante. *@
            <MudSelect @bind-Value="modelo.TipoPersona" For="@(() => modelo.TipoPersona)" Label="Tipo de persona" Variant="Variant.Outlined" Class="mt-4">
                @foreach (var tipo in TiposPersonaDonante.Todos)
                {
                    <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
                }
            </MudSelect>

            <PhoneInput @bind-Value="modelo.Telefono" @bind-CodigoPais="modelo.CodigoPaisTelefono" Label="Teléfono" Class="mt-4" />
            <MudTextField @bind-Value="modelo.Correo" For="@(() => modelo.Correo)" Label="Correo (opcional)" Variant="Variant.Outlined" Class="mt-4" />
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="guardando" Class="ml-2 mb-2">Guardar</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Href="/alquileres" Class="mb-2">Cancelar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    // Se levanta antes del primer await y se baja en el finally: un doble clic
    // rápido dispara Guardar dos veces antes de que el servidor responda, y la
    // segunda llamada repetiría el registro (y, donde corresponde, el movimiento
    // de stock).
    private bool guardando;

    private ArrendatarioCrearDto modelo = new();

    private void OnTipoDocumentoCambiado(string? valor)
    {
        modelo.TipoDocumento = valor ?? TiposDocumento.SinDocumento;

        // El tipo de persona sale del documento (cédula jurídica = Jurídica, el resto
        // de los documentos de personas = Física); con "Otro" o "Sin documento" queda
        // lo que ya estaba. Sigue siendo editable.
        var persona = TiposDocumento.TipoPersonaSugerido(valor);
        if (persona is not null)
            modelo.TipoPersona = persona;

        // Al registrar el número se limpia SIEMPRE al cambiar de tipo: nadie tiene el
        // mismo número en dos documentos distintos, y conservarlo solo invita a
        // guardarlo bajo el tipo equivocado (mismo criterio que RegistrarBeneficiario).
        modelo.Identificacion = null;

        if (!TiposDocumento.RequiereNombreDelDocumento(valor))
            modelo.TipoDocumentoOtro = null;
    }

    private async Task Guardar()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            var arrendatarioId = await ArrendatariosService.RegistrarArrendatarioAsync(modelo);
            Snackbar.Add("Arrendatario registrado correctamente.", Severity.Success);

            // Lo habitual es registrar al arrendatario porque viene a alquilar: se
            // ofrece seguir con el alquiler ya con él elegido, mismo recurso que
            // RegistrarProyecto.razor con los participantes.
            Snackbar.Add(
                "¿Desea registrarle un alquiler ahora?",
                Severity.Info,
                config =>
                {
                    config.Action = "Registrar alquiler";
                    config.ActionColor = Color.Primary;
                    config.OnClick = _ =>
                    {
                        NavigationManager.NavigateTo($"/alquileres/registrar?arrendatarioId={arrendatarioId}");
                        return Task.CompletedTask;
                    };
                });

            modelo = new();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (DuplicateException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar el arrendatario. Intente de nuevo.", Severity.Error);
        }
        finally
        {
            guardando = false;
        }
    }
}
