@page "/alquileres"
@attribute [Authorize(Policy = Permisos.Alquileres.Ver)]
@using SIGAC.Application.DTOs
@using SIGAC.Application.DTOs.Alquileres
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain.Entities
@inject IAlquileresService AlquileresService
@inject IEspaciosService EspaciosService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Calendario de alquileres — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Calendario de alquileres"
                  Descripcion="Consulte la disponibilidad de los espacios y los alquileres registrados."
                  TextoAccion="Registrar alquiler" HrefAccion="/alquileres/registrar"
                  PermisoAccion="@Permisos.Alquileres.Registrar" />

<MudCard Class="pa-4">
    <MudCardContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                @* Todos los sectores, también los desactivados: el calendario es
                   historial y un sector en reparación sigue teniendo alquileres
                   viejos. *@
                <MudSelect T="int?" Value="filtroEspacioId" ValueChanged="OnEspacioCambiadoAsync"
                           Label="Sector" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var espacio in espacios)
                    {
                        <MudSelectItem T="int?" Value="@espacio.Id">@espacio.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDateRangePicker DateRange="rangoFechas" DateRangeChanged="OnRangoFechasCambiadoAsync"
                                     Label="Rango de fechas" Variant="Variant.Outlined" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="EstadoAlquiler?" Value="filtroEstado" ValueChanged="OnEstadoCambiadoAsync"
                           Label="Estado" Variant="Variant.Outlined" Clearable="true" Placeholder="Todos"
                           ToStringFunc="@(e => e is null ? "Todos" : e == EstadoAlquiler.Reservado ? "Reservados" : "Cancelados")">
                    <MudSelectItem T="EstadoAlquiler?" Value="@EstadoAlquiler.Reservado">Reservados</MudSelectItem>
                    <MudSelectItem T="EstadoAlquiler?" Value="@EstadoAlquiler.Cancelado">Cancelados</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        @* Ingreso del período por moneda, solo de alquileres reservados: mismo
           criterio que el total de ListadoGastos. *@
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="my-4">
            Ingresos del período:
            @if (totalesPorMoneda.Count == 0)
            {
                @:—
            }
            else
            {
                @string.Join("  ·  ", totalesPorMoneda.Select(
                    t => $"{TiposMoneda.Simbolo(t.Moneda)} {t.Total:N2}"))
            }
        </MudText>

        @* ServerData en lugar de Items: el calendario crece con cada alquiler, así que
           la grilla pide una página por vez y el repositorio trae de la base solo
           esos registros. SortMode.None porque el orden (por fecha y hora de inicio)
           lo fija la consulta en SQL: dejar ordenar por columna solo reordenaría la
           página visible, que sería engañoso. Los ingresos de arriba son del
           conjunto filtrado completo, no de la página: vienen de un agregado en la
           base. *@
        @* Una sola grilla para los tres tamaños (ver ListadoBeneficiarios): en móvil
           (< 768px) solo se ve la celda "tarjeta"; en tableta y laptop chico, sin
           Características ni Personas, que van en el "Ver más" bajo el
           arrendatario junto con el motivo de una cancelación; en escritorio, las
           nueve columnas de siempre. Dense se queda por esas nueve columnas: en
           tableta y en la tarjeta, app.css le corrige el relleno. *@
        <MudDataGrid T="AlquilerListaDto" @ref="grilla" Class="ac-grilla-tarjetas" Breakpoint="Breakpoint.None"
                     ServerData="CargarPaginaAsync"
                     RowsPerPage="FiltrosHistorialAlquilerDto.TamanoPaginaPredeterminado"
                     SortMode="SortMode.None" Filterable="false" Dense="true">
            <Columns>
                <TemplateColumn Title="Fecha" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        <div>@context.Item.Fecha.ToString("ddd dd/MM/yyyy")</div>
                        @if (context.Item.EsFinDeSemana)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Fin de semana</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Horario" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        <div style="white-space: nowrap;">@ReglasAlquiler.FormatearHora(context.Item.HoraInicio)</div>
                        <div style="white-space: nowrap;">a @ReglasAlquiler.FormatearHora(context.Item.HoraFin)</div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Arrendatario" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        <div>@context.Item.Arrendatario</div>
                        @if (!string.IsNullOrWhiteSpace(context.Item.TelefonoArrendatario))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Item.TelefonoArrendatario</MudText>
                        }
                        <VerMasTabla>
                            <dt>Características</dt>
                            <dd>@TextoCaracteristicas(context.Item)</dd>
                            <dt>Personas</dt>
                            <dd>@context.Item.CantidadPersonas</dd>
                            @if (MuestraMotivo(context.Item))
                            {
                                <dt>Motivo de cancelación</dt>
                                <dd>@context.Item.MotivoCancelacion</dd>
                            }
                        </VerMasTabla>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Sectores" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>@string.Join(", ", context.Item.Espacios)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Características" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio">
                    <CellTemplate>@TextoCaracteristicas(context.Item)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CantidadPersonas" Title="Personas" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio" />
                @* nowrap: entre el símbolo y la cifra va un espacio, y en la tabla
                   apretada de tableta el "₡" quedaría solo en una línea. Mismo
                   criterio que la columna Total de ListadoGastos. *@
                <TemplateColumn Title="Monto" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" CellStyle="white-space: nowrap">
                    <CellTemplate>@TiposMoneda.Simbolo(context.Item.Moneda) @context.Item.Monto.ToString("N2")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Estado" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        @EstadoDelAlquiler(context.Item)
                        @* El motivo admite hasta 500 caracteres: bajo la etiqueta, en la
                           columna angosta de tableta, estiraría la fila a decenas de
                           líneas. Ahí va en el "Ver más" del arrendatario y acá se
                           oculta (ac-col-escritorio); en escritorio sigue bajo la
                           etiqueta. HtmlTag div en vez de d-block: el !important de
                           d-block le ganaría al ocultamiento. *@
                        @if (MuestraMotivo(context.Item))
                        {
                            <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary ac-col-escritorio">@context.Item.MotivoCancelacion</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Acciones" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        <div class="ac-acciones-tabla">
                            @Acciones(context.Item, false)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                @* Solo móvil: arrendatario y estado arriba; fecha, horario, sectores
                   y monto siempre a la vista; características, personas, teléfono
                   (enlace para llamar) y el motivo de una cancelación en "Ver más",
                   y Cancelar al pie mientras el alquiler siga reservado. *@
                <TemplateColumn Title="Alquiler" CellClass="ac-col-tarjeta" HeaderClass="ac-col-tarjeta">
                    <CellTemplate>
                        <TarjetaFila Titulo="@context.Item.Arrendatario">
                            <Estado>
                                @EstadoDelAlquiler(context.Item)
                            </Estado>
                            <Lineas>
                                <p class="ac-tarjeta-dato">@LineaFecha(context.Item)</p>
                                <p class="ac-tarjeta-dato">@ReglasAlquiler.FormatearHora(context.Item.HoraInicio) a @ReglasAlquiler.FormatearHora(context.Item.HoraFin)</p>
                                @if (context.Item.Espacios.Count > 0)
                                {
                                    <p class="ac-tarjeta-dato">@string.Join(", ", context.Item.Espacios)</p>
                                }
                                <p class="ac-tarjeta-total">@TiposMoneda.Simbolo(context.Item.Moneda) @context.Item.Monto.ToString("N2")</p>
                            </Lineas>
                            <Detalle>
                                <dt>Características</dt>
                                <dd>@TextoCaracteristicas(context.Item)</dd>
                                <dt>Personas</dt>
                                <dd>@context.Item.CantidadPersonas</dd>
                                @if (!string.IsNullOrWhiteSpace(context.Item.TelefonoArrendatario))
                                {
                                    <dt>Teléfono</dt>
                                    <dd><EnlaceContacto Telefono="@context.Item.TelefonoArrendatario" /></dd>
                                }
                                @if (MuestraMotivo(context.Item))
                                {
                                    <dt>Motivo de cancelación</dt>
                                    <dd>@context.Item.MotivoCancelacion</dd>
                                }
                            </Detalle>
                            <Acciones>
                                @Acciones(context.Item, true)
                            </Acciones>
                        </TarjetaFila>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ningún alquiler coincide con los filtros"
                                 Descripcion="Pruebe con otro sector, rango de fechas o estado." />
                }
                else
                {
                    @* Sin filtros no se consulta nada, así que acá no se sabe si hay
                       alquileres: la invitación a buscar también ofrece registrar. *@
                    <EstadoVacio Icono="@Icons.Material.Filled.EventAvailable"
                                 Titulo="Elija un sector, un rango de fechas o un estado"
                                 Descripcion="Así se consultan solo los alquileres que necesita, sin cargar el calendario completo."
                                 TextoAccion="Registrar alquiler" HrefAccion="/alquileres/registrar"
                                 PermisoAccion="@Permisos.Alquileres.Registrar" />
                }
            </NoRecordsContent>
            <PagerContent>
                @* Sin filas no hay nada que paginar: el paginador solo estorbaba (F-16). *@
                @if (grilla?.GetFilteredItemsCount() > 0)
                {
                    <MudDataGridPager T="AlquilerListaDto"
                                      PageSizeOptions="@(new[] { FiltrosHistorialAlquilerDto.TamanoPaginaPredeterminado, 50, FiltrosHistorialAlquilerDto.TamanoPaginaMaximo })" />
                }
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    // Reservado en verde y Cancelado en rojo: la misma etiqueta en la tabla y en
    // la tarjeta de móvil.
    private RenderFragment EstadoDelAlquiler(AlquilerListaDto item) => @<EstadoChip Activo="@(item.Estado == EstadoAlquiler.Reservado)"
                                                                                  TextoActivo="Reservado" TextoInactivo="Cancelado" />;

    // Solo Cancelar: la misma pieza sirve a la tabla (botón chico) y a la tarjeta
    // de móvil (del tamaño normal; lo estira app.css).
    private RenderFragment Acciones(AlquilerListaDto item, bool tarjeta) => @<text>
        @* Un alquiler cancelado no se vuelve a cancelar (el servicio lo
           rechaza igual; ocultar el botón evita el viaje). En la tarjeta,
           sin botón tampoco se pinta el pie. *@
        @if (item.Estado == EstadoAlquiler.Reservado)
        {
            <AuthorizeView Policy="@Permisos.Alquileres.Cancelar" Context="auth">
                <MudButton Variant="Variant.Outlined" Size="@(tarjeta ? Size.Medium : Size.Small)" Color="Color.Error" Class="ac-btn-inactivar"
                           OnClick="@(() => CancelarAsync(item))">Cancelar</MudButton>
            </AuthorizeView>
        }
    </text>;

    // Solo un alquiler cancelado tiene motivo, y no siempre se escribió uno: la
    // misma condición para la tabla, el "Ver más" de tableta y la tarjeta.
    private static bool MuestraMotivo(AlquilerListaDto alquiler) =>
        alquiler.Estado == EstadoAlquiler.Cancelado && !string.IsNullOrWhiteSpace(alquiler.MotivoCancelacion);

    // Un guion y no la celda vacía cuando no se pidió ninguna: el mismo texto en
    // la columna de escritorio, en el "Ver más" de tableta y en la tarjeta.
    private static string TextoCaracteristicas(AlquilerListaDto alquiler) =>
        alquiler.Caracteristicas.Count == 0 ? "—" : string.Join(", ", alquiler.Caracteristicas);

    // "sáb. 03/10/2026 · Fin de semana" en una sola línea: en la tarjeta el aviso
    // de fin de semana no tiene una línea propia como en la tabla.
    private static string LineaFecha(AlquilerListaDto alquiler) =>
        alquiler.EsFinDeSemana
            ? $"{alquiler.Fecha:ddd dd/MM/yyyy} · Fin de semana"
            : alquiler.Fecha.ToString("ddd dd/MM/yyyy");

    // Sin filtros de entrada: al abrir se ve la primera página de todos los
    // alquileres, reservados y cancelados. Los filtros solo acotan lo que ya está a
    // la vista.
    private IReadOnlyList<EspacioFisicoDto> espacios = Array.Empty<EspacioFisicoDto>();
    private MudDataGrid<AlquilerListaDto>? grilla;

    // Lo último que devolvió el servicio: la grilla muestra su página y los ingresos
    // de arriba salen del mismo resultado.
    private IReadOnlyList<MontoPorMonedaDto> totalesPorMoneda = Array.Empty<MontoPorMonedaDto>();
    private int? filtroEspacioId;
    private DateRange? rangoFechas;
    private EstadoAlquiler? filtroEstado;

    private bool HayFiltro => filtroEspacioId.HasValue || rangoFechas is not null || filtroEstado.HasValue;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            espacios = await EspaciosService.ObtenerEspaciosAsync(soloActivos: false);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudieron cargar los sectores.", Severity.Error);
        }
    }

    private async Task OnEspacioCambiadoAsync(int? valor)
    {
        filtroEspacioId = valor;
        await RecargarAsync();
    }

    private async Task OnRangoFechasCambiadoAsync(DateRange? valor)
    {
        rangoFechas = valor;
        await RecargarAsync();
    }

    private async Task OnEstadoCambiadoAsync(EstadoAlquiler? valor)
    {
        filtroEstado = valor;
        await RecargarAsync();
    }

    // La llama la grilla cada vez que cambia de página o se recarga. Devuelve solo
    // los alquileres de esa página más el total, que es lo que necesita el paginador.
    private async Task<GridData<AlquilerListaDto>> CargarPaginaAsync(
        GridState<AlquilerListaDto> estado, CancellationToken cancellationToken)
    {
        // La pantalla abre sin consultar el calendario: sin ningún criterio
        // no se va a la base y la grilla queda vacía, con la invitación a buscar.
        // Mismo criterio que ListadoGastos. Cubre también quitar todos los filtros.
        if (!HayFiltro)
        {
            totalesPorMoneda = Array.Empty<MontoPorMonedaDto>();
            StateHasChanged();
            return new GridData<AlquilerListaDto> { Items = Array.Empty<AlquilerListaDto>(), TotalItems = 0 };
        }

        try
        {
            var resultado = await AlquileresService.ObtenerPaginaHistorialAlquileresAsync(new FiltrosHistorialAlquilerDto
            {
                EspacioId = filtroEspacioId,
                FechaDesde = rangoFechas?.Start,
                FechaHasta = rangoFechas?.End,
                Estado = filtroEstado,
                Pagina = estado.Page,
                TamanoPagina = estado.PageSize
            });

            totalesPorMoneda = resultado.TotalesPorMoneda;

            // Los ingresos de arriba están fuera de la grilla: ella se vuelve a dibujar
            // sola al recibir la página, pero la pantalla no.
            StateHasChanged();

            return new GridData<AlquilerListaDto>
            {
                Items = resultado.Alquileres,
                TotalItems = resultado.TotalRegistros
            };
        }
        catch (Exception)
        {
            totalesPorMoneda = Array.Empty<MontoPorMonedaDto>();
            Snackbar.Add("No se pudieron consultar los alquileres. Intente de nuevo.", Severity.Error);
            StateHasChanged();
            return new GridData<AlquilerListaDto> { Items = Array.Empty<AlquilerListaDto>(), TotalItems = 0 };
        }
    }

    // Al cambiar un filtro se vuelve a la primera página: la que se estaba viendo
    // puede no existir con el filtro nuevo (y quedaría vacía).
    //
    // NavigateTo cambia CurrentPage, y el setter de CurrentPage ya dispara
    // ServerData por dentro. Por eso solo se recarga a mano en la otra rama: así el
    // cambio de filtro cuesta una sola consulta y no dos.
    private async Task RecargarAsync()
    {
        if (grilla is null)
            return;

        if (grilla.CurrentPage != 0)
            grilla.NavigateTo(Page.First);
        else
            await grilla.ReloadServerData();
    }

    // Se recarga la página actual, no la primera: el filtro no cambió.
    private async Task RecargarPaginaActualAsync()
    {
        if (grilla is not null)
            await grilla.ReloadServerData();
    }

    private async Task CancelarAsync(AlquilerListaDto alquiler)
    {
        var titulo = $"Cancelar alquiler del {alquiler.Fecha:dd/MM/yyyy} ({alquiler.Arrendatario})";
        var dialog = await DialogService.ShowAsync<CancelarAlquilerDialog>(titulo);
        var resultado = await dialog.Result;

        if (resultado is null || resultado.Canceled)
            return;

        try
        {
            await AlquileresService.CancelarAlquilerAsync(new CancelacionAlquilerDto
            {
                AlquilerId = alquiler.Id,
                MotivoCancelacion = (string?)resultado.Data
            });
            Snackbar.Add("Alquiler cancelado. El horario quedó libre.", Severity.Success);
            await RecargarPaginaActualAsync();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await RecargarPaginaActualAsync();
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo cancelar el alquiler. Intente de nuevo.", Severity.Error);
        }
    }
}
