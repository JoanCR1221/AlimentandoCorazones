@page "/inventario/existencias"
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Interfaces
@inject IInventarioService InventarioService

<MudText Typo="Typo.h4" Class="mb-4">Existencias de inventario</MudText>

<MudCard Class="pa-4">
    <MudCardContent>
        <MudTextField @bind-Value="filtroNombre" Label="Buscar por nombre" Variant="Variant.Outlined" Class="mb-4" />
        <MudSelect T="string" @bind-Value="filtroCategoria" Label="Categoría" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            <MudSelectItem T="string" Value="@("Alimentos")">Alimentos</MudSelectItem>
            <MudSelectItem T="string" Value="@("Ropa")">Ropa</MudSelectItem>
            <MudSelectItem T="string" Value="@("Calzado")">Calzado</MudSelectItem>
            <MudSelectItem T="string" Value="@("Equipos")">Equipos</MudSelectItem>
        </MudSelect>
        <MudDataGrid T="ArticuloExistenciaDto" Items="@articulos">
            <Columns>
                <PropertyColumn Property="x => x.Nombre" Title="Nombre" />
                <PropertyColumn Property="x => x.Categoria" Title="Categoría" />
                <PropertyColumn Property="x => x.UnidadMedida" Title="Unidad de medida" />
                <TemplateColumn Title="Stock actual">
                    <CellTemplate>
                        @if (context.Item.StockBajo)
                        {
                            <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Warning">@context.Item.StockActual (stock bajo)</MudChip>
                        }
                        else
                        {
                            @context.Item.StockActual
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText>Todavía no hay artículos registrados.</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private IEnumerable<ArticuloExistenciaDto> articulos = new List<ArticuloExistenciaDto>();
    private string? filtroNombre;
    private string? filtroCategoria;

    protected override async Task OnInitializedAsync()
    {
        articulos = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto());
    }
}
