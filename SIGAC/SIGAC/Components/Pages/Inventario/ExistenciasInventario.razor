@page "/inventario/existencias"
@attribute [Authorize(Policy = Permisos.Inventario.VerExistencias)]
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IInventarioService InventarioService
@inject ISnackbar Snackbar

<PageTitle>Existencias de inventario — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Existencias de inventario"
                  Descripcion="Consulte las existencias y registre nuevas entradas de artículos."
                  TextoAccion="Registrar entrada" HrefAccion="/inventario/entradas/registrar"
                  PermisoAccion="@Permisos.Inventario.RegistrarEntrada" />

<ResumenInventario />

<MudCard Class="pa-4">
    <MudCardContent>
        <MudTextField T="string" Value="filtroNombre" ValueChanged="OnFiltroNombreCambiadoAsync" Immediate="true" DebounceInterval="300"
                      Label="Buscar por nombre o código" Variant="Variant.Outlined" Class="mb-4" />
        @* Mismo catálogo que usan el alta y la edición: si esta lista quedara con sus
           propios literales, el filtro buscaría categorías que ya nadie guarda. *@
        <MudSelect T="string" Value="filtroCategoria" ValueChanged="OnFiltroCategoriaCambiadoAsync" Label="Categoría" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            @foreach (var categoria in CategoriasArticulo.Todos)
            {
                <MudSelectItem T="string" Value="@categoria">@categoria</MudSelectItem>
            }
        </MudSelect>
        @* Subcategoría del Equipo (ver EstadosArticulo). Solo el Equipo tiene
           estado, así que elegir uno deja fuera a todo lo demás. Cuenta como filtro
           por sí solo, igual que la categoría. *@
        <MudSelect T="string" Value="filtroEstado" ValueChanged="OnFiltroEstadoCambiadoAsync" Label="Estado (solo Equipo)" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            @foreach (var estado in EstadosArticulo.Todos)
            {
                <MudSelectItem T="string" Value="@estado">@estado</MudSelectItem>
            }
        </MudSelect>
        @* Cuenta como filtro por sí solo (ver HayFiltro): activarlo sin escribir
           nada tiene que mostrar igual los artículos con poco stock, que es el
           caso de uso (entrar a reponer). Ordena de menor a mayor stock mientras
           está activo, para que lo más urgente aparezca primero. *@
        <MudSwitch T="bool" Value="filtroSoloStockBajo" ValueChanged="OnFiltroSoloStockBajoCambiadoAsync"
                   Color="Color.Error" Class="mb-4">
            Solo artículos con stock bajo
        </MudSwitch>
        @* ServerData y no Items: la consulta ya pagina en SQL, pero la pantalla pedía solo la
           primera página (20 artículos) y no tenía cómo ver las demás ni avisaba que había
           más. Mismo patrón que ListadoDonantes. *@
        @* Una sola grilla para los tres tamaños (ver ListadoBeneficiarios): en móvil
           (< 768px) solo se ve la celda "tarjeta"; en tableta y laptop chico, sin
           Estado, Unidad de medida ni Ubicación (van en el "Ver más" bajo el
           nombre); en escritorio, las ocho columnas. *@
        <MudDataGrid T="ArticuloExistenciaDto" @ref="grilla" Class="ac-grilla-tarjetas" Breakpoint="Breakpoint.None"
                     ServerData="CargarPaginaAsync"
                     RowsPerPage="FiltrosExistenciaDto.TamanoPaginaPredeterminado"
                     SortMode="SortMode.None" Filterable="false">
            <Columns>
                <TemplateColumn Title="Nombre" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        @context.Item.Nombre
                        <VerMasTabla>
                            <dt>Estado</dt>
                            <dd>@(context.Item.Estado ?? "—")</dd>
                            <dt>Unidad de medida</dt>
                            <dd>@context.Item.UnidadMedida</dd>
                            <dt>Ubicación</dt>
                            <dd>@(context.Item.Ubicacion ?? "—")</dd>
                        </VerMasTabla>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Codigo" Title="Código" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <PropertyColumn Property="x => x.Categoria" Title="Categoría" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                @* Guion y no vacío para lo que no lleva estado: una celda en blanco
                   se lee como "falta el dato", y acá simplemente no aplica. *@
                <TemplateColumn Title="Estado" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio">
                    <CellTemplate>
                        @(context.Item.Estado ?? "—")
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.UnidadMedida" Title="Unidad de medida" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio" />
                <PropertyColumn Property="x => x.Ubicacion" Title="Ubicación" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio" />
                <TemplateColumn Title="Stock actual" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        @if (context.Item.StockBajo)
                        {
                            <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Warning">@context.Item.StockActual (stock bajo)</MudChip>
                        }
                        else
                        {
                            @context.Item.StockActual
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Acciones" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        <div class="ac-acciones-tabla">
                            @Acciones(context.Item, false)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                @* Solo móvil: nombre y stock arriba (en rojo si es stock bajo), "código
                   · categoría" siempre a la vista, estado, unidad y ubicación en
                   "Ver más", y Editar al pie. *@
                <TemplateColumn Title="Artículo" CellClass="ac-col-tarjeta" HeaderClass="ac-col-tarjeta">
                    <CellTemplate>
                        <TarjetaFila Titulo="@context.Item.Nombre">
                            <Estado>
                                @if (context.Item.StockBajo)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">Stock bajo: @context.Item.StockActual</MudChip>
                                }
                                else
                                {
                                    <span class="ac-tarjeta-etiqueta">Stock: @context.Item.StockActual</span>
                                }
                            </Estado>
                            <Lineas>
                                <p class="ac-tarjeta-dato">@LineaCodigo(context.Item)</p>
                            </Lineas>
                            <Detalle>
                                <dt>Estado</dt>
                                <dd>@(context.Item.Estado ?? "—")</dd>
                                <dt>Unidad de medida</dt>
                                <dd>@context.Item.UnidadMedida</dd>
                                <dt>Ubicación</dt>
                                <dd>@(context.Item.Ubicacion ?? "—")</dd>
                            </Detalle>
                            <Acciones>
                                @Acciones(context.Item, true)
                            </Acciones>
                        </TarjetaFila>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            @* Dos estados vacíos distintos, y el usuario tiene que poder diferenciarlos:
               "todavía no buscaste" es una invitación a escribir, "no hay coincidencias"
               es el resultado de una búsqueda que sí se hizo. Con un solo mensaje, una
               pantalla recién abierta parecería un inventario vacío. *@
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ningún artículo coincide con la búsqueda"
                                 Descripcion="Pruebe con otro nombre, código o categoría." />
                }
                else
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.Inventory2"
                                 Titulo="Escriba un nombre o código, o elija una categoría"
                                 Descripcion="Así se muestra el inventario, sin cargar el catálogo entero de una vez." />
                }
            </NoRecordsContent>
            <PagerContent>
                @* Sin filas no hay nada que paginar. *@
                @if (grilla?.GetFilteredItemsCount() > 0)
                {
                    <MudDataGridPager T="ArticuloExistenciaDto"
                                      PageSizeOptions="@(new[] { FiltrosExistenciaDto.TamanoPaginaPredeterminado, 50, FiltrosExistenciaDto.TamanoPaginaMaximo })" />
                }
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    // Solo Editar: la misma pieza sirve a la tabla (botón plano) y a la tarjeta
    // de móvil (con contorno; lo estira app.css).
    private RenderFragment Acciones(ArticuloExistenciaDto item, bool tarjeta) => @<text>
        <AuthorizeView Policy="@Permisos.Inventario.EditarArticulo" Context="auth">
            <MudButton Variant="@(tarjeta ? Variant.Outlined : Variant.Text)" Color="Color.Primary" Href="@($"/inventario/articulos/editar/{item.Id}")">Editar</MudButton>
        </AuthorizeView>
    </text>;

    // "Código · Categoría"; un artículo sin código muestra solo la categoría.
    private static string LineaCodigo(ArticuloExistenciaDto articulo) =>
        string.Join(" · ", new[] { articulo.Codigo, articulo.Categoria }
            .Where(texto => !string.IsNullOrWhiteSpace(texto)));

    // Llega desde la notificación de stock bajo de Inicio
    // (/inventario/existencias?stockBajo=true): activa el interruptor y ya
    // carga la grilla, para que tocar la notificación muestre de una vez los
    // artículos que la motivaron y no una pantalla en blanco a la espera de
    // que alguien busque algo.
    [Parameter]
    [SupplyParameterFromQuery(Name = "stockBajo")]
    public bool? StockBajo { get; set; }

    private MudDataGrid<ArticuloExistenciaDto>? grilla;
    private string? filtroNombre;
    private string? filtroCategoria;
    private string? filtroEstado;
    private bool filtroSoloStockBajo;

    // Se usa IsNullOrWhiteSpace y no IsNullOrEmpty a propósito: es el mismo criterio
    // con el que el repositorio decide si aplica el filtro. Un campo con solo espacios
    // allá se ignora, así que acá tampoco puede contar como búsqueda; si contara,
    // pedir " " devolvería el catálogo entero.
    private bool HayFiltro =>
        !string.IsNullOrWhiteSpace(filtroNombre) || !string.IsNullOrWhiteSpace(filtroCategoria)
        || !string.IsNullOrWhiteSpace(filtroEstado) || filtroSoloStockBajo;

    // Sin consulta propia al iniciar a propósito: la pantalla abre sin traer nada. Antes
    // cargaba con los filtros vacíos, y como el repositorio los ignora, mostraba la
    // primera página del catálogo completo sin que nadie hubiera buscado. La única
    // excepción es llegar con ?stockBajo=true: ahí sí hay un criterio puesto de entrada
    // y la grilla, al dibujarse, ya consulta con el interruptor encendido.
    protected override void OnInitialized()
    {
        if (StockBajo == true)
            filtroSoloStockBajo = true;
    }

    private async Task<GridData<ArticuloExistenciaDto>> CargarPaginaAsync(
        GridState<ArticuloExistenciaDto> estado, CancellationToken cancellationToken)
    {
        // Sin ningún criterio no se consulta y la tabla queda vacía. Cubre las
        // entradas a este estado: abrir la pantalla, y borrar el texto, quitar la
        // categoría y apagar el interruptor hasta dejar todo en blanco. En ese
        // último caso, salir sin vaciar dejaría en pantalla los resultados de la
        // búsqueda anterior.
        if (!HayFiltro)
            return new GridData<ArticuloExistenciaDto> { Items = Array.Empty<ArticuloExistenciaDto>(), TotalItems = 0 };

        try
        {
            var pagina = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto
            {
                Nombre = filtroNombre,
                Categoria = filtroCategoria,
                Estado = filtroEstado,
                SoloStockBajo = filtroSoloStockBajo,
                Pagina = estado.Page,
                TamanoPagina = estado.PageSize
            });

            return new GridData<ArticuloExistenciaDto>
            {
                Items = pagina.Elementos,
                TotalItems = pagina.TotalRegistros
            };
        }
        catch (Exception)
        {
            // Una base caída no debe tumbar la pantalla con el error sin controlar.
            Snackbar.Add("No se pudieron cargar las existencias. Intente de nuevo.", Severity.Error);
            return new GridData<ArticuloExistenciaDto> { Items = Array.Empty<ArticuloExistenciaDto>(), TotalItems = 0 };
        }
    }

    private async Task OnFiltroNombreCambiadoAsync(string? valor)
    {
        filtroNombre = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroCategoriaCambiadoAsync(string? valor)
    {
        filtroCategoria = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroEstadoCambiadoAsync(string? valor)
    {
        filtroEstado = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroSoloStockBajoCambiadoAsync(bool valor)
    {
        filtroSoloStockBajo = valor;
        await RecargarAsync();
    }

    // Un filtro nuevo vuelve a la primera página: seguir en la 3 de una búsqueda distinta
    // podría caer fuera de rango.
    private async Task RecargarAsync()
    {
        if (grilla is null)
            return;

        if (grilla.CurrentPage != 0)
            grilla.NavigateTo(Page.First);
        else
            await grilla.ReloadServerData();
    }
}
