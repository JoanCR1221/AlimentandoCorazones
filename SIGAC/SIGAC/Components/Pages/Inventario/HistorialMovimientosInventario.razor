@page "/inventario/movimientos/historial"
@attribute [Authorize(Policy = Permisos.Inventario.VerMovimientos)]
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Interfaces
@inject IInventarioService InventarioService
@inject ISnackbar Snackbar

<PageTitle>Historial de movimientos de inventario — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Historial de movimientos de inventario"
                  Descripcion="Consulte las entradas y donaciones de artículos." />

<MudCard Class="pa-4">
    <MudCardContent>
        <MudAutocomplete T="ArticuloExistenciaDto" Label="Artículo" Variant="Variant.Outlined" Class="mb-4"
                          Value="articuloSeleccionado" ValueChanged="OnArticuloCambiadoAsync"
                          SearchFunc="BuscarArticulosAsync" ToStringFunc="@(a => a?.Etiqueta)" Clearable="true" />

        <MudSelect T="string" Value="filtroTipoMovimiento" ValueChanged="OnTipoMovimientoCambiadoAsync"
                   Label="Tipo de movimiento" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            <MudSelectItem T="string" Value="@("Entrada")">Entrada</MudSelectItem>
            <MudSelectItem T="string" Value="@("Donacion")">Donación</MudSelectItem>
        </MudSelect>

        <MudDateRangePicker Culture="CulturaSigac.EsCr" DateRange="rangoFechas" DateRangeChanged="OnRangoFechasCambiadoAsync"
                             Label="Rango de fechas" Variant="Variant.Outlined" Class="mb-4" />

        @* Unidades de TODO el período filtrado, no de la página que se ve: vienen de
           un agregado en la base, junto con cada página. *@
        @* Sin filtro no hay consulta: un "0" se leería como que no hubo movimientos. *@
        @if (HayFiltro)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-4">
                Total de entradas: @TextoResumen.Numero(resultado.TotalEntradas) · Total de salidas: @TextoResumen.Numero(resultado.TotalSalidas)
            </MudText>
        }

        @* ServerData en lugar de Items: el historial crece con cada movimiento, así
           que la grilla pide una página por vez y el repositorio trae de la base solo
           esos registros. SortMode.None porque el orden (más reciente primero) lo
           fija la consulta en SQL: dejar ordenar por columna solo reordenaría la
           página visible, que sería engañoso. *@
        @* Una sola grilla para los tres tamaños (ver ListadoBeneficiarios): en móvil
           (< 768px) solo se ve la celda "tarjeta"; desde 768px, la tabla con las
           cinco columnas, que en tableta caben partiendo en dos líneas los dos
           encabezados largos. *@
        <MudDataGrid T="MovimientoInventarioDto" @ref="grilla" Class="ac-grilla-tarjetas" Breakpoint="Breakpoint.None"
                     ServerData="CargarPaginaAsync"
                     RowsPerPage="FiltrosMovimientoDto.TamanoPaginaPredeterminado"
                     SortMode="SortMode.None" Filterable="false">
            <Columns>
                <PropertyColumn Property="x => x.Articulo" Title="Artículo" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                @* Estos dos encabezados pueden partirse en dos líneas (la regla general
                   de app.css los deja en una): enteros, "Tipo de movimiento" y
                   "Origen / Destino" pedían ~290 px y la tabla no entraba en tableta.
                   En escritorio hay lugar y siguen en una línea. Mismo criterio que
                   ListadoTiposGasto. *@
                <TemplateColumn Title="Tipo de movimiento" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" HeaderStyle="white-space: normal">
                    <CellTemplate>@EtiquetaTipoMovimiento(context.Item.TipoMovimiento)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Cantidad" Title="Cantidad" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <TemplateColumn Title="Origen / Destino" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" HeaderStyle="white-space: normal">
                    <CellTemplate>@EtiquetaTipoMovimiento(context.Item.OrigenODestino ?? string.Empty)</CellTemplate>
                </TemplateColumn>
                @* Solo móvil: el artículo arriba con el tipo de movimiento como
                   etiqueta; la fecha, la cantidad y el origen (de una entrada) o el
                   destino (de una salida) siempre a la vista, sin "Ver más": no queda
                   nada más que mostrar. *@
                <TemplateColumn Title="Movimiento" CellClass="ac-col-tarjeta" HeaderClass="ac-col-tarjeta">
                    <CellTemplate>
                        <TarjetaFila Titulo="@context.Item.Articulo">
                            <Estado>
                                <span class="ac-tarjeta-etiqueta">@EtiquetaTipoMovimiento(context.Item.TipoMovimiento)</span>
                            </Estado>
                            <Lineas>
                                <p class="ac-tarjeta-dato">@context.Item.Fecha.ToString("dd/MM/yyyy")</p>
                                <p class="ac-tarjeta-dato">Cantidad: @context.Item.Cantidad</p>
                                @if (!string.IsNullOrWhiteSpace(context.Item.OrigenODestino))
                                {
                                    <p class="ac-tarjeta-dato">@EtiquetaOrigenODestino(context.Item): @EtiquetaTipoMovimiento(context.Item.OrigenODestino)</p>
                                }
                            </Lineas>
                        </TarjetaFila>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ningún movimiento coincide con los filtros"
                                 Descripcion="Pruebe con otro artículo, tipo de movimiento o rango de fechas." />
                }
                else
                {
                    @* Sin filtros no se consulta nada, así que acá no se sabe si hay
                       movimientos: se invita a buscar. *@
                    <EstadoVacio Icono="@Icons.Material.Filled.SwapHoriz"
                                 Titulo="Busque un artículo, o elija un tipo de movimiento o un rango de fechas"
                                 Descripcion="Así se consultan solo los movimientos que necesita, sin cargar el historial completo." />
                }
            </NoRecordsContent>
            <PagerContent>
                @* Sin filas no hay nada que paginar: el paginador solo estorbaba (F-16). *@
                @if (grilla?.GetFilteredItemsCount() > 0)
                {
                    <MudDataGridPager T="MovimientoInventarioDto"
                                      PageSizeOptions="@(new[] { FiltrosMovimientoDto.TamanoPaginaPredeterminado, 50, FiltrosMovimientoDto.TamanoPaginaMaximo })" />
                }
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private MudDataGrid<MovimientoInventarioDto>? grilla;

    // Lo último que devolvió el servicio: la grilla muestra su página y los totales
    // de arriba salen del mismo resultado.
    private HistorialMovimientosResultadoDto resultado = new();
    private ArticuloExistenciaDto? articuloSeleccionado;
    private string? filtroTipoMovimiento;
    private DateRange? rangoFechas;

    private bool HayFiltro =>
        articuloSeleccionado is not null || !string.IsNullOrWhiteSpace(filtroTipoMovimiento) || rangoFechas is not null;

    private async Task<IEnumerable<ArticuloExistenciaDto>> BuscarArticulosAsync(string valor, CancellationToken cancellationToken)
    {
        var existencias = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto { Nombre = valor });
        return existencias.Elementos;
    }

    private async Task OnArticuloCambiadoAsync(ArticuloExistenciaDto? valor)
    {
        articuloSeleccionado = valor;
        await RecargarAsync();
    }

    private async Task OnTipoMovimientoCambiadoAsync(string? valor)
    {
        filtroTipoMovimiento = valor;
        await RecargarAsync();
    }

    private async Task OnRangoFechasCambiadoAsync(DateRange? valor)
    {
        rangoFechas = valor;
        await RecargarAsync();
    }

    private static string EtiquetaTipoMovimiento(string tipoMovimiento) => tipoMovimiento switch
    {
        "Donacion" => "Donación",
        _ => tipoMovimiento
    };

    // En la tarjeta de móvil no está el encabezado "Origen / Destino": una entrada
    // dice de dónde vino (donación o compra) y una salida, a quién fue.
    private static string EtiquetaOrigenODestino(MovimientoInventarioDto movimiento) =>
        movimiento.TipoMovimiento == FiltrosMovimientoDto.TipoEntrada ? "Origen" : "Destino";

    // La llama la grilla cada vez que cambia de página o se recarga. Devuelve solo
    // los movimientos de esa página más el total, que es lo que necesita el paginador.
    private async Task<GridData<MovimientoInventarioDto>> CargarPaginaAsync(
        GridState<MovimientoInventarioDto> estado, CancellationToken cancellationToken)
    {
        // La pantalla abre sin consultar el historial: sin ningún criterio
        // no se va a la base y la grilla queda vacía, con la invitación a buscar.
        // Mismo criterio que ListadoGastos. Cubre también quitar todos los filtros.
        if (!HayFiltro)
        {
            resultado = new HistorialMovimientosResultadoDto();
            StateHasChanged();
            return new GridData<MovimientoInventarioDto> { Items = Array.Empty<MovimientoInventarioDto>(), TotalItems = 0 };
        }

        try
        {
            resultado = await InventarioService.ObtenerPaginaHistorialMovimientosAsync(new FiltrosMovimientoDto
            {
                ArticuloId = articuloSeleccionado?.Id,
                TipoMovimiento = filtroTipoMovimiento,
                Desde = rangoFechas?.Start,
                Hasta = rangoFechas?.End,
                Pagina = estado.Page,
                TamanoPagina = estado.PageSize
            });
        }
        catch (Exception)
        {
            resultado = new HistorialMovimientosResultadoDto();
            Snackbar.Add("No se pudo cargar el historial de movimientos. Intente de nuevo.", Severity.Error);
        }

        // Los totales de arriba están fuera de la grilla: ella se vuelve a dibujar sola
        // al recibir la página, pero la pantalla no.
        StateHasChanged();

        return new GridData<MovimientoInventarioDto>
        {
            Items = resultado.Movimientos,
            TotalItems = resultado.TotalRegistros
        };
    }

    // Al cambiar un filtro se vuelve a la primera página: la que se estaba viendo
    // puede no existir con el filtro nuevo (y quedaría vacía).
    //
    // NavigateTo cambia CurrentPage, y el setter de CurrentPage ya dispara
    // ServerData por dentro. Por eso solo se recarga a mano en la otra rama: así el
    // cambio de filtro cuesta una sola consulta y no dos.
    private async Task RecargarAsync()
    {
        if (grilla is null)
            return;

        if (grilla.CurrentPage != 0)
            grilla.NavigateTo(Page.First);
        else
            await grilla.ReloadServerData();
    }
}
