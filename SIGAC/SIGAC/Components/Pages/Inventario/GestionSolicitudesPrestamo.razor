@page "/inventario/prestamos/gestionar"
@attribute [Authorize(Policy = Permisos.Inventario.GestionarSolicitudes)]
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject IInventarioService InventarioService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<EncabezadoPagina Titulo="Solicitudes de préstamo pendientes"
                  Descripcion="Apruebe o rechace las solicitudes de préstamo de artículos." />

<MudCard Class="pa-4">
    <MudCardContent>
        <MudDataGrid T="SolicitudPrestamoListaDto" Items="@solicitudes" Loading="cargando">
            <Columns>
                <PropertyColumn Property="x => x.Articulo" Title="Artículo" />
                <PropertyColumn Property="x => x.Cantidad" Title="Cantidad" />
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.Actividad" Title="Actividad" />
                <PropertyColumn Property="x => x.Solicitante" Title="Solicitante" />
                <PropertyColumn Property="x => x.Estado" Title="Estado" />
                <TemplateColumn Title="Acciones">
                    <CellTemplate>
                        <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="@(() => AprobarAsync(context.Item.Id))">Aprobar</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RechazarAsync(context.Item.Id))">Rechazar</MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @* Estado vacío positivo: una cola sin pendientes es buena noticia, no
                   un catálogo al que le falte algo. *@
                <EstadoVacio Icono="@Icons.Material.Filled.CheckCircle"
                             Titulo="No hay solicitudes de préstamo pendientes"
                             Descripcion="Estás al día." />
            </NoRecordsContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private IEnumerable<SolicitudPrestamoListaDto> solicitudes = new List<SolicitudPrestamoListaDto>();
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;

        try
        {
            var todas = await InventarioService.ObtenerSolicitudesAsync();
            solicitudes = todas.Where(s => s.Estado == "Pendiente");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AprobarAsync(int solicitudId)
    {
        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Confirmar", "¿Aprobar esta solicitud de préstamo? El stock se descontará automáticamente.",
            yesText: "Aprobar", cancelText: "Cancelar");

        if (confirmado != true)
            return;

        try
        {
            await InventarioService.AprobarPrestamoAsync(new ResolucionPrestamoDto { SolicitudId = solicitudId, Aprobado = true });
            Snackbar.Add("Solicitud aprobada correctamente.", Severity.Success);
            await CargarAsync();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo aprobar la solicitud. Intentá de nuevo.", Severity.Error);
        }
    }

    private async Task RechazarAsync(int solicitudId)
    {
        var dialog = await DialogService.ShowAsync<RechazarSolicitudDialog>("Rechazar solicitud");
        var resultado = await dialog.Result;

        if (resultado is null || resultado.Canceled)
            return;

        var motivo = (string)resultado.Data!;

        try
        {
            await InventarioService.RechazarPrestamoAsync(new ResolucionPrestamoDto { SolicitudId = solicitudId, MotivoRechazo = motivo });
            Snackbar.Add("Solicitud rechazada.", Severity.Success);
            await CargarAsync();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo rechazar la solicitud. Intentá de nuevo.", Severity.Error);
        }
    }
}
