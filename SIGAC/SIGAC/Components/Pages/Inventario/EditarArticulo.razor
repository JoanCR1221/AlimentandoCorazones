@page "/inventario/articulos/editar/{Id:int}"
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject IInventarioService InventarioService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Editar artículo</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            <MudTextField @bind-Value="modelo.Nombre" For="@(() => modelo.Nombre)" Label="Nombre" Variant="Variant.Outlined" />

            <MudTextField @bind-Value="modelo.Codigo" Label="Código (opcional)" Variant="Variant.Outlined" Class="mt-4" />

            <MudAutocomplete T="string" @bind-Value="modelo.Categoria" For="@(() => modelo.Categoria)"
                              Label="Categoría" Variant="Variant.Outlined" Class="mt-4"
                              SearchFunc="BuscarCategoriasAsync" CoerceText="false" CoerceValue="true"
                              HelperText="Elegí una categoría existente o escribí una nueva." />

            <MudAutocomplete T="string" @bind-Value="modelo.UnidadMedida" For="@(() => modelo.UnidadMedida)"
                              Label="Unidad de medida" Variant="Variant.Outlined" Class="mt-4"
                              SearchFunc="BuscarUnidadesMedidaAsync" CoerceText="false" CoerceValue="true"
                              HelperText="Elegí una unidad existente o escribí una nueva." />

            <MudTextField @bind-Value="modelo.Ubicacion" Label="Ubicación (opcional)" Variant="Variant.Outlined" Class="mt-4" />

            <MudNumericField T="int" @bind-Value="modelo.StockMinimo" For="@(() => modelo.StockMinimo)" Label="Stock mínimo" Variant="Variant.Outlined" Class="mt-4" Min="0" />

            <MudNumericField T="int" Value="modelo.StockActual" Label="Stock actual" Variant="Variant.Outlined" Class="mt-4" ReadOnly="true" />
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private ArticuloEditarDto modelo = new();
    private IReadOnlyList<string> categoriasDisponibles = Array.Empty<string>();
    private IReadOnlyList<string> unidadesMedidaDisponibles = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        var datos = await InventarioService.ObtenerParaEditarAsync(Id);
        if (datos is null)
        {
            NavigationManager.NavigateTo("/inventario/existencias");
            return;
        }

        modelo = datos;
        categoriasDisponibles = await InventarioService.ObtenerCategoriasAsync();
        unidadesMedidaDisponibles = await InventarioService.ObtenerUnidadesMedidaAsync();
    }

    private Task<IEnumerable<string>> BuscarCategoriasAsync(string valor, CancellationToken cancellationToken)
    {
        var resultado = string.IsNullOrWhiteSpace(valor)
            ? categoriasDisponibles.AsEnumerable()
            : categoriasDisponibles.Where(c => c.Contains(valor, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(resultado);
    }

    private Task<IEnumerable<string>> BuscarUnidadesMedidaAsync(string valor, CancellationToken cancellationToken)
    {
        var resultado = string.IsNullOrWhiteSpace(valor)
            ? unidadesMedidaDisponibles.AsEnumerable()
            : unidadesMedidaDisponibles.Where(u => u.Contains(valor, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(resultado);
    }

    private async Task Guardar()
    {
        try
        {
            await InventarioService.EditarArticuloAsync(Id, modelo);
            Snackbar.Add("Artículo actualizado correctamente.", Severity.Success);
            NavigationManager.NavigateTo("/inventario/existencias");
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (DuplicateException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo actualizar el artículo. Intentá de nuevo.", Severity.Error);
        }
    }
}
