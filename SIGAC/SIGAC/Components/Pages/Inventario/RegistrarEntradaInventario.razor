@page "/inventario/entradas/registrar"
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Interfaces
@inject IInventarioService InventarioService

<MudText Typo="Typo.h4" Class="mb-4">Registrar entrada de inventario</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            <MudAutocomplete T="string" Label="Nombre del artículo" Variant="Variant.Outlined"
                              Value="modelo.NombreArticulo" ValueChanged="OnNombreArticuloCambiadoAsync"
                              SearchFunc="BuscarNombresArticuloAsync" CoerceText="false" CoerceValue="true"
                              HelperText="Buscá un artículo existente o escribí uno nuevo." />

            @if (articuloExistente is not null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">
                    Ya existe este artículo (stock actual: @articuloExistente.StockActual @articuloExistente.UnidadMedida). Se usará su categoría y unidad de medida registradas.
                </MudAlert>
            }

            <MudSelect T="string" @bind-Value="modelo.Categoria" For="@(() => modelo.Categoria)"
                       Label="Categoría" Variant="Variant.Outlined" Class="mt-4" Disabled="articuloExistente is not null">
                <MudSelectItem T="string" Value="@("Alimentos")">Alimentos</MudSelectItem>
                <MudSelectItem T="string" Value="@("Ropa")">Ropa</MudSelectItem>
                <MudSelectItem T="string" Value="@("Calzado")">Calzado</MudSelectItem>
                <MudSelectItem T="string" Value="@("Equipos")">Equipos</MudSelectItem>
            </MudSelect>

            <MudSelect T="string" @bind-Value="modelo.UnidadMedida" For="@(() => modelo.UnidadMedida)"
                       Label="Unidad de medida" Variant="Variant.Outlined" Class="mt-4" Disabled="articuloExistente is not null">
                <MudSelectItem T="string" Value="@("Unidad")">Unidad</MudSelectItem>
                <MudSelectItem T="string" Value="@("Kilogramo")">Kilogramo</MudSelectItem>
                <MudSelectItem T="string" Value="@("Litro")">Litro</MudSelectItem>
                <MudSelectItem T="string" Value="@("Caja")">Caja</MudSelectItem>
                <MudSelectItem T="string" Value="@("Paquete")">Paquete</MudSelectItem>
            </MudSelect>

            <MudNumericField T="int" @bind-Value="modelo.Cantidad" For="@(() => modelo.Cantidad)"
                              Label="Cantidad" Variant="Variant.Outlined" Class="mt-4" Min="1" />

            <MudDatePicker @bind-Date="fecha" Label="Fecha" Variant="Variant.Outlined" Class="mt-4" MaxDate="DateTime.Today" />

            <MudSelect T="string" @bind-Value="modelo.Origen" For="@(() => modelo.Origen)" @bind-Value:after="OnOrigenCambiado"
                       Label="Origen" Variant="Variant.Outlined" Class="mt-4">
                <MudSelectItem T="string" Value="@("Donacion")">Donación</MudSelectItem>
                <MudSelectItem T="string" Value="@("Compra")">Compra</MudSelectItem>
            </MudSelect>

            @if (modelo.Origen == "Donacion")
            {
                <MudAutocomplete T="string" Label="Donante" Variant="Variant.Outlined" Class="mt-4"
                                  Value="donanteSeleccionado" ValueChanged="OnDonanteCambiado"
                                  SearchFunc="BuscarDonantesAsync" Clearable="true" />
            }
            else if (modelo.Origen == "Compra")
            {
                <MudSelect T="string" Value="gastoOperativoSeleccionado" ValueChanged="OnGastoOperativoCambiado"
                           Label="Gasto operativo" Variant="Variant.Outlined" Class="mt-4" Clearable="true">
                    @foreach (var gasto in GastosOperativosMock.Keys)
                    {
                        <MudSelectItem T="string" Value="@gasto">@gasto</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    // Mock temporal: el módulo de Donaciones todavía no existe.
    private static readonly Dictionary<string, int> DonantesMock = new()
    {
        ["Empresa Alimentos del Valle"] = 1,
        ["Supermercado La Colonia"] = 2,
        ["Panadería San José"] = 3,
        ["Donante anónimo"] = 4
    };

    // Mock temporal: el módulo de Gastos Operativos todavía no existe.
    private static readonly Dictionary<string, int> GastosOperativosMock = new()
    {
        ["Compra de alimentos"] = 1,
        ["Compra de insumos de limpieza"] = 2,
        ["Compra de ropa y calzado"] = 3
    };

    private EntradaInventarioCrearDto modelo = new();
    private ArticuloExistenciaDto? articuloExistente;
    private string? donanteSeleccionado;
    private string? gastoOperativoSeleccionado;

    private DateTime? fecha
    {
        get => modelo.Fecha == default ? null : modelo.Fecha;
        set => modelo.Fecha = value ?? default;
    }

    private async Task<IEnumerable<string>> BuscarNombresArticuloAsync(string valor, CancellationToken cancellationToken)
    {
        var existencias = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto { Nombre = valor });
        return existencias.Select(a => a.Nombre);
    }

    private async Task OnNombreArticuloCambiadoAsync(string? valor)
    {
        modelo.NombreArticulo = valor ?? string.Empty;
        articuloExistente = null;

        if (!string.IsNullOrWhiteSpace(modelo.NombreArticulo))
        {
            var existencias = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto { Nombre = modelo.NombreArticulo });
            articuloExistente = existencias.FirstOrDefault(a => string.Equals(a.Nombre, modelo.NombreArticulo, StringComparison.OrdinalIgnoreCase));
        }

        if (articuloExistente is not null)
        {
            modelo.Categoria = articuloExistente.Categoria;
            modelo.UnidadMedida = articuloExistente.UnidadMedida;
        }
    }

    private void OnOrigenCambiado()
    {
        donanteSeleccionado = null;
        modelo.DonanteId = null;
        gastoOperativoSeleccionado = null;
        modelo.GastoOperativoId = null;
    }

    private Task<IEnumerable<string>> BuscarDonantesAsync(string valor, CancellationToken cancellationToken)
    {
        var resultado = string.IsNullOrWhiteSpace(valor)
            ? DonantesMock.Keys.AsEnumerable()
            : DonantesMock.Keys.Where(d => d.Contains(valor, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(resultado);
    }

    private void OnDonanteCambiado(string? valor)
    {
        donanteSeleccionado = valor;
        modelo.DonanteId = valor is not null && DonantesMock.TryGetValue(valor, out var id) ? id : null;
    }

    private void OnGastoOperativoCambiado(string? valor)
    {
        gastoOperativoSeleccionado = valor;
        modelo.GastoOperativoId = valor is not null && GastosOperativosMock.TryGetValue(valor, out var id) ? id : null;
    }

    private async Task Guardar()
    {
        await InventarioService.RegistrarEntradaAsync(modelo);
    }
}
