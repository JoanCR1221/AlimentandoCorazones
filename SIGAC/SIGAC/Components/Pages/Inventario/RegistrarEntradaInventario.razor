@page "/inventario/entradas/registrar"
@using SIGAC.Application.DTOs.Donaciones
@using SIGAC.Application.DTOs.Gastos
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@using SIGAC.Domain.Entities
@inject IInventarioService InventarioService
@inject IDonantesService DonantesService
@inject IGastosService GastosService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Registrar entrada de inventario</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            @* MinCharacters="1" es lo que evita que al enfocar el campo se despliegue
               el catálogo entero: sin él (el valor por omisión es 0) MudBlazor llama a
               SearchFunc con la cadena vacía apenas el campo recibe el foco, y una
               búsqueda sin texto devuelve la primera página completa de artículos.
               Con 1, no hay sugerencias hasta que el usuario escribe, y lo que se
               ofrece siempre está filtrado por lo que escribió.

               DebounceInterval evita una consulta por cada tecla mientras escribe;
               son los mismos 300 ms que ya usa el buscador de ExistenciasInventario.

               CoerceValue="true" se mantiene y es esencial: permite confirmar un
               nombre que NO está en la lista, que es como se dan de alta los
               artículos nuevos desde esta pantalla. *@
            <MudAutocomplete T="string" Label="Nombre del artículo" Variant="Variant.Outlined"
                              Value="modelo.NombreArticulo" ValueChanged="OnNombreArticuloCambiadoAsync"
                              SearchFunc="BuscarNombresArticuloAsync" CoerceText="false" CoerceValue="true"
                              MinCharacters="1" DebounceInterval="300"
                              HelperText="Escribí para buscar un artículo existente, o ingresá uno nuevo." />

            @if (articuloExistente is not null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">
                    Ya existe este artículo (stock actual: @articuloExistente.StockActual @articuloExistente.UnidadMedida). Se usará su categoría, unidad de medida, código y ubicación registrados.
                </MudAlert>
            }

            @* Código y Ubicación quedan deshabilitados igual que categoría y unidad
               cuando el artículo ya existe: en ese caso el servicio usa los valores
               que el artículo ya tiene guardados y descarta los del formulario. *@
            <MudTextField @bind-Value="modelo.Codigo" Label="Código (opcional)" Variant="Variant.Outlined" Class="mt-4"
                          Disabled="articuloExistente is not null" />

            <MudSelect T="string" @bind-Value="modelo.Categoria" For="@(() => modelo.Categoria)"
                       @bind-Value:after="OnCategoriaCambiada"
                       Label="Categoría" Variant="Variant.Outlined" Class="mt-4" Disabled="articuloExistente is not null">
                @foreach (var categoria in CategoriasArticulo.Todos)
                {
                    <MudSelectItem T="string" Value="@categoria">@categoria</MudSelectItem>
                }
            </MudSelect>

            @* Las opciones salen de UnidadesMedidaArticulo según la categoría elegida,
               la misma fuente que valida el servicio: no se puede ofrecer una unidad
               que el guardado vaya a rechazar (antes se ofrecían las cinco siempre,
               así que "Calzado" + "Litro" era elegible). *@
            <MudSelect T="string" @bind-Value="modelo.UnidadMedida" For="@(() => modelo.UnidadMedida)"
                       Label="Unidad de medida" Variant="Variant.Outlined" Class="mt-4"
                       Disabled="articuloExistente is not null || string.IsNullOrWhiteSpace(modelo.Categoria)"
                       HelperText="@(articuloExistente is null && string.IsNullOrWhiteSpace(modelo.Categoria) ? "Elegí primero una categoría." : null)">
                @foreach (var unidad in UnidadesMedidaArticulo.ObtenerUnidadesValidas(modelo.Categoria))
                {
                    <MudSelectItem T="string" Value="@unidad">@unidad</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="modelo.Ubicacion" Label="Ubicación (opcional)" Variant="Variant.Outlined" Class="mt-4"
                          Disabled="articuloExistente is not null" />

            <MudNumericField T="int" @bind-Value="modelo.Cantidad" For="@(() => modelo.Cantidad)"
                              Label="Cantidad" Variant="Variant.Outlined" Class="mt-4" Min="1" />

            <MudDatePicker @bind-Date="fecha" Label="Fecha" Variant="Variant.Outlined" Class="mt-4" MaxDate="DateTime.Today" />

            <MudSelect T="string" @bind-Value="modelo.Origen" For="@(() => modelo.Origen)" @bind-Value:after="OnOrigenCambiadoAsync"
                       Label="Origen" Variant="Variant.Outlined" Class="mt-4">
                <MudSelectItem T="string" Value="@("Donacion")">Donación</MudSelectItem>
                <MudSelectItem T="string" Value="@("Compra")">Compra</MudSelectItem>
            </MudSelect>

            @if (modelo.Origen == "Donacion")
            {
                @* Donantes reales y solo activos. Antes esto salía de un diccionario
                   en memoria con los ids 1 a 4 inventados: nunca correspondieron a
                   una fila de Donantes, y desde que DonanteId es FK real cada uno de
                   ellos rebota contra la base. Mismo buscador que
                   RegistrarDonacionDinero.razor. *@
                <MudAutocomplete T="DonanteListaDto" Label="Donante (opcional)" Variant="Variant.Outlined" Class="mt-4"
                                  Value="donanteSeleccionado" ValueChanged="OnDonanteSeleccionado"
                                  SearchFunc="BuscarDonantesActivosAsync" ToStringFunc="@(d => d?.Nombre)"
                                  MinCharacters="1" DebounceInterval="300" Clearable="true"
                                  HelperText="Escribí para buscar un donante ya registrado." />

                @if (sinDonantesActivos)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-2">
                        Todavía no hay donantes activos registrados. Podés guardar la entrada sin donante, o darlo de alta primero en Donantes.
                    </MudAlert>
                }
            }
            else if (modelo.Origen == "Compra")
            {
                @if (GastoOperativoId.HasValue && modelo.GastoOperativoId == GastoOperativoId)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        Esta entrada quedará vinculada al gasto operativo #@GastoOperativoId que acabás de registrar.
                    </MudAlert>
                }
                else
                {
                    @* Solo gastos de CompraInsumos todavía activos: son los únicos que
                       una entrada de inventario puede respaldar. Un gasto anulado ya no
                       representa dinero gastado, y vincularle una entrada nueva la
                       dejaría viva colgando de él, porque la reversión de stock ocurre
                       en el momento de anular y ese momento ya pasó. Un mismo gasto sí
                       puede recibir varias entradas: la compra de tres artículos son
                       tres entradas. Antes acá había tres ids inventados (1, 2 y 3). *@
                    <MudSelect T="GastoOperativoListaDto" Value="gastoSeleccionado" ValueChanged="OnGastoOperativoCambiado"
                               ToStringFunc="@(g => EtiquetaGasto(g))"
                               Label="Gasto operativo (opcional)" Variant="Variant.Outlined" Class="mt-4" Clearable="true"
                               HelperText="Vinculá la entrada al gasto de compra que la respalda.">
                        @foreach (var gasto in gastosVinculables)
                        {
                            <MudSelectItem T="GastoOperativoListaDto" Value="@gasto">@EtiquetaGasto(gasto)</MudSelectItem>
                        }
                    </MudSelect>

                    @if (gastosCargados && gastosVinculables.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            Todavía no hay gastos de compra de insumos activos. Podés guardar la entrada sin vincularla, o registrar el gasto primero en Gastos operativos.
                        </MudAlert>
                    }
                }
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    // Llega desde RegistrarGasto.razor cuando se registra un gasto CompraInsumos
    // (AB#2501): la persona decide desde ahí si quiere completar la entrada, así
    // que acá solo se recibe el Id y se preselecciona el origen. No se crea ni
    // vincula nada automáticamente si el usuario llega sin este parámetro.
    [Parameter]
    [SupplyParameterFromQuery]
    public int? GastoOperativoId { get; set; }

    private EntradaInventarioCrearDto modelo = new();
    private ArticuloExistenciaDto? articuloExistente;
    private DonanteListaDto? donanteSeleccionado;
    private GastoOperativoListaDto? gastoSeleccionado;

    // Gastos que la entrada puede respaldar. Se llena al elegir origen "Compra".
    private List<GastoOperativoListaDto> gastosVinculables = new();

    // Distingue "todavía no fui a buscarlos" de "fui y no hay ninguno": sin esta
    // bandera, el aviso de lista vacía aparecería durante la carga.
    private bool gastosCargados;
    private bool sinDonantesActivos;

    private DateTime? fecha
    {
        get => modelo.Fecha == default ? null : modelo.Fecha;
        set => modelo.Fecha = value ?? default;
    }

    // Sin OnInitializedAsync ni listas cacheadas de categorías/unidades: las opciones
    // de esos dos desplegables salen del catálogo cerrado en SIGAC.Domain, que se lee
    // directo desde el marcado. Donantes y gastos sí vienen del servidor, pero recién
    // al elegir el origen: al abrir la pantalla sigue sin haber nada que traer.

    protected override void OnInitialized()
    {
        if (GastoOperativoId.HasValue)
        {
            modelo.Origen = "Compra";
            modelo.GastoOperativoId = GastoOperativoId;
        }
    }

    private async Task<IEnumerable<string>> BuscarNombresArticuloAsync(string valor, CancellationToken cancellationToken)
    {
        // Guarda explícita, además del MinCharacters del componente: una búsqueda sin
        // texto NO significa "todos los artículos" acá. El repositorio ignora el
        // filtro de nombre cuando llega vacío y devuelve la primera página entera del
        // catálogo, que es exactamente lo que no queremos desplegar sin que el usuario
        // haya escrito nada.
        if (string.IsNullOrWhiteSpace(valor))
            return Array.Empty<string>();

        var existencias = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto { Nombre = valor });
        return existencias.Elementos.Select(a => a.Nombre);
    }

    private async Task OnNombreArticuloCambiadoAsync(string? valor)
    {
        modelo.NombreArticulo = valor ?? string.Empty;
        articuloExistente = null;

        if (!string.IsNullOrWhiteSpace(modelo.NombreArticulo))
        {
            var existencias = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto { Nombre = modelo.NombreArticulo });
            articuloExistente = existencias.Elementos.FirstOrDefault(a => string.Equals(a.Nombre, modelo.NombreArticulo, StringComparison.OrdinalIgnoreCase));
        }

        if (articuloExistente is not null)
        {
            modelo.Categoria = articuloExistente.Categoria;
            modelo.UnidadMedida = articuloExistente.UnidadMedida;
            modelo.Codigo = articuloExistente.Codigo;
            modelo.Ubicacion = articuloExistente.Ubicacion;
        }
    }

    // Al cambiar de categoría, la unidad ya elegida puede dejar de pertenecer a la
    // nueva lista (por ejemplo "Litro" al pasar de Alimento a Calzado). Si se dejara,
    // el campo mostraría un valor que ya no está entre las opciones y el guardado lo
    // rechazaría recién al enviar el formulario.
    private void OnCategoriaCambiada()
    {
        if (!UnidadesMedidaArticulo.EsValidaParaCategoria(modelo.Categoria, modelo.UnidadMedida))
            modelo.UnidadMedida = string.Empty;
    }

    // Las dos listas se traen recién al elegir el origen, no al abrir la pantalla:
    // cada entrada usa uno solo de los dos caminos, así que cargar ambos siempre
    // sería una consulta de más en cada visita.
    private async Task OnOrigenCambiadoAsync()
    {
        donanteSeleccionado = null;
        modelo.DonanteId = null;
        gastoSeleccionado = null;
        modelo.GastoOperativoId = null;

        if (modelo.Origen == "Donacion")
            await VerificarSiHayDonantesActivosAsync();
        else if (modelo.Origen == "Compra")
            await CargarGastosVinculablesAsync();
    }

    // Existe solo para poder avisar que la lista está vacía. Se pide una sola fila
    // porque lo único que se mira es TotalRegistros: el buscador es por texto, así
    // que sin este aviso "no hay ningún donante cargado" y "escribiste un nombre
    // que no existe" se verían exactamente igual.
    private async Task VerificarSiHayDonantesActivosAsync()
    {
        var resultado = await DonantesService.ObtenerDonantesAsync(new FiltrosDonanteDto
        {
            Estado = true,
            TamanoPagina = 1
        });

        sinDonantesActivos = resultado.TotalRegistros == 0;
    }

    private async Task CargarGastosVinculablesAsync()
    {
        // Categoria viaja en el filtro y se resuelve en SQL. Estado se descarta acá
        // porque FiltrosGastoDto no lo expresa; empujarlo al repositorio obligaría a
        // tocar el backend y, según acordamos entre sesiones, sería además el
        // disparador para revisar el índice de GastosOperativos. Sobre los gastos de
        // una sola categoría el filtro en memoria no lo justifica.
        var consulta = await GastosService.ObtenerGastosAsync(new FiltrosGastoDto
        {
            Categoria = CategoriasGastoOperativo.CompraInsumos
        });

        gastosVinculables = consulta.Gastos
            .Where(g => g.Estado == nameof(EstadoGastoOperativo.Activo))
            .ToList();

        gastosCargados = true;
    }

    private async Task<IEnumerable<DonanteListaDto>> BuscarDonantesActivosAsync(string valor, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return Array.Empty<DonanteListaDto>();

        // Solo activos: desactivar un donante es justamente lo que lo saca de los
        // desplegables, que es para lo que existe la baja lógica en IDonantesService.
        var resultado = await DonantesService.ObtenerDonantesAsync(new FiltrosDonanteDto
        {
            Nombre = valor,
            Estado = true
        });

        return resultado.Elementos;
    }

    private void OnDonanteSeleccionado(DonanteListaDto? valor)
    {
        donanteSeleccionado = valor;
        modelo.DonanteId = valor?.Id;
    }

    private void OnGastoOperativoCambiado(GastoOperativoListaDto? valor)
    {
        gastoSeleccionado = valor;
        modelo.GastoOperativoId = valor?.Id;
    }

    // El id va al frente porque es lo que la persona ve en el aviso al llegar desde
    // RegistrarGasto.razor ("gasto operativo #12"), y dos compras del mismo día por
    // el mismo monto no se distinguirían sin él.
    private static string EtiquetaGasto(GastoOperativoListaDto? gasto) =>
        gasto is null
            ? string.Empty
            : $"#{gasto.Id} · {gasto.Fecha:dd/MM/yyyy} · ₡{gasto.Monto:N2} · {gasto.Descripcion}";

    private async Task Guardar()
    {
        try
        {
            await InventarioService.RegistrarEntradaAsync(modelo);
            Snackbar.Add("Entrada de inventario registrada correctamente.", Severity.Success);

            modelo = new();
            articuloExistente = null;
            donanteSeleccionado = null;
            gastoSeleccionado = null;

            // Se descarta la lista traída: al elegir origen de nuevo se vuelve a
            // pedir, y así aparece el gasto que se haya registrado mientras tanto.
            gastosVinculables = new();
            gastosCargados = false;
            sinDonantesActivos = false;
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (DuplicateException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar la entrada de inventario. Intentá de nuevo.", Severity.Error);
        }
    }
}
