@page "/inventario/prestamos/solicitar"
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject IInventarioService InventarioService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Solicitar préstamo de artículo</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            <MudAutocomplete T="ArticuloExistenciaDto" Label="Artículo" Variant="Variant.Outlined"
                              Value="articuloSeleccionado" ValueChanged="OnArticuloCambiado"
                              SearchFunc="BuscarArticulosAsync"
                              ToStringFunc="@(a => a is null ? null : $"{a.Nombre} (stock: {a.StockActual} {a.UnidadMedida})")" />

            <MudNumericField T="int" @bind-Value="modelo.Cantidad" For="@(() => modelo.Cantidad)" Label="Cantidad" Variant="Variant.Outlined" Class="mt-4" Min="1" />

            <MudDatePicker @bind-Date="fecha" Label="Fecha de la actividad" Variant="Variant.Outlined" Class="mt-4" />

            <MudTextField @bind-Value="modelo.Actividad" For="@(() => modelo.Actividad)" Label="Actividad" Variant="Variant.Outlined" Class="mt-4" />

            <MudTextField @bind-Value="modelo.Solicitante" For="@(() => modelo.Solicitante)" Label="Solicitante" Variant="Variant.Outlined" Class="mt-4" />
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Solicitar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    private SolicitudPrestamoCrearDto modelo = new();
    private ArticuloExistenciaDto? articuloSeleccionado;

    private DateTime? fecha
    {
        get => modelo.Fecha == default ? null : modelo.Fecha;
        set => modelo.Fecha = value ?? default;
    }

    private async Task<IEnumerable<ArticuloExistenciaDto>> BuscarArticulosAsync(string valor, CancellationToken cancellationToken)
    {
        var resultado = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto { Nombre = valor });
        return resultado.Elementos;
    }

    private void OnArticuloCambiado(ArticuloExistenciaDto? valor)
    {
        articuloSeleccionado = valor;
        modelo.ArticuloId = valor?.Id ?? 0;
    }

    private async Task Guardar()
    {
        try
        {
            await InventarioService.RegistrarSolicitudPrestamoAsync(modelo);
            Snackbar.Add("Solicitud de préstamo registrada correctamente.", Severity.Success);

            modelo = new();
            articuloSeleccionado = null;
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar la solicitud de préstamo. Intentá de nuevo.", Severity.Error);
        }
    }
}
