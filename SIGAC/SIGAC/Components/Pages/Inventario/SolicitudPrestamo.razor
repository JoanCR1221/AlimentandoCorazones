@page "/inventario/prestamos/solicitar"
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Interfaces
@inject IInventarioService InventarioService

<MudText Typo="Typo.h4" Class="mb-4">Solicitar préstamo de artículo</MudText>

<MudCard Class="pa-4">
    <MudCardContent>
        <MudAutocomplete T="ArticuloExistenciaDto" Label="Artículo" Variant="Variant.Outlined"
                          Value="articuloSeleccionado" ValueChanged="OnArticuloCambiado"
                          SearchFunc="BuscarArticulosAsync"
                          ToStringFunc="@(a => a is null ? null : $"{a.Nombre} (stock: {a.StockActual} {a.UnidadMedida})")" />

        <MudNumericField T="int" @bind-Value="modelo.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Class="mt-4" Min="1" />

        <MudDatePicker @bind-Date="fecha" Label="Fecha de la actividad" Variant="Variant.Outlined" Class="mt-4" />
    </MudCardContent>
</MudCard>

@code {
    private SolicitudPrestamoCrearDto modelo = new();
    private ArticuloExistenciaDto? articuloSeleccionado;

    private DateTime? fecha
    {
        get => modelo.Fecha == default ? null : modelo.Fecha;
        set => modelo.Fecha = value ?? default;
    }

    private async Task<IEnumerable<ArticuloExistenciaDto>> BuscarArticulosAsync(string valor, CancellationToken cancellationToken)
    {
        var resultado = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto { Nombre = valor });
        return resultado.Elementos;
    }

    private void OnArticuloCambiado(ArticuloExistenciaDto? valor)
    {
        articuloSeleccionado = valor;
        modelo.ArticuloId = valor?.Id ?? 0;
    }
}
