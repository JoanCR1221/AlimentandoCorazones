@page "/inventario/prestamos/solicitar"
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IInventarioService InventarioService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Solicitar préstamo de artículo</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            @* MinCharacters="1" evita que al enfocar el campo se despliegue el catálogo
               entero: con el valor por omisión (0) MudBlazor llama a SearchFunc con la
               cadena vacía apenas el campo recibe el foco, y una búsqueda sin texto
               devuelve la primera página completa de artículos.

               DebounceInterval son los mismos 300 ms que ya usan RegistrarEntrada y el
               buscador de ExistenciasInventario.

               El HelperText explica por qué un alimento o una prenda no aparecen en la
               lista: sin ese aviso, buscar "Arroz" y no obtener nada parece una falla. *@
            <MudAutocomplete T="ArticuloExistenciaDto" Label="Artículo" Variant="Variant.Outlined"
                              Value="articuloSeleccionado" ValueChanged="OnArticuloCambiado"
                              SearchFunc="BuscarArticulosAsync"
                              MinCharacters="1" DebounceInterval="300"
                              HelperText="@($"Escribí para buscar. Solo se prestan artículos de categoría {CategoriasArticulo.Equipo}.")"
                              ToStringFunc="@(a => a is null ? null : $"{a.Nombre} (stock: {a.StockActual} {a.UnidadMedida})")" />

            <MudNumericField T="int" @bind-Value="modelo.Cantidad" For="@(() => modelo.Cantidad)" Label="Cantidad" Variant="Variant.Outlined" Class="mt-4" Min="1" />

            <MudDatePicker @bind-Date="fecha" Label="Fecha de la actividad" Variant="Variant.Outlined" Class="mt-4" />

            <MudTextField @bind-Value="modelo.Actividad" For="@(() => modelo.Actividad)" Label="Actividad" Variant="Variant.Outlined" Class="mt-4" />

            <MudTextField @bind-Value="modelo.Solicitante" For="@(() => modelo.Solicitante)" Label="Solicitante" Variant="Variant.Outlined" Class="mt-4" />
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Solicitar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    private SolicitudPrestamoCrearDto modelo = new();
    private ArticuloExistenciaDto? articuloSeleccionado;

    private DateTime? fecha
    {
        get => modelo.Fecha == default ? null : modelo.Fecha;
        set => modelo.Fecha = value ?? default;
    }

    private async Task<IEnumerable<ArticuloExistenciaDto>> BuscarArticulosAsync(string valor, CancellationToken cancellationToken)
    {
        // Guarda explícita, además del MinCharacters del componente: una búsqueda sin
        // texto NO significa "todos los artículos" acá. El repositorio ignora el filtro
        // de nombre cuando llega vacío y devolvería la primera página del catálogo.
        if (string.IsNullOrWhiteSpace(valor))
            return Array.Empty<ArticuloExistenciaDto>();

        // La categoría va fija en Equipo: solo se presta mobiliario, equipo de cocina
        // y herramientas. Los alimentos, la ropa y el calzado se entregan de forma
        // definitiva, no se devuelven, así que no tiene sentido ofrecerlos acá.
        //
        // Se filtra en el servicio y no en memoria sobre el resultado porque
        // FiltrosExistenciaDto ya admite la categoría y el repositorio la resuelve en
        // SQL con el índice IX_Articulos_Categoria. Descartar en memoria además
        // rompería con la paginación: el filtro se aplicaría después de recortar la
        // página, y un Equipo que quedara fuera de los primeros resultados no
        // aparecería nunca.
        var resultado = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto
        {
            Nombre = valor,
            Categoria = CategoriasArticulo.Equipo
        });

        return resultado.Elementos;
    }

    private void OnArticuloCambiado(ArticuloExistenciaDto? valor)
    {
        articuloSeleccionado = valor;
        modelo.ArticuloId = valor?.Id ?? 0;
    }

    private async Task Guardar()
    {
        try
        {
            await InventarioService.RegistrarSolicitudPrestamoAsync(modelo);
            Snackbar.Add("Solicitud de préstamo registrada correctamente.", Severity.Success);

            modelo = new();
            articuloSeleccionado = null;
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar la solicitud de préstamo. Intentá de nuevo.", Severity.Error);
        }
    }
}
