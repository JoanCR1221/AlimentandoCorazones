@page "/reportes/inventario/panorama"
@attribute [Authorize(Policy = Permisos.Reportes.VerInventario)]
@using MudBlazor.Charts
@using SIGAC.Application.DTOs.Reportes
@using SIGAC.Application.Interfaces
@inject IReportesService ReportesService

<EncabezadoPagina Titulo="Panorama de inventario"
                  Descripcion="Vea qué entra y qué sale del inventario, de dónde viene y cómo ha evolucionado en los últimos 12 meses." />

@* Mismas tarjetas que encabezan /inventario/existencias: es el mismo componente,
   que carga lo suyo. *@
<ResumenInventario />

<MudCard Class="pa-4">
    <MudCardContent>
        @if (cargando)
        {
            <CargandoGrilla />
        }
        else if (error)
        {
            <EstadoVacio Icono="@Icons.Material.Filled.ErrorOutline"
                         Titulo="No se pudo cargar el panorama de inventario"
                         Descripcion="Intente de nuevo en unos momentos." />
        }
        else if (NoHayMovimientos)
        {
            <EstadoVacio Icono="@Icons.Material.Filled.SwapHoriz"
                         Titulo="No hay movimientos en los últimos 12 meses"
                         Descripcion="Las gráficas se llenan a medida que se registran entradas, donaciones y préstamos." />
        }
        else
        {
            @* Mismo patrón de los otros panoramas: un desplegable en vez de un
               listado fijo, y un solo gráfico a la vez. *@
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="8" md="5">
                    <MudSelect T="Estadistica" Label="Estadística" Variant="Variant.Outlined"
                               Value="_seleccionada" ValueChanged="@(v => _seleccionada = v)"
                               ToStringFunc="@(e => Opciones.First(o => o.Clave == e).Titulo)"
                               Adornment="Adornment.Start" AdornmentIcon="@IconoSeleccionado"
                               AdornmentColor="Color.Secondary">
                        @foreach (var opcion in Opciones)
                        {
                            <MudSelectItem T="Estadistica" Value="opcion.Clave">
                                <MudIcon Icon="@opcion.Icono" Color="Color.Secondary" Size="Size.Small" Class="mr-2" />
                                @opcion.Titulo
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (_graficas.TryGetValue(_seleccionada, out var grafica))
            {
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">@grafica.Titulo</MudText>
                <MudText Typo="Typo.caption" Class="mb-2 mud-text-secondary d-block">@grafica.Nota</MudText>
                <MudChart T="double" ChartType="grafica.Tipo" ChartSeries="grafica.Series"
                          ChartLabels="grafica.Etiquetas" ChartOptions="grafica.Opciones" Width="100%" Height="350px" />
            }
        }
    </MudCardContent>
</MudCard>

@code {
    private enum Estadistica
    {
        EntradasSalidas,
        PorMes,
        OrigenEntradas,
        TipoSalidas,
        ArticulosConMasMovimientos
    }

    private sealed record OpcionEstadistica(Estadistica Clave, string Titulo, string Icono);

    // Nota: la aclaración que va bajo el título (qué se está midiendo).
    private sealed record GraficaVista(string Titulo, string Nota, ChartType Tipo, List<ChartSeries<double>> Series, string[] Etiquetas, IChartOptions? Opciones = null);

    private const string NotaUnidades = "En unidades, sin contar las entradas anuladas.";

    // Datos como lista, igual que los otros panoramas: agregar una estadística
    // nueva es una entrada más acá.
    private static readonly OpcionEstadistica[] Opciones =
    {
        new(Estadistica.EntradasSalidas, "Unidades que entran y salen", Icons.Material.Filled.DonutLarge),
        new(Estadistica.PorMes, "Entradas y salidas por mes", Icons.Material.Filled.BarChart),
        new(Estadistica.OrigenEntradas, "Origen de las entradas", Icons.Material.Filled.DonutLarge),
        new(Estadistica.TipoSalidas, "Tipo de las salidas", Icons.Material.Filled.DonutLarge),
        new(Estadistica.ArticulosConMasMovimientos, "Artículos con más movimientos", Icons.Material.Filled.BarChart)
    };

    private static readonly string[] MesesAbreviados =
        { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };

    // Debe coincidir con ReportesService.MesesPanoramaPorDefecto.
    private const int MesesPanorama = 12;

    private bool cargando = true;
    private bool error;
    private Estadistica _seleccionada = Estadistica.EntradasSalidas;
    private Dictionary<Estadistica, GraficaVista> _graficas = new();

    private string IconoSeleccionado => Opciones.First(o => o.Clave == _seleccionada).Icono;

    // Sale de las cifras del panorama (unidades, no filas): permite decir "no hay
    // movimientos" sin otra consulta.
    private bool NoHayMovimientos { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var panorama = await ReportesService.ObtenerPanoramaInventarioAsync();
            NoHayMovimientos = panorama is { UnidadesEntradas: 0, UnidadesSalidas: 0 };
            _graficas = ArmarGraficas(panorama);
        }
        catch (Exception)
        {
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private static Dictionary<Estadistica, GraficaVista> ArmarGraficas(PanoramaInventarioDto datos)
    {
        // Los datos por mes solo traen los meses con al menos un movimiento: se
        // alinean contra una ventana calendario completa para que un mes sin
        // movimientos se vea como cero y no corra las etiquetas del eje X. Mismo
        // criterio que los otros panoramas.
        var ventana = VentanaMeses();
        var etiquetasMeses = ventana.Select(m => EtiquetaMes(m.Anio, m.Mes)).ToArray();

        var entradasPorMes = AlinearPorMes(ventana, datos.EntradasPorMes);
        var salidasPorMes = AlinearPorMes(ventana, datos.SalidasPorMes);

        return new Dictionary<Estadistica, GraficaVista>
        {
            [Estadistica.EntradasSalidas] = new(
                "Unidades que entran y salen",
                NotaUnidades,
                ChartType.Donut,
                new() { new() { Name = "Unidades", Data = new double[] { datos.UnidadesEntradas, datos.UnidadesSalidas } } },
                new[] { "Entradas", "Salidas" }),

            [Estadistica.PorMes] = new(
                "Entradas y salidas por mes",
                NotaUnidades,
                ChartType.Bar,
                new()
                {
                    new() { Name = "Entradas", Data = entradasPorMes },
                    new() { Name = "Salidas", Data = salidasPorMes }
                },
                etiquetasMeses,
                // Unidades: el máximo puede pasar de 100 y entonces el paso por
                // defecto (20) ya es razonable; con pocas unidades se ajusta.
                new BarChartOptions { YAxisTicks = OpcionesGrafica.PasoDeConteo(entradasPorMes.Concat(salidasPorMes).Max()) }),

            [Estadistica.OrigenEntradas] = new(
                "Origen de las entradas",
                NotaUnidades,
                ChartType.Donut,
                new() { new() { Name = "Unidades", Data = new double[] { datos.EntradasPorCompra, datos.EntradasPorDonacion } } },
                new[] { "Compras", "Donaciones" }),

            [Estadistica.TipoSalidas] = new(
                "Tipo de las salidas",
                NotaUnidades,
                ChartType.Donut,
                new() { new() { Name = "Unidades", Data = new double[] { datos.SalidasPorDonacion, datos.SalidasPorPrestamo } } },
                new[] { "Donaciones", "Préstamos" }),

            [Estadistica.ArticulosConMasMovimientos] = new(
                "Artículos con más movimientos",
                "Cantidad de movimientos (entradas y salidas), no de unidades: los artículos se miden distinto.",
                ChartType.Bar,
                new() { new() { Name = "Movimientos", Data = datos.ArticulosConMasMovimientos.Select(a => (double)a.Movimientos).ToArray() } },
                datos.ArticulosConMasMovimientos.Select(a => a.Articulo).ToArray(),
                // Nombre de artículo inclinado, por lo mismo que los proveedores en el
                // panorama de gastos. Los valores son conteos chicos.
                new BarChartOptions
                {
                    XAxisLabelRotation = 45,
                    MaxNumYAxisTicks = 6,
                    YAxisTicks = OpcionesGrafica.PasoDeConteo(datos.ArticulosConMasMovimientos.Select(a => (double)a.Movimientos).DefaultIfEmpty(0).Max())
                })
        };
    }

    // Los MesesPanorama meses calendario hasta el actual, contándolo como el
    // primero. Mismo criterio que los otros panoramas y ReportesService.
    private static List<(int Anio, int Mes)> VentanaMeses()
    {
        var inicio = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-(MesesPanorama - 1));

        return Enumerable.Range(0, MesesPanorama)
            .Select(inicio.AddMonths)
            .Select(f => (f.Year, f.Month))
            .ToList();
    }

    private static double[] AlinearPorMes(List<(int Anio, int Mes)> ventana, IReadOnlyList<ConteoPorMesDto> datos)
    {
        var porMes = datos.ToDictionary(c => (c.Anio, c.Mes), c => (double)c.Cantidad);
        return ventana.Select(m => porMes.TryGetValue(m, out var cantidad) ? cantidad : 0.0).ToArray();
    }

    private static string EtiquetaMes(int anio, int mes) => $"{MesesAbreviados[mes - 1]} {anio}";
}
