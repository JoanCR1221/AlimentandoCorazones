@page "/reportes/donaciones/panorama"
@attribute [Authorize(Policy = Permisos.Reportes.VerDonaciones)]
@using MudBlazor.Charts
@using SIGAC.Application.DTOs.Reportes
@using SIGAC.Application.Interfaces
@inject IReportesService ReportesService

<EncabezadoPagina Titulo="Panorama de donaciones"
                  Descripcion="Vea qué se recibe, de quién y cómo ha evolucionado en los últimos 12 meses." />

@* Mismas tarjetas que encabezan /donaciones/historial: es el mismo componente,
   que carga lo suyo. *@
<ResumenDonaciones />

<MudCard Class="pa-4">
    <MudCardContent>
        @if (cargando)
        {
            <CargandoGrilla />
        }
        else if (error)
        {
            <EstadoVacio Icono="@Icons.Material.Filled.ErrorOutline"
                         Titulo="No se pudo cargar el panorama de donaciones"
                         Descripcion="Intente de nuevo en unos momentos." />
        }
        else if (NoHayDonaciones)
        {
            <EstadoVacio Icono="@Icons.Material.Filled.VolunteerActivism"
                         Titulo="No hay donaciones en los últimos 12 meses"
                         Descripcion="Las gráficas se llenan a medida que se registran donaciones." />
        }
        else
        {
            @* Mismo patrón de PanoramaBeneficiarios y PanoramaGastos: un desplegable
               en vez de un listado fijo, y un solo gráfico a la vez. *@
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="8" md="5">
                    <MudSelect T="Estadistica" Label="Estadística" Variant="Variant.Outlined"
                               Value="_seleccionada" ValueChanged="@(v => _seleccionada = v)"
                               ToStringFunc="@(e => Opciones.First(o => o.Clave == e).Titulo)"
                               Adornment="Adornment.Start" AdornmentIcon="@IconoSeleccionado"
                               AdornmentColor="Color.Secondary">
                        @foreach (var opcion in Opciones)
                        {
                            <MudSelectItem T="Estadistica" Value="opcion.Clave">
                                <MudIcon Icon="@opcion.Icono" Color="Color.Secondary" Size="Size.Small" Class="mr-2" />
                                @opcion.Titulo
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (_graficas.TryGetValue(_seleccionada, out var grafica))
            {
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">@grafica.Titulo</MudText>
                @if (grafica.SoloColones)
                {
                    <MudText Typo="Typo.caption" Class="mb-2 mud-text-secondary d-block">
                        Solo donaciones en dinero en colones: no se pueden sumar montos de monedas distintas.
                    </MudText>
                }
                <MudChart T="double" ChartType="grafica.Tipo" ChartSeries="grafica.Series"
                          ChartLabels="grafica.Etiquetas" ChartOptions="grafica.Opciones" Width="100%" Height="350px" />
            }
        }
    </MudCardContent>
</MudCard>

@code {
    private enum Estadistica
    {
        PorClase,
        TendenciaDinero,
        CantidadPorMes,
        TopDonantes,
        DonantesActivos
    }

    private sealed record OpcionEstadistica(Estadistica Clave, string Titulo, string Icono);

    private sealed record GraficaVista(string Titulo, ChartType Tipo, List<ChartSeries<double>> Series, string[] Etiquetas, bool SoloColones, IChartOptions? Opciones = null);

    // Datos como lista, igual que los otros panoramas: agregar una estadística
    // nueva es una entrada más acá.
    private static readonly OpcionEstadistica[] Opciones =
    {
        new(Estadistica.PorClase, "Donaciones en dinero y en especie", Icons.Material.Filled.DonutLarge),
        new(Estadistica.TendenciaDinero, "Tendencia del dinero recibido", Icons.Material.Filled.ShowChart),
        new(Estadistica.CantidadPorMes, "Cantidad de donaciones por mes", Icons.Material.Filled.BarChart),
        new(Estadistica.TopDonantes, "Donantes con más donaciones", Icons.Material.Filled.BarChart),
        new(Estadistica.DonantesActivos, "Donantes activos vs. inactivos", Icons.Material.Filled.DonutLarge)
    };

    private static readonly string[] MesesAbreviados =
        { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };

    // Debe coincidir con ReportesService.MesesPanoramaPorDefecto.
    private const int MesesPanorama = 12;

    private bool cargando = true;
    private bool error;
    private Estadistica _seleccionada = Estadistica.PorClase;
    private Dictionary<Estadistica, GraficaVista> _graficas = new();

    private string IconoSeleccionado => Opciones.First(o => o.Clave == _seleccionada).Icono;

    // Sale de las cifras del panorama (conteos, no filas): permite decir
    // "no hay donaciones" sin otra consulta.
    private bool NoHayDonaciones { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var panorama = await ReportesService.ObtenerPanoramaDonacionesAsync();
            NoHayDonaciones = panorama is { CantidadDinero: 0, CantidadEspecie: 0 };
            _graficas = ArmarGraficas(panorama);
        }
        catch (Exception)
        {
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private static Dictionary<Estadistica, GraficaVista> ArmarGraficas(PanoramaDonacionesDto datos)
    {
        // Los datos por mes solo traen los meses con al menos una donación: se
        // alinean contra una ventana calendario completa para que un mes sin
        // donaciones se vea como cero y no corra las etiquetas del eje X. Mismo
        // criterio que los otros panoramas.
        var ventana = VentanaMeses();
        var etiquetasMeses = ventana.Select(m => EtiquetaMes(m.Anio, m.Mes)).ToArray();

        var dineroPorMes = AlinearPorMes(ventana, datos.DonacionesPorMes, "Dinero");
        var especiePorMes = AlinearPorMes(ventana, datos.DonacionesPorMes, "Especie");

        return new Dictionary<Estadistica, GraficaVista>
        {
            [Estadistica.PorClase] = new(
                "Donaciones en dinero y en especie",
                ChartType.Donut,
                new() { new() { Name = "Donaciones", Data = new double[] { datos.CantidadDinero, datos.CantidadEspecie } } },
                new[] { "En dinero", "En especie" },
                SoloColones: false),

            [Estadistica.TendenciaDinero] = new(
                "Tendencia del dinero recibido",
                ChartType.Line,
                new() { new() { Name = "Dinero recibido", Data = AlinearMontoPorMes(ventana, datos.DineroEnColonesPorMes) } },
                etiquetasMeses,
                SoloColones: true),

            [Estadistica.CantidadPorMes] = new(
                "Cantidad de donaciones por mes",
                ChartType.Bar,
                new()
                {
                    new() { Name = "En dinero", Data = dineroPorMes },
                    new() { Name = "En especie", Data = especiePorMes }
                },
                etiquetasMeses,
                SoloColones: false,
                Opciones: new BarChartOptions { YAxisTicks = PasoDeConteo(dineroPorMes.Concat(especiePorMes).Max()) }),

            [Estadistica.TopDonantes] = new(
                "Donantes con más donaciones",
                ChartType.Bar,
                new() { new() { Name = "Donaciones", Data = datos.TopDonantes.Select(d => (double)d.Cantidad).ToArray() } },
                datos.TopDonantes.Select(d => d.Donante).ToArray(),
                SoloColones: false,
                // Nombre de donante inclinado, por lo mismo que los proveedores en el
                // panorama de gastos: un nombre largo se montaría sobre el de al lado.
                // Los valores son conteos chicos, así que se limitan los ticks del eje Y.
                Opciones: new BarChartOptions
                {
                    XAxisLabelRotation = 45,
                    MaxNumYAxisTicks = 6,
                    YAxisTicks = PasoDeConteo(datos.TopDonantes.Select(d => (double)d.Cantidad).DefaultIfEmpty(0).Max())
                }),

            [Estadistica.DonantesActivos] = new(
                "Donantes activos vs. inactivos",
                ChartType.Donut,
                new() { new() { Name = "Donantes", Data = new double[] { datos.DonantesActivos, datos.DonantesInactivos } } },
                new[] { "Activos", "Inactivos" },
                SoloColones: false)
        };
    }

    // MudChart arma el eje Y en pasos de YAxisTicks, 20 por defecto (pensado para
    // montos): con conteos de uno o dos dígitos el eje iba de 0 a 20 y las barras
    // quedaban aplastadas abajo. Se elige un paso chico según el valor máximo,
    // para que el eje tenga unas siete marcas como mucho.
    private static int PasoDeConteo(double maximo) => maximo switch
    {
        <= 6 => 1,
        <= 12 => 2,
        <= 30 => 5,
        <= 60 => 10,
        _ => 20
    };

    // Los MesesPanorama meses calendario hasta el actual, contándolo como el
    // primero. Mismo criterio que los otros panoramas y ReportesService.
    private static List<(int Anio, int Mes)> VentanaMeses()
    {
        var inicio = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-(MesesPanorama - 1));

        return Enumerable.Range(0, MesesPanorama)
            .Select(inicio.AddMonths)
            .Select(f => (f.Year, f.Month))
            .ToList();
    }

    private static double[] AlinearPorMes(List<(int Anio, int Mes)> ventana, IReadOnlyList<ConteoDonacionMensualDto> datos, string tipoDonacion)
    {
        var porMes = datos
            .Where(c => c.TipoDonacion == tipoDonacion)
            .ToDictionary(c => (c.Anio, c.Mes), c => (double)c.Cantidad);

        return ventana.Select(m => porMes.TryGetValue(m, out var cantidad) ? cantidad : 0.0).ToArray();
    }

    private static double[] AlinearMontoPorMes(List<(int Anio, int Mes)> ventana, IReadOnlyList<MontoPorMesDto> datos)
    {
        var porMes = datos.ToDictionary(c => (c.Anio, c.Mes), c => (double)c.Monto);
        return ventana.Select(m => porMes.TryGetValue(m, out var monto) ? monto : 0.0).ToArray();
    }

    private static string EtiquetaMes(int anio, int mes) => $"{MesesAbreviados[mes - 1]} {anio}";
}
