@page "/reportes/alquileres/panorama"
@attribute [Authorize(Policy = Permisos.Reportes.VerAlquileres)]
@using MudBlazor.Charts
@using SIGAC.Application.DTOs.Reportes
@using SIGAC.Application.Interfaces
@inject IReportesService ReportesService

<EncabezadoPagina Titulo="Panorama de alquileres de espacios"
                  Descripcion="Vea cuánto se usa el local, qué sectores se alquilan más y cómo han evolucionado los ingresos en los últimos 12 meses." />

<MudCard Class="pa-4">
    <MudCardContent>
        @if (cargando)
        {
            <CargandoGrilla />
        }
        else if (error)
        {
            <EstadoVacio Icono="@Icons.Material.Filled.ErrorOutline"
                         Titulo="No se pudo cargar el panorama de alquileres"
                         Descripcion="Intente de nuevo en unos momentos." />
        }
        else if (NoHayAlquileres)
        {
            <EstadoVacio Icono="@Icons.Material.Filled.EventAvailable"
                         Titulo="No hay alquileres en los últimos 12 meses"
                         Descripcion="Las gráficas se llenan a medida que se registran alquileres." />
        }
        else
        {
            @* Solo reservados: un alquiler cancelado no ocupa el local ni genera
               ingreso. El ingreso va solo en colones, porque no se pueden sumar
               monedas distintas. *@
            <section class="ac-kpis mb-4" aria-label="Resumen de los últimos 12 meses">
                <TarjetaResumen Titulo="Alquileres reservados"
                                Valor="@TextoResumen.Numero(_panorama.CantidadReservados)"
                                Detalle="@TextoResumen.Cantidad(_panorama.CantidadCancelados, "cancelado", "cancelados")"
                                Icono="@Icons.Material.Filled.EventAvailable" />
                <TarjetaResumen Titulo="Horas alquiladas"
                                Valor="@TextoResumen.Horas(_panorama.HorasAlquiladas)"
                                Icono="@Icons.Material.Filled.Schedule" />
                <TarjetaResumen Titulo="Ingresos en colones"
                                Valor="@TiposMoneda.ConSimbolo(TiposMoneda.Colones, _panorama.IngresosEnColones)"
                                Detalle="Solo alquileres reservados"
                                Icono="@Icons.Material.Filled.Payments" />
            </section>

            @* Mismo patrón de los otros panoramas: un desplegable en vez de un
               listado fijo, y un solo gráfico a la vez. *@
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="8" md="5">
                    <MudSelect T="Estadistica" Label="Estadística" Variant="Variant.Outlined"
                               Value="_seleccionada" ValueChanged="@(v => _seleccionada = v)"
                               ToStringFunc="@(e => Opciones.First(o => o.Clave == e).Titulo)"
                               Adornment="Adornment.Start" AdornmentIcon="@IconoSeleccionado"
                               AdornmentColor="Color.Secondary">
                        @foreach (var opcion in Opciones)
                        {
                            <MudSelectItem T="Estadistica" Value="opcion.Clave">
                                <MudIcon Icon="@opcion.Icono" Color="Color.Secondary" Size="Size.Small" Class="mr-2" />
                                @opcion.Titulo
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (_graficas.TryGetValue(_seleccionada, out var grafica))
            {
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">@grafica.Titulo</MudText>
                @if (grafica.SoloColones)
                {
                    <MudText Typo="Typo.caption" Class="mb-2 mud-text-secondary d-block">
                        Solo alquileres en colones: no se pueden sumar montos de monedas distintas.
                    </MudText>
                }
                <MudChart T="double" ChartType="grafica.Tipo" ChartSeries="grafica.Series"
                          ChartLabels="grafica.Etiquetas" ChartOptions="grafica.Opciones" Width="100%" Height="350px" />
            }
        }
    </MudCardContent>
</MudCard>

@code {
    private enum Estadistica
    {
        ReservadosCancelados,
        TendenciaIngresos,
        AlquileresPorMes,
        HorasPorMes,
        PorSector,
        DiaDeLaSemana
    }

    private sealed record OpcionEstadistica(Estadistica Clave, string Titulo, string Icono);

    private sealed record GraficaVista(string Titulo, ChartType Tipo, List<ChartSeries<double>> Series, string[] Etiquetas, bool SoloColones, IChartOptions? Opciones = null);

    // Datos como lista, igual que los otros panoramas: agregar una estadística
    // nueva es una entrada más acá.
    private static readonly OpcionEstadistica[] Opciones =
    {
        new(Estadistica.ReservadosCancelados, "Alquileres reservados y cancelados", Icons.Material.Filled.DonutLarge),
        new(Estadistica.TendenciaIngresos, "Tendencia de los ingresos", Icons.Material.Filled.ShowChart),
        new(Estadistica.AlquileresPorMes, "Cantidad de alquileres por mes", Icons.Material.Filled.BarChart),
        new(Estadistica.HorasPorMes, "Horas alquiladas por mes", Icons.Material.Filled.BarChart),
        new(Estadistica.PorSector, "Sectores más alquilados", Icons.Material.Filled.BarChart),
        new(Estadistica.DiaDeLaSemana, "Entre semana y fin de semana", Icons.Material.Filled.DonutLarge)
    };

    private static readonly string[] MesesAbreviados =
        { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };

    // Debe coincidir con ReportesService.MesesPanoramaPorDefecto.
    private const int MesesPanorama = 12;

    private bool cargando = true;
    private bool error;
    private Estadistica _seleccionada = Estadistica.ReservadosCancelados;
    private PanoramaAlquileresDto _panorama = new();
    private Dictionary<Estadistica, GraficaVista> _graficas = new();

    private string IconoSeleccionado => Opciones.First(o => o.Clave == _seleccionada).Icono;

    // Sale de las cifras del panorama (conteos, no filas): permite decir
    // "no hay alquileres" sin otra consulta.
    private bool NoHayAlquileres => _panorama is { CantidadReservados: 0, CantidadCancelados: 0 };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _panorama = await ReportesService.ObtenerPanoramaAlquileresAsync();
            _graficas = ArmarGraficas(_panorama);
        }
        catch (Exception)
        {
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private static Dictionary<Estadistica, GraficaVista> ArmarGraficas(PanoramaAlquileresDto datos)
    {
        // Los datos por mes solo traen los meses con al menos un alquiler: se
        // alinean contra una ventana calendario completa para que un mes sin
        // alquileres se vea como cero y no corra las etiquetas del eje X. Mismo
        // criterio que los otros panoramas.
        var ventana = VentanaMeses();
        var etiquetasMeses = ventana.Select(m => EtiquetaMes(m.Anio, m.Mes)).ToArray();

        var reservadosPorMes = AlinearPorMes(ventana, datos.ReservadosPorMes.Select(c => (c.Anio, c.Mes, (double)c.Cantidad)));
        var canceladosPorMes = AlinearPorMes(ventana, datos.CanceladosPorMes.Select(c => (c.Anio, c.Mes, (double)c.Cantidad)));
        var horasPorMes = AlinearPorMes(ventana, datos.HorasPorMes.Select(h => (h.Anio, h.Mes, (double)h.Horas)));

        return new Dictionary<Estadistica, GraficaVista>
        {
            [Estadistica.ReservadosCancelados] = new(
                "Alquileres reservados y cancelados",
                ChartType.Donut,
                new() { new() { Name = "Alquileres", Data = new double[] { datos.CantidadReservados, datos.CantidadCancelados } } },
                new[] { "Reservados", "Cancelados" },
                SoloColones: false),

            [Estadistica.TendenciaIngresos] = new(
                "Tendencia de los ingresos",
                ChartType.Line,
                new()
                {
                    new()
                    {
                        Name = "Ingresos",
                        Data = AlinearPorMes(ventana, datos.IngresosEnColonesPorMes.Select(m => (m.Anio, m.Mes, (double)m.Monto)))
                    }
                },
                etiquetasMeses,
                SoloColones: true),

            [Estadistica.AlquileresPorMes] = new(
                "Cantidad de alquileres por mes",
                ChartType.Bar,
                new()
                {
                    new() { Name = "Reservados", Data = reservadosPorMes },
                    new() { Name = "Cancelados", Data = canceladosPorMes }
                },
                etiquetasMeses,
                SoloColones: false,
                Opciones: new BarChartOptions { YAxisTicks = OpcionesGrafica.PasoDeConteo(reservadosPorMes.Concat(canceladosPorMes).Max()) }),

            [Estadistica.HorasPorMes] = new(
                "Horas alquiladas por mes",
                ChartType.Bar,
                new() { new() { Name = "Horas", Data = horasPorMes } },
                etiquetasMeses,
                SoloColones: false,
                Opciones: new BarChartOptions { YAxisTicks = OpcionesGrafica.PasoDeConteo(horasPorMes.Max()) }),

            [Estadistica.PorSector] = new(
                "Sectores más alquilados",
                ChartType.Bar,
                new() { new() { Name = "Alquileres", Data = datos.AlquileresPorSector.Select(s => (double)s.Cantidad).ToArray() } },
                datos.AlquileresPorSector.Select(s => s.Sector).ToArray(),
                SoloColones: false,
                // Nombre de sector inclinado, por lo mismo que los proveedores en el
                // panorama de gastos: "Cocina (solo para servir)" se montaría sobre el
                // de al lado. Los valores son conteos chicos.
                Opciones: new BarChartOptions
                {
                    XAxisLabelRotation = 45,
                    MaxNumYAxisTicks = 6,
                    YAxisTicks = OpcionesGrafica.PasoDeConteo(datos.AlquileresPorSector.Select(s => (double)s.Cantidad).DefaultIfEmpty(0).Max())
                }),

            [Estadistica.DiaDeLaSemana] = new(
                "Entre semana y fin de semana",
                ChartType.Donut,
                new() { new() { Name = "Alquileres", Data = new double[] { datos.ReservadosEntreSemana, datos.ReservadosFinDeSemana } } },
                new[] { "Entre semana", "Fin de semana" },
                SoloColones: false)
        };
    }

    // Los MesesPanorama meses calendario hasta el actual, contándolo como el
    // primero. Mismo criterio que los otros panoramas y ReportesService.
    private static List<(int Anio, int Mes)> VentanaMeses()
    {
        var inicio = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-(MesesPanorama - 1));

        return Enumerable.Range(0, MesesPanorama)
            .Select(inicio.AddMonths)
            .Select(f => (f.Year, f.Month))
            .ToList();
    }

    private static double[] AlinearPorMes(List<(int Anio, int Mes)> ventana, IEnumerable<(int Anio, int Mes, double Valor)> datos)
    {
        var porMes = datos.ToDictionary(d => (d.Anio, d.Mes), d => d.Valor);
        return ventana.Select(m => porMes.TryGetValue(m, out var valor) ? valor : 0.0).ToArray();
    }

    private static string EtiquetaMes(int anio, int mes) => $"{MesesAbreviados[mes - 1]} {anio}";
}
