@page "/reportes/proyectos/panorama"
@attribute [Authorize(Policy = Permisos.Reportes.VerProyectos)]
@using MudBlazor.Charts
@using SIGAC.Application.DTOs.Reportes
@using SIGAC.Application.Interfaces
@inject IReportesService ReportesService

<EncabezadoPagina Titulo="Panorama de proyectos comunitarios"
                  Descripcion="Vea cuántos proyectos hay, en qué estado están y a cuántas personas llegan." />

@* Mismas tarjetas que encabezan /proyectos: es el mismo componente, que carga lo suyo. *@
<ResumenProyectos />

<MudCard Class="pa-4">
    <MudCardContent>
        @if (cargando)
        {
            <CargandoGrilla />
        }
        else if (error)
        {
            <EstadoVacio Icono="@Icons.Material.Filled.ErrorOutline"
                         Titulo="No se pudo cargar el panorama de proyectos"
                         Descripcion="Intente de nuevo en unos momentos." />
        }
        else if (NoHayProyectos)
        {
            <EstadoVacio Icono="@Icons.Material.Filled.Groups"
                         Titulo="Todavía no hay proyectos registrados"
                         Descripcion="Las gráficas se llenan a medida que se registran proyectos comunitarios." />
        }
        else
        {
            @* Mismo patrón de los otros panoramas: un desplegable en vez de un
               listado fijo, y un solo gráfico a la vez. *@
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="8" md="5">
                    <MudSelect T="Estadistica" Label="Estadística" Variant="Variant.Outlined"
                               Value="_seleccionada" ValueChanged="@(v => _seleccionada = v)"
                               ToStringFunc="@(e => Opciones.First(o => o.Clave == e).Titulo)"
                               Adornment="Adornment.Start" AdornmentIcon="@IconoSeleccionado"
                               AdornmentColor="Color.Secondary">
                        @foreach (var opcion in Opciones)
                        {
                            <MudSelectItem T="Estadistica" Value="opcion.Clave">
                                <MudIcon Icon="@opcion.Icono" Color="Color.Secondary" Size="Size.Small" Class="mr-2" />
                                @opcion.Titulo
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (_graficas.TryGetValue(_seleccionada, out var grafica))
            {
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">@grafica.Titulo</MudText>
                <MudText Typo="Typo.caption" Class="mb-2 mud-text-secondary d-block">@grafica.Nota</MudText>
                <MudChart T="double" ChartType="grafica.Tipo" ChartSeries="grafica.Series"
                          ChartLabels="grafica.Etiquetas" ChartOptions="grafica.Opciones" Width="100%" Height="350px" />
            }
        }
    </MudCardContent>
</MudCard>

@code {
    private enum Estadistica
    {
        PorEstado,
        IniciadosPorMes,
        TipoParticipantes,
        ParticipantesPorMes,
        ConMasParticipantes
    }

    private sealed record OpcionEstadistica(Estadistica Clave, string Titulo, string Icono);

    // Nota: la aclaración que va bajo el título (qué proyectos se están midiendo).
    private sealed record GraficaVista(string Titulo, string Nota, ChartType Tipo, List<ChartSeries<double>> Series, string[] Etiquetas, IChartOptions? Opciones = null);

    private const string NotaTodos = "De todos los proyectos registrados.";
    private const string NotaMeses = "Últimos 12 meses.";

    // Datos como lista, igual que los otros panoramas: agregar una estadística
    // nueva es una entrada más acá.
    private static readonly OpcionEstadistica[] Opciones =
    {
        new(Estadistica.PorEstado, "Proyectos por estado", Icons.Material.Filled.DonutLarge),
        new(Estadistica.IniciadosPorMes, "Proyectos iniciados por mes", Icons.Material.Filled.BarChart),
        new(Estadistica.TipoParticipantes, "Beneficiarios y externos", Icons.Material.Filled.DonutLarge),
        new(Estadistica.ParticipantesPorMes, "Participantes registrados por mes", Icons.Material.Filled.BarChart),
        new(Estadistica.ConMasParticipantes, "Proyectos con más participantes", Icons.Material.Filled.BarChart)
    };

    private static readonly string[] MesesAbreviados =
        { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };

    // Debe coincidir con ReportesService.MesesPanoramaPorDefecto.
    private const int MesesPanorama = 12;

    private bool cargando = true;
    private bool error;
    private Estadistica _seleccionada = Estadistica.PorEstado;
    private Dictionary<Estadistica, GraficaVista> _graficas = new();

    private string IconoSeleccionado => Opciones.First(o => o.Clave == _seleccionada).Icono;

    // Sale de las cifras del panorama (conteos, no filas): permite decir "todavía no
    // hay proyectos" sin otra consulta.
    private bool NoHayProyectos { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var panorama = await ReportesService.ObtenerPanoramaProyectosAsync();
            NoHayProyectos = panorama.TotalProyectos == 0;
            _graficas = ArmarGraficas(panorama);
        }
        catch (Exception)
        {
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private static Dictionary<Estadistica, GraficaVista> ArmarGraficas(PanoramaProyectosDto datos)
    {
        // Los datos por mes solo traen los meses con al menos un registro: se alinean
        // contra una ventana calendario completa para que un mes sin proyectos se vea
        // como cero y no corra las etiquetas del eje X. Mismo criterio que los otros
        // panoramas.
        var ventana = VentanaMeses();
        var etiquetasMeses = ventana.Select(m => EtiquetaMes(m.Anio, m.Mes)).ToArray();

        var iniciadosPorMes = AlinearPorMes(ventana, datos.ProyectosIniciadosPorMes);
        var participantesPorMes = AlinearPorMes(ventana, datos.ParticipantesRegistradosPorMes);

        return new Dictionary<Estadistica, GraficaVista>
        {
            [Estadistica.PorEstado] = new(
                "Proyectos por estado",
                NotaTodos,
                ChartType.Donut,
                new() { new() { Name = "Proyectos", Data = new double[] { datos.Planificados, datos.EnCurso, datos.Finalizados, datos.Cancelados } } },
                new[] { "Planificados", "En curso", "Finalizados", "Cancelados" }),

            [Estadistica.IniciadosPorMes] = new(
                "Proyectos iniciados por mes",
                NotaMeses + " Por fecha de inicio del proyecto.",
                ChartType.Bar,
                new() { new() { Name = "Proyectos", Data = iniciadosPorMes } },
                etiquetasMeses,
                new BarChartOptions { YAxisTicks = OpcionesGrafica.PasoDeConteo(iniciadosPorMes.Max()) }),

            [Estadistica.TipoParticipantes] = new(
                "Beneficiarios y externos",
                NotaTodos + " Una persona en dos proyectos cuenta dos veces.",
                ChartType.Donut,
                new() { new() { Name = "Participantes", Data = new double[] { datos.ParticipantesBeneficiarios, datos.ParticipantesExternos } } },
                new[] { "Beneficiarios", "Externos" }),

            [Estadistica.ParticipantesPorMes] = new(
                "Participantes registrados por mes",
                NotaMeses + " Por fecha en que se registró la participación.",
                ChartType.Bar,
                new() { new() { Name = "Participantes", Data = participantesPorMes } },
                etiquetasMeses,
                new BarChartOptions { YAxisTicks = OpcionesGrafica.PasoDeConteo(participantesPorMes.Max()) }),

            [Estadistica.ConMasParticipantes] = new(
                "Proyectos con más participantes",
                NotaTodos,
                ChartType.Bar,
                new() { new() { Name = "Participantes", Data = datos.ProyectosConMasParticipantes.Select(p => (double)p.Participantes).ToArray() } },
                datos.ProyectosConMasParticipantes.Select(p => p.Proyecto).ToArray(),
                // Nombre de proyecto inclinado, por lo mismo que los proveedores en el
                // panorama de gastos. Los valores son conteos chicos.
                new BarChartOptions
                {
                    XAxisLabelRotation = 45,
                    MaxNumYAxisTicks = 6,
                    YAxisTicks = OpcionesGrafica.PasoDeConteo(datos.ProyectosConMasParticipantes.Select(p => (double)p.Participantes).DefaultIfEmpty(0).Max())
                })
        };
    }

    // Los MesesPanorama meses calendario hasta el actual, contándolo como el
    // primero. Mismo criterio que los otros panoramas y ReportesService.
    private static List<(int Anio, int Mes)> VentanaMeses()
    {
        var inicio = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-(MesesPanorama - 1));

        return Enumerable.Range(0, MesesPanorama)
            .Select(inicio.AddMonths)
            .Select(f => (f.Year, f.Month))
            .ToList();
    }

    private static double[] AlinearPorMes(List<(int Anio, int Mes)> ventana, IReadOnlyList<ConteoPorMesDto> datos)
    {
        var porMes = datos.ToDictionary(c => (c.Anio, c.Mes), c => (double)c.Cantidad);
        return ventana.Select(m => porMes.TryGetValue(m, out var cantidad) ? cantidad : 0.0).ToArray();
    }

    private static string EtiquetaMes(int anio, int mes) => $"{MesesAbreviados[mes - 1]} {anio}";
}
