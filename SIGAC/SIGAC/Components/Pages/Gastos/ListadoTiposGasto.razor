@page "/gastos/tipos"
@attribute [Authorize(Policy = Permisos.Gastos.AdministrarTipos)]
@using SIGAC.Application.DTOs.Gastos
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject ITiposGastoService TiposGastoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Tipos de gasto — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Tipos de gasto"
                  Descripcion="Tipos con los que se clasifican los gastos operativos. Son los mismos que agrupan el reporte mensual de la contadora.">
    <Acciones>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CrearAsync">Nuevo tipo</MudButton>
    </Acciones>
</EncabezadoPagina>

<MudCard Class="pa-1 pa-sm-4">
    <MudCardContent>
        @* Una sola grilla para los tres tamaños (ver ListadoBeneficiarios): en móvil
           (< 768px) solo se ve la celda "tarjeta"; desde 768px, la tabla con las
           cinco columnas. Reemplaza al Breakpoint Sm, que por debajo de 960 px
           apilaba cada fila con sus etiquetas. *@
        <MudDataGrid T="TipoGastoDto" Items="@tipos" Loading="cargando"
                     Class="ac-grilla-tarjetas" Breakpoint="Breakpoint.None">
            <Columns>
                <PropertyColumn Property="x => x.Nombre" Title="Nombre" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                @* Estos dos encabezados pueden partirse en dos líneas (la regla general
                   de app.css los deja en una): enteros, "Cuenta contable por defecto"
                   y "Genera inventario" pedían ~360 px y la tabla no entraba en
                   768 px. En escritorio hay lugar y siguen en una línea. *@
                <TemplateColumn Title="Genera inventario" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" HeaderStyle="white-space: normal">
                    <CellTemplate>@(context.Item.GeneraInventario ? "Sí" : "No")</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CuentaContablePorDefecto" Title="Cuenta contable por defecto" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" HeaderStyle="white-space: normal" />
                <TemplateColumn Title="Estado" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        <EstadoChip Activo="@context.Item.Activo" />
                    </CellTemplate>
                </TemplateColumn>
                @* nowrap: en escritorio Editar y Desactivar van en una sola línea; en
                   tableta app.css los apila (.ac-acciones-tabla). *@
                <TemplateColumn Title="Acciones" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" CellStyle="white-space: nowrap">
                    <CellTemplate>
                        <div class="ac-acciones-tabla">
                            @Acciones(context.Item, false)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                @* Solo móvil: nombre y estado arriba, si genera inventario y la cuenta
                   contable siempre a la vista (sin "Ver más": no queda nada más que
                   mostrar) y Editar / Desactivar al pie. *@
                <TemplateColumn Title="Tipo de gasto" CellClass="ac-col-tarjeta" HeaderClass="ac-col-tarjeta">
                    <CellTemplate>
                        <TarjetaFila Titulo="@context.Item.Nombre">
                            <Estado>
                                <EstadoChip Activo="@context.Item.Activo" />
                            </Estado>
                            <Lineas>
                                <p class="ac-tarjeta-dato">Genera inventario: @(context.Item.GeneraInventario ? "Sí" : "No")</p>
                                @* Guion y no la línea omitida: la cuenta es opcional, y el
                                   guion dice que este tipo no precarga ninguna en el
                                   formulario de gasto. Así todas las tarjetas traen las
                                   mismas dos líneas. *@
                                <p class="ac-tarjeta-dato">Cuenta contable: @(string.IsNullOrWhiteSpace(context.Item.CuentaContablePorDefecto) ? "—" : context.Item.CuentaContablePorDefecto)</p>
                            </Lineas>
                            <Acciones>
                                @Acciones(context.Item, true)
                            </Acciones>
                        </TarjetaFila>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                <EstadoVacio Icono="@Icons.Material.Filled.Category"
                             Titulo="Todavía no hay tipos de gasto" />
            </NoRecordsContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    // La misma pieza sirve a la tabla (Editar plano, Activar/Desactivar chico) y
    // a la tarjeta de móvil (botones del tamaño normal; los estira app.css).
    private RenderFragment Acciones(TipoGastoDto item, bool tarjeta) => @<text>
        <MudButton Variant="@(tarjeta ? Variant.Outlined : Variant.Text)" Color="Color.Primary" OnClick="@(() => EditarAsync(item))">Editar</MudButton>
        @* Baja lógica y nunca borrado: los gastos registrados apuntan al
           tipo (FK Restrict). Un tipo inactivo sale del desplegable del
           formulario de gastos y sigue mostrándose en los que ya lo usan. *@
        @if (item.Activo)
        {
            <MudButton Variant="Variant.Outlined" Size="@(tarjeta ? Size.Medium : Size.Small)" Color="Color.Error" Class="@(tarjeta ? "ac-btn-inactivar" : "ac-btn-inactivar ml-1")" OnClick="@(() => ConfirmarCambioEstadoAsync(item, false))">Desactivar</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Size="@(tarjeta ? Size.Medium : Size.Small)" Color="Color.Success" Class="@(tarjeta ? "ac-btn-activar" : "ac-btn-activar ml-1")" OnClick="@(() => ConfirmarCambioEstadoAsync(item, true))">Activar</MudButton>
        }
    </text>;

    private IReadOnlyList<TipoGastoDto> tipos = Array.Empty<TipoGastoDto>();
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;

        try
        {
            tipos = await TiposGastoService.ObtenerTodosAsync();
        }
        finally
        {
            cargando = false;
        }
    }

    private Task CrearAsync() =>
        AbrirDialogoAsync("Nuevo tipo de gasto", new TipoGastoGuardarDto(), tipoId: null, "Tipo de gasto registrado.");

    private Task EditarAsync(TipoGastoDto tipo) =>
        AbrirDialogoAsync("Editar tipo de gasto", new TipoGastoGuardarDto
        {
            Nombre = tipo.Nombre,
            GeneraInventario = tipo.GeneraInventario,
            CuentaContablePorDefecto = tipo.CuentaContablePorDefecto
        }, tipo.Id, "Tipo de gasto actualizado.");

    // El diálogo guarda por su cuenta y muestra sus propios errores (ver
    // TipoGastoDialog); acá solo se avisa y se recarga cuando salió bien.
    private async Task AbrirDialogoAsync(string titulo, TipoGastoGuardarDto modelo, int? tipoId, string mensajeExito)
    {
        var parametros = new DialogParameters<TipoGastoDialog>
        {
            { d => d.Modelo, modelo },
            { d => d.TipoId, tipoId }
        };
        // Mismo ancho que el diálogo de anulación de gastos.
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TipoGastoDialog>(titulo, parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado is null || resultado.Canceled)
            return;

        Snackbar.Add(mensajeExito, Severity.Success);
        await CargarAsync();
    }

    private async Task ConfirmarCambioEstadoAsync(TipoGastoDto tipo, bool activar)
    {
        var mensaje = activar
            ? $"¿Seguro que desea activar el tipo '{tipo.Nombre}'? Volverá a aparecer en el formulario de gastos."
            : $"¿Seguro que desea desactivar el tipo '{tipo.Nombre}'? Dejará de aparecer en el formulario de gastos; los gastos ya registrados lo conservan.";

        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Confirmar",
            mensaje,
            yesText: "Confirmar",
            cancelText: "Cancelar");

        if (confirmado != true)
            return;

        try
        {
            if (activar)
                await TiposGastoService.ActivarAsync(tipo.Id);
            else
                await TiposGastoService.DesactivarAsync(tipo.Id);

            Snackbar.Add(activar ? "Tipo de gasto activado." : "Tipo de gasto desactivado.", Severity.Success);
            await CargarAsync();
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo actualizar el estado del tipo de gasto. Intente de nuevo.", Severity.Error);
        }
    }
}
