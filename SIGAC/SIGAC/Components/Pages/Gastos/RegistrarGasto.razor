@page "/gastos/registrar"
@attribute [Authorize(Policy = Permisos.Gastos.Registrar)]
@using SIGAC.Application.DTOs.Gastos
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject IGastosService GastosService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Registrar gasto operativo</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            <CamposGasto Modelo="modelo" Tipos="tipos" />
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Href="/gastos" Class="mb-2">Cancelar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    private GastoOperativoCrearDto modelo = new();
    private IReadOnlyList<TipoGastoDto> tipos = Array.Empty<TipoGastoDto>();

    protected override async Task OnInitializedAsync()
    {
        tipos = await GastosService.ObtenerTiposActivosAsync();
    }

    private async Task Guardar()
    {
        try
        {
            var tipoRegistrado = tipos.FirstOrDefault(t => t.Id == modelo.TipoGastoId);
            var gastoId = await GastosService.RegistrarGastoAsync(modelo);
            Snackbar.Add("Gasto operativo registrado correctamente.", Severity.Success);

            // Un gasto cuyo tipo genera inventario no crea la entrada automáticamente
            // (AB#2501): se ofrece el enlace y la persona completa artículo, cantidad
            // y unidad a mano. Lo decide TipoGasto.GeneraInventario, no el nombre.
            if (tipoRegistrado?.GeneraInventario == true)
            {
                Snackbar.Add(
                    "Este gasto es una compra que ingresa al inventario. ¿Desea registrar la entrada correspondiente?",
                    Severity.Info,
                    config =>
                    {
                        config.Action = "Registrar entrada";
                        config.ActionColor = Color.Primary;
                        config.OnClick = _ =>
                        {
                            NavigationManager.NavigateTo($"/inventario/entradas/registrar?gastoOperativoId={gastoId}");
                            return Task.CompletedTask;
                        };
                    });
            }

            modelo = new();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar el gasto operativo. Intente de nuevo.", Severity.Error);
        }
    }
}
