@page "/gastos/editar/{Id:int}"
@attribute [Authorize(Policy = Permisos.Gastos.Editar)]
@using SIGAC.Application.DTOs.Gastos
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject IGastosService GastosService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Editar gasto operativo</MudText>

@if (modelo is not null)
{
    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudCard Class="pa-4">
            <MudCardContent>
                <CamposGasto Modelo="modelo" Tipos="tipos" />
            </MudCardContent>
            <MudCardActions>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" Href="/gastos" Class="mb-2">Cancelar</MudButton>
            </MudCardActions>
        </MudCard>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private GastoOperativoEditarDto? modelo;
    private IReadOnlyList<TipoGastoDto> tipos = Array.Empty<TipoGastoDto>();
    private bool noExiste;

    protected override async Task OnInitializedAsync()
    {
        var datos = await GastosService.ObtenerParaEditarAsync(Id);
        if (datos is null)
        {
            // No se redirige acá: OnInitializedAsync corre también en el
            // prerender, donde NavigateTo es una redirección HTTP y el aviso se
            // perdía antes de llegar a mostrarse. Se redirige en
            // OnAfterRenderAsync, que solo corre con la página ya interactiva.
            noExiste = true;
            return;
        }

        // El tipo del gasto se incluye aunque se haya desactivado después de
        // registrarlo: si no, el desplegable quedaría vacío.
        tipos = await GastosService.ObtenerTiposActivosAsync(incluirTipoId: datos.TipoGastoId);
        modelo = datos;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && noExiste)
        {
            Snackbar.Add("El gasto operativo no existe.", Severity.Warning);
            NavigationManager.NavigateTo("/gastos");
        }
    }

    private async Task Guardar()
    {
        if (modelo is null)
            return;

        try
        {
            await GastosService.EditarGastoAsync(Id, modelo);
            Snackbar.Add("Gasto operativo actualizado correctamente.", Severity.Success);
            NavigationManager.NavigateTo("/gastos");
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo actualizar el gasto operativo. Intente de nuevo.", Severity.Error);
        }
    }
}
