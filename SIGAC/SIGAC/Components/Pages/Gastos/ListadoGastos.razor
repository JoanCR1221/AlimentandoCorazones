@page "/gastos"
@attribute [Authorize(Policy = Permisos.Gastos.Ver)]
@using SIGAC.Application.DTOs
@using SIGAC.Application.DTOs.Gastos
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@using SIGAC.Domain.Entities
@inject IGastosService GastosService
@inject ITiposGastoService TiposGastoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<EncabezadoPagina Titulo="Gastos operativos"
                  Descripcion="Registre y consulte los gastos operativos de la asociación."
                  TextoAccion="Registrar gasto" HrefAccion="/gastos/registrar"
                  PermisoAccion="@Permisos.Gastos.Registrar" />

<ResumenGastos @ref="resumenGastos" />

@* pa-1 en celular y pa-4 desde sm: el padding de la tarjeta se suma al de
   MudCardContent, y en 375 px los dos juntos se comían casi 100 px de ancho. *@
<MudCard Class="pa-1 pa-sm-4">
    <MudCardContent>
        @* En grilla, mismo criterio que HistorialEntregas: apilados en celular, en
           una sola fila desde md. Antes eran tres filas a todo el ancho también
           en escritorio. *@
        <MudGrid Spacing="3" Class="mb-2">
            <MudItem xs="12" md="5">
                @* Rótulo corto: "Buscar por proveedor o número de factura" no
                   entraba en el ancho de un celular y quedaba cortado. *@
                <MudTextField T="string" Value="filtroTexto" ValueChanged="OnFiltroTextoCambiadoAsync" Immediate="true" DebounceInterval="300"
                              Label="Buscar proveedor o factura" Variant="Variant.Outlined" Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                @* Todos los tipos, también los inactivos: un tipo desactivado ya no se
                   elige al registrar, pero sus gastos viejos siguen existiendo y tienen
                   que poder filtrarse. *@
                <MudSelect T="int?" Value="filtroTipoGastoId" ValueChanged="OnFiltroTipoCambiadoAsync"
                           Label="Tipo de gasto" Variant="Variant.Outlined" Clearable="true"
                           ToStringFunc="@(id => tipos.FirstOrDefault(t => t.Id == id)?.Nombre ?? string.Empty)">
                    @foreach (var tipo in tipos)
                    {
                        <MudSelectItem T="int?" Value="@tipo.Id">@tipo.Nombre@(tipo.Activo ? string.Empty : " (inactivo)")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDateRangePicker DateRange="rangoFechas" DateRangeChanged="OnRangoFechasCambiadoAsync"
                                     Label="Rango de fechas" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        @* Un total por moneda y no un solo número: sumar colones con dólares en
           una sola cifra no representaría nada. Es el total pagado (monto sin
           IVA + IVA), igual que la columna Total. *@
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">
            Total acumulado:
            @if (totalesPorMoneda.Count == 0)
            {
                @:—
            }
            else
            {
                @string.Join("  ·  ", totalesPorMoneda.Select(t => TiposMoneda.ConSimbolo(t.Moneda, t.Total)))
            }
        </MudText>

        @* Breakpoint Sm: por debajo de 960 px cada fila se muestra como tarjeta con
           sus etiquetas, en vez de cortar las columnas de Estado y Acciones.

           ServerData en lugar de Items: la grilla pide una página por vez y el
           repositorio trae de la base solo esos registros. SortMode.None porque el
           orden (más reciente primero) lo fija la consulta en SQL: dejar ordenar por
           columna solo reordenaría la página visible, que sería engañoso. El total
           acumulado de arriba es del conjunto filtrado completo, no de la página:
           viene de un agregado en la base. *@
        <MudDataGrid T="GastoOperativoListaDto" @ref="grilla"
                     ServerData="CargarPaginaAsync"
                     RowsPerPage="FiltrosGastoDto.TamanoPaginaPredeterminado"
                     SortMode="SortMode.None" Filterable="false" Breakpoint="Breakpoint.Sm">
            <Columns>
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.TipoGasto" Title="Tipo de gasto" />
                <PropertyColumn Property="x => x.Proveedor" Title="Proveedor" />
                <PropertyColumn Property="x => x.NumeroFactura" Title="Factura" />
                <TemplateColumn Title="Monto sin IVA" CellStyle="white-space: nowrap">
                    <CellTemplate>@TiposMoneda.ConSimbolo(context.Item.Moneda, context.Item.MontoSinIva)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="IVA" CellStyle="white-space: nowrap">
                    <CellTemplate>@TiposMoneda.ConSimbolo(context.Item.Moneda, context.Item.Iva)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Total" CellStyle="white-space: nowrap">
                    <CellTemplate>@TiposMoneda.ConSimbolo(context.Item.Moneda, context.Item.Total)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Estado">
                    <CellTemplate>
                        @* Activo en verde; cualquier otro estado (Anulado) en rojo, con su propio texto. *@
                        <EstadoChip Activo="@(context.Item.Estado == nameof(EstadoGastoOperativo.Activo))"
                                    TextoInactivo="@context.Item.Estado" />
                    </CellTemplate>
                </TemplateColumn>
                @* nowrap en Acciones y en los montos: con nueve columnas, en escritorio la
                   celda de Acciones quedaba en ~100 px y Editar/Anular se apilaban,
                   duplicando la altura de cada fila. *@
                <TemplateColumn Title="Acciones" CellStyle="white-space: nowrap">
                    <CellTemplate>
                        @* Un gasto anulado es un registro cerrado: no se edita ni se
                           vuelve a anular. El servicio rechaza las dos cosas igual
                           (EditarGastoAsync, AB#2572), pero ocultar los botones evita
                           llevar a la persona a un formulario que no va a poder guardar. *@
                        @if (context.Item.Estado == nameof(EstadoGastoOperativo.Activo))
                        {
                            <AuthorizeView Policy="@Permisos.Gastos.Editar" Context="auth">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/gastos/editar/{context.Item.Id}")">Editar</MudButton>
                            </AuthorizeView>
                            <AuthorizeView Policy="@Permisos.Gastos.Anular" Context="auth">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Class="ac-btn-inactivar ml-1" OnClick="@(() => AnularAsync(context.Item.Id))">Anular</MudButton>
                            </AuthorizeView>
                        }
                        else
                        {
                            @* Un guion y no la celda vacía: en la vista de tarjetas
                               (celular) quedaba el rótulo "Acciones" sin nada al lado. *@
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ningún gasto coincide con los filtros"
                                 Descripcion="Pruebe con otro proveedor, factura, tipo de gasto o rango de fechas." />
                }
                else
                {
                    @* Sin filtros no se consulta nada, así que acá no se sabe si hay
                       gastos: la invitación a buscar también ofrece registrar uno,
                       para cuando todavía no hay ninguno. Mismo criterio que
                       ListadoProyectos. *@
                    <EstadoVacio Icono="@Icons.Material.Filled.ReceiptLong"
                                 Titulo="Busque un gasto por proveedor o factura, o elija un tipo o un rango de fechas"
                                 Descripcion="Así se consultan solo los gastos que necesita, sin cargar la lista completa."
                                 TextoAccion="Registrar gasto" HrefAccion="/gastos/registrar"
                                 PermisoAccion="@Permisos.Gastos.Registrar" />
                }
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="GastoOperativoListaDto"
                                  PageSizeOptions="@(new[] { FiltrosGastoDto.TamanoPaginaPredeterminado, 50, FiltrosGastoDto.TamanoPaginaMaximo })" />
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private ResumenGastos? resumenGastos;
    private MudDataGrid<GastoOperativoListaDto>? grilla;

    // Lo último que devolvió el servicio: la grilla muestra su página y el total
    // acumulado de arriba sale del mismo resultado.
    private IReadOnlyList<MontoPorMonedaDto> totalesPorMoneda = Array.Empty<MontoPorMonedaDto>();
    private IReadOnlyList<TipoGastoDto> tipos = Array.Empty<TipoGastoDto>();
    private string? filtroTexto;
    private int? filtroTipoGastoId;
    private DateRange? rangoFechas;

    // IsNullOrWhiteSpace, el mismo criterio con el que el repositorio decide si
    // aplica el filtro de texto: un texto con solo espacios no cuenta como búsqueda.
    private bool HayFiltro =>
        !string.IsNullOrWhiteSpace(filtroTexto) || filtroTipoGastoId.HasValue || rangoFechas is not null;

    // La pantalla abre sin consultar la lista de gastos, igual que Ver Proyectos,
    // Ver Beneficiarios y Existencias de inventario. Solo se traen los tipos, que
    // son el catálogo chico del desplegable de filtro; las tarjetas de arriba
    // (ResumenGastos) siguen mostrando los números del mes.
    protected override async Task OnInitializedAsync()
    {
        tipos = await TiposGastoService.ObtenerTodosAsync();
    }

    private async Task OnFiltroTextoCambiadoAsync(string? valor)
    {
        filtroTexto = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroTipoCambiadoAsync(int? valor)
    {
        filtroTipoGastoId = valor;
        await RecargarAsync();
    }

    private async Task OnRangoFechasCambiadoAsync(DateRange? valor)
    {
        rangoFechas = valor;
        await RecargarAsync();
    }

    // La llama la grilla cada vez que cambia de página o se recarga. Devuelve solo
    // los gastos de esa página más el total, que es lo que necesita el paginador.
    private async Task<GridData<GastoOperativoListaDto>> CargarPaginaAsync(
        GridState<GastoOperativoListaDto> estado, CancellationToken cancellationToken)
    {
        // Sin ningún criterio no se va a la base. Cubre también borrar el texto y
        // quitar los filtros: la grilla y el total se vacían en vez de traer
        // todos los gastos.
        if (!HayFiltro)
        {
            totalesPorMoneda = Array.Empty<MontoPorMonedaDto>();
            StateHasChanged();
            return new GridData<GastoOperativoListaDto> { Items = Array.Empty<GastoOperativoListaDto>(), TotalItems = 0 };
        }

        try
        {
            var resultado = await GastosService.ObtenerPaginaGastosAsync(new FiltrosGastoDto
            {
                Texto = filtroTexto,
                TipoGastoId = filtroTipoGastoId,
                FechaDesde = rangoFechas?.Start,
                FechaHasta = rangoFechas?.End,
                Pagina = estado.Page,
                TamanoPagina = estado.PageSize
            });

            totalesPorMoneda = resultado.TotalesPorMoneda;

            // El total de arriba está fuera de la grilla: ella se vuelve a dibujar sola
            // al recibir la página, pero la pantalla no.
            StateHasChanged();

            return new GridData<GastoOperativoListaDto>
            {
                Items = resultado.Gastos,
                TotalItems = resultado.TotalRegistros
            };
        }
        catch (Exception)
        {
            totalesPorMoneda = Array.Empty<MontoPorMonedaDto>();
            Snackbar.Add("No se pudieron consultar los gastos. Intente de nuevo.", Severity.Error);
            StateHasChanged();
            return new GridData<GastoOperativoListaDto> { Items = Array.Empty<GastoOperativoListaDto>(), TotalItems = 0 };
        }
    }

    // Al cambiar un filtro se vuelve a la primera página: la que se estaba viendo
    // puede no existir con el filtro nuevo (y quedaría vacía).
    //
    // NavigateTo cambia CurrentPage, y el setter de CurrentPage ya dispara
    // ServerData por dentro. Por eso solo se recarga a mano en la otra rama: así el
    // cambio de filtro cuesta una sola consulta y no dos.
    private async Task RecargarAsync()
    {
        if (grilla is null)
            return;

        if (grilla.CurrentPage != 0)
            grilla.NavigateTo(Page.First);
        else
            await grilla.ReloadServerData();
    }

    private async Task AnularAsync(int gastoId)
    {
        // Ancho fijo (Small + FullWidth): sin opciones el diálogo se ajustaba al
        // contenido y en un celular quedaba en ~250 px, con un campo de motivo
        // demasiado chico para escribir.
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AnularGastoDialog>("Anular gasto operativo", opciones);
        var resultado = await dialog.Result;

        if (resultado is null || resultado.Canceled)
            return;

        var motivo = (string)resultado.Data!;

        try
        {
            await GastosService.AnularGastoAsync(new AnulacionGastoDto { GastoId = gastoId, MotivoAnulacion = motivo });
            Snackbar.Add("Gasto operativo anulado.", Severity.Success);

            // Se recarga la página actual, no la primera: el filtro no cambió.
            if (grilla is not null)
                await grilla.ReloadServerData();
            // Anular un gasto cambia el total y el conteo de las tarjetas.
            if (resumenGastos is not null)
                await resumenGastos.RecargarAsync();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo anular el gasto operativo. Intente de nuevo.", Severity.Error);
        }
    }
}
