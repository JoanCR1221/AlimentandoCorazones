@page "/gastos"
@using SIGAC.Application.DTOs.Gastos
@using SIGAC.Application.Interfaces
@inject IGastosService GastosService

<MudText Typo="Typo.h4" Class="mb-4">Gastos operativos</MudText>

<MudCard Class="pa-4">
    <MudCardContent>
        <MudDataGrid T="GastoOperativoListaDto" Items="@gastos">
            <Columns>
                <PropertyColumn Property="x => x.Categoria" Title="Categoría" />
                <PropertyColumn Property="x => x.Monto" Title="Monto" Format="N2" />
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.Descripcion" Title="Descripción" />
                <PropertyColumn Property="x => x.Estado" Title="Estado" />
            </Columns>
            <NoRecordsContent>
                <MudText>No hay gastos operativos registrados.</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private List<GastoOperativoListaDto> gastos = new();

    // A diferencia de Existencias de inventario (catálogo potencialmente enorme,
    // exige un filtro antes de mostrar algo), un listado de gastos operativos es
    // chico y funciona como un registro contable: se ve todo al abrir, y los
    // filtros solo acotan lo que ya está a la vista.
    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var resultado = await GastosService.ObtenerGastosAsync(new FiltrosGastoDto());
        gastos = resultado.Gastos.ToList();
    }
}
