@page "/gastos"
@attribute [Authorize(Policy = Permisos.Gastos.Ver)]
@using SIGAC.Application.DTOs
@using SIGAC.Application.DTOs.Gastos
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@using SIGAC.Domain.Entities
@inject IGastosService GastosService
@inject ITiposGastoService TiposGastoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<EncabezadoPagina Titulo="Gastos operativos"
                  Descripcion="Registre y consulte los gastos operativos de la asociación."
                  TextoAccion="Registrar gasto" HrefAccion="/gastos/registrar"
                  PermisoAccion="@Permisos.Gastos.Registrar" />

<ResumenGastos @ref="resumenGastos" />

<MudCard Class="pa-4">
    <MudCardContent>
        @* Todos los tipos, también los inactivos: un tipo desactivado ya no se
           elige al registrar, pero sus gastos viejos siguen existiendo y tienen
           que poder filtrarse. *@
        <MudSelect T="int?" Value="filtroTipoGastoId" ValueChanged="OnFiltroTipoCambiadoAsync"
                   Label="Tipo de gasto" Variant="Variant.Outlined" Class="mb-4" Clearable="true"
                   ToStringFunc="@(id => tipos.FirstOrDefault(t => t.Id == id)?.Nombre ?? string.Empty)">
            @foreach (var tipo in tipos)
            {
                <MudSelectItem T="int?" Value="@tipo.Id">@tipo.Nombre@(tipo.Activo ? string.Empty : " (inactivo)")</MudSelectItem>
            }
        </MudSelect>

        <MudDateRangePicker DateRange="rangoFechas" DateRangeChanged="OnRangoFechasCambiadoAsync"
                             Label="Rango de fechas" Variant="Variant.Outlined" Class="mb-4" />

        @* Un total por moneda y no un solo número: sumar colones con dólares en
           una sola cifra no representaría nada. Es el total pagado (monto sin
           IVA + IVA), igual que la columna Total. *@
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">
            Total acumulado:
            @if (totalesPorMoneda.Count == 0)
            {
                @:—
            }
            else
            {
                @string.Join("  ·  ", totalesPorMoneda.Select(
                    t => $"{TiposMoneda.Simbolo(t.Moneda)} {t.Total:N2}"))
            }
        </MudText>

        <MudDataGrid T="GastoOperativoListaDto" Items="@gastos" Loading="cargando">
            <Columns>
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.TipoGasto" Title="Tipo de gasto" />
                <PropertyColumn Property="x => x.Proveedor" Title="Proveedor" />
                <PropertyColumn Property="x => x.NumeroFactura" Title="Factura" />
                <TemplateColumn Title="Monto sin IVA">
                    <CellTemplate>@TiposMoneda.Simbolo(context.Item.Moneda) @context.Item.MontoSinIva.ToString("N2")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="IVA">
                    <CellTemplate>@TiposMoneda.Simbolo(context.Item.Moneda) @context.Item.Iva.ToString("N2")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Total">
                    <CellTemplate>@TiposMoneda.Simbolo(context.Item.Moneda) @context.Item.Total.ToString("N2")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Estado">
                    <CellTemplate>
                        @* Activo en verde; cualquier otro estado (Anulado) en rojo, con su propio texto. *@
                        <EstadoChip Activo="@(context.Item.Estado == nameof(EstadoGastoOperativo.Activo))"
                                    TextoInactivo="@context.Item.Estado" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Acciones">
                    <CellTemplate>
                        <AuthorizeView Policy="@Permisos.Gastos.Editar" Context="auth">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/gastos/editar/{context.Item.Id}")">Editar</MudButton>
                        </AuthorizeView>
                        @* Un gasto ya anulado no se puede volver a anular (AB#2572 lo
                           rechaza igual del lado del servicio, pero ocultar el botón
                           evita el viaje al servidor para un error ya previsible). *@
                        @if (context.Item.Estado == nameof(EstadoGastoOperativo.Activo))
                        {
                            <AuthorizeView Policy="@Permisos.Gastos.Anular" Context="auth">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Class="ac-btn-inactivar ml-1" OnClick="@(() => AnularAsync(context.Item.Id))">Anular</MudButton>
                            </AuthorizeView>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ningún gasto coincide con los filtros"
                                 Descripcion="Pruebe con otro tipo de gasto o rango de fechas." />
                }
                else
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.ReceiptLong"
                                 Titulo="Todavía no hay gastos operativos registrados"
                                 TextoAccion="Registrar gasto" HrefAccion="/gastos/registrar"
                                 PermisoAccion="@Permisos.Gastos.Registrar" />
                }
            </NoRecordsContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private ResumenGastos? resumenGastos;

    private List<GastoOperativoListaDto> gastos = new();
    private IReadOnlyList<MontoPorMonedaDto> totalesPorMoneda = Array.Empty<MontoPorMonedaDto>();
    private IReadOnlyList<TipoGastoDto> tipos = Array.Empty<TipoGastoDto>();
    private int? filtroTipoGastoId;
    private DateRange? rangoFechas;
    private bool cargando = true;

    private bool HayFiltro => filtroTipoGastoId.HasValue || rangoFechas is not null;

    // A diferencia de Existencias de inventario (catálogo potencialmente enorme,
    // exige un filtro antes de mostrar algo), un listado de gastos operativos es
    // chico y funciona como un registro contable: se ve todo al abrir, y los
    // filtros solo acotan lo que ya está a la vista.
    protected override async Task OnInitializedAsync()
    {
        tipos = await TiposGastoService.ObtenerTodosAsync();
        await CargarAsync();
    }

    private async Task OnFiltroTipoCambiadoAsync(int? valor)
    {
        filtroTipoGastoId = valor;
        await CargarAsync();
    }

    private async Task OnRangoFechasCambiadoAsync(DateRange? valor)
    {
        rangoFechas = valor;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;

        try
        {
            var resultado = await GastosService.ObtenerGastosAsync(new FiltrosGastoDto
            {
                TipoGastoId = filtroTipoGastoId,
                FechaDesde = rangoFechas?.Start,
                FechaHasta = rangoFechas?.End
            });
            gastos = resultado.Gastos.ToList();
            totalesPorMoneda = resultado.TotalesPorMoneda;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AnularAsync(int gastoId)
    {
        var dialog = await DialogService.ShowAsync<AnularGastoDialog>("Anular gasto operativo");
        var resultado = await dialog.Result;

        if (resultado is null || resultado.Canceled)
            return;

        var motivo = (string)resultado.Data!;

        try
        {
            await GastosService.AnularGastoAsync(new AnulacionGastoDto { GastoId = gastoId, MotivoAnulacion = motivo });
            Snackbar.Add("Gasto operativo anulado.", Severity.Success);
            await CargarAsync();
            // Anular un gasto cambia el total y el conteo de las tarjetas.
            if (resumenGastos is not null)
                await resumenGastos.RecargarAsync();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo anular el gasto operativo. Intente de nuevo.", Severity.Error);
        }
    }
}
