@page "/asistencia/registrar"
@using SIGAC.Application.DTOs.Asistencia
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IBeneficiariosService BeneficiariosService
@inject IAsistenciaService AsistenciaService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Registrar asistencia</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            @* Es un buscador, no un desplegable: no despliega nada hasta que se
               escriben MinimoCaracteresBusqueda caracteres. Con menos, mostraría
               una lista arbitraria de beneficiarios. *@
            <MudAutocomplete T="BeneficiarioListaDto" Label="Beneficiario" Variant="Variant.Outlined"
                              Value="beneficiarioSeleccionado" ValueChanged="OnBeneficiarioSeleccionadoAsync"
                              SearchFunc="BuscarBeneficiariosActivosAsync" ToStringFunc="@(b => b?.NombreCompleto)"
                              MinCharacters="FiltrosBeneficiarioDto.MinimoCaracteresBusqueda"
                              OpenOnFocus="false"
                              HelperText="@AyudaBusqueda" />
            @* La ventana de fechas sale de ReglasAsistencia, la misma fuente que
               valida AsistenciaService: el calendario no puede ofrecer un día que
               el servidor después rechace. *@
            <MudDatePicker @bind-Date="fecha" @bind-Date:after="VerificarDuplicadoAsync" Label="Fecha" Variant="Variant.Outlined" Class="mt-4"
                           MinDate="ReglasAsistencia.FechaMinimaRegistro()"
                           MaxDate="ReglasAsistencia.Hoy"
                           HelperText="@AyudaFecha" />
            @* Lista cerrada: la fuente es SIGAC.Domain.TiemposComida, no la pantalla. *@
            <MudSelect T="string" @bind-Value="modelo.TiempoComida" @bind-Value:after="VerificarDuplicadoAsync" For="@(() => modelo.TiempoComida)"
                       Label="Tiempo de comida" Variant="Variant.Outlined" Class="mt-4">
                @foreach (var tiempoComida in TiemposComida.Todos)
                {
                    <MudSelectItem T="string" Value="@tiempoComida">@tiempoComida</MudSelectItem>
                }
            </MudSelect>

            @if (asistenciaDuplicada)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4">
                    Este beneficiario ya tiene una asistencia registrada para ese tiempo de comida en esta fecha.
                </MudAlert>
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    private AsistenciaCrearDto modelo = new();
    private BeneficiarioListaDto? beneficiarioSeleccionado;
    private bool asistenciaDuplicada;

    private static readonly string AyudaBusqueda =
        $"Escribí al menos {FiltrosBeneficiarioDto.MinimoCaracteresBusqueda} caracteres para buscar por nombre o número de identidad.";

    private DateTime? fecha
    {
        get => modelo.Fecha == default ? null : modelo.Fecha;
        set => modelo.Fecha = value ?? default;
    }

    // Propiedad y no campo estático: lleva una fecha adentro, y el servidor puede
    // seguir vivo después de medianoche. Se recalcula en cada render.
    private string AyudaFecha =>
        $"La asistencia se registra el día en que ocurre. Solo se pueden cargar los últimos " +
        $"{ReglasAsistencia.MaximoDiasHaciaAtras} días, desde el {ReglasAsistencia.FechaMinimaRegistro():dd/MM/yyyy}.";

    // El caso normal es registrar hoy: el campo arranca en la fecha de hoy en vez
    // de vacío, para no obligar a abrir el calendario en cada registro.
    protected override void OnInitialized()
    {
        modelo.Fecha = ReglasAsistencia.Hoy;
    }

    private async Task<IEnumerable<BeneficiarioListaDto>> BuscarBeneficiariosActivosAsync(string valor, CancellationToken cancellationToken)
    {
        // MinCharacters ya evita la llamada, pero la guarda queda igual: es la que
        // garantiza que nunca se devuelva una lista sin haber buscado nada.
        if ((valor?.Trim().Length ?? 0) < FiltrosBeneficiarioDto.MinimoCaracteresBusqueda)
            return Array.Empty<BeneficiarioListaDto>();

        // Nombre es el campo de texto libre del filtro: el servicio lo busca en los
        // cuatro campos de nombre y también en el número de identidad.
        // El servicio pagina: al autocompletar alcanza con la primera página, que
        // además evita traer cientos de coincidencias para un texto corto.
        var resultado = await BeneficiariosService.ObtenerBeneficiariosAsync(new FiltrosBeneficiarioDto
        {
            Nombre = valor,
            Estado = true
        });

        return resultado.Elementos;
    }

    private async Task OnBeneficiarioSeleccionadoAsync(BeneficiarioListaDto? valor)
    {
        beneficiarioSeleccionado = valor;
        modelo.BeneficiarioId = valor?.Id ?? 0;
        await VerificarDuplicadoAsync();
    }

    private async Task VerificarDuplicadoAsync()
    {
        // Consulta de existencia (EXISTS). Antes traía el historial filtrado con su
        // JOIN y sus totales solo para preguntar si había una fila.
        asistenciaDuplicada = await AsistenciaService.ExisteAsistenciaAsync(
            modelo.BeneficiarioId, modelo.Fecha, modelo.TiempoComida);
    }

    private async Task Guardar()
    {
        try
        {
            await AsistenciaService.RegistrarAsistenciaAsync(modelo);
            Snackbar.Add("Asistencia registrada correctamente.", Severity.Success);

            modelo = new() { Fecha = ReglasAsistencia.Hoy };
            beneficiarioSeleccionado = null;
            asistenciaDuplicada = false;
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (DuplicateException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar la asistencia. Intentá de nuevo.", Severity.Error);
        }
    }
}
