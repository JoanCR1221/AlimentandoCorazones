@page "/asistencia/registrar"
@using SIGAC.Application.DTOs.Asistencia
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject IBeneficiariosService BeneficiariosService
@inject IAsistenciaService AsistenciaService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Registrar asistencia</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            <MudAutocomplete T="BeneficiarioListaDto" Label="Beneficiario" Variant="Variant.Outlined"
                              Value="beneficiarioSeleccionado" ValueChanged="OnBeneficiarioSeleccionadoAsync"
                              SearchFunc="BuscarBeneficiariosActivosAsync" ToStringFunc="@(b => b?.Nombre)" />
            <MudDatePicker @bind-Date="fecha" @bind-Date:after="VerificarDuplicadoAsync" Label="Fecha" Variant="Variant.Outlined" Class="mt-4"
                           MaxDate="DateTime.Today" />
            <MudSelect T="string" @bind-Value="modelo.TiempoComida" @bind-Value:after="VerificarDuplicadoAsync" For="@(() => modelo.TiempoComida)"
                       Label="Tiempo de comida" Variant="Variant.Outlined" Class="mt-4">
                <MudSelectItem T="string" Value="@("Desayuno")">Desayuno</MudSelectItem>
                <MudSelectItem T="string" Value="@("Almuerzo")">Almuerzo</MudSelectItem>
                <MudSelectItem T="string" Value="@("Cena")">Cena</MudSelectItem>
            </MudSelect>

            @if (asistenciaDuplicada)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4">
                    Este beneficiario ya tiene una asistencia registrada para ese tiempo de comida en esta fecha.
                </MudAlert>
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    private AsistenciaCrearDto modelo = new();
    private BeneficiarioListaDto? beneficiarioSeleccionado;
    private bool asistenciaDuplicada;

    private DateTime? fecha
    {
        get => modelo.Fecha == default ? null : modelo.Fecha;
        set => modelo.Fecha = value ?? default;
    }

    private async Task<IEnumerable<BeneficiarioListaDto>> BuscarBeneficiariosActivosAsync(string valor, CancellationToken cancellationToken)
    {
        var beneficiarios = await BeneficiariosService.ObtenerBeneficiariosAsync(new FiltrosBeneficiarioDto
        {
            Nombre = valor,
            Estado = true
        });

        return beneficiarios;
    }

    private async Task OnBeneficiarioSeleccionadoAsync(BeneficiarioListaDto? valor)
    {
        beneficiarioSeleccionado = valor;
        modelo.BeneficiarioId = valor?.Id ?? 0;
        await VerificarDuplicadoAsync();
    }

    private async Task VerificarDuplicadoAsync()
    {
        asistenciaDuplicada = false;

        if (modelo.BeneficiarioId == 0 || modelo.Fecha == default || string.IsNullOrWhiteSpace(modelo.TiempoComida))
            return;

        var resultado = await AsistenciaService.ObtenerHistorialAsistenciaAsync(new FiltrosAsistenciaDto
        {
            BeneficiarioId = modelo.BeneficiarioId,
            FechaDesde = modelo.Fecha,
            FechaHasta = modelo.Fecha,
            TiempoComida = modelo.TiempoComida
        });

        asistenciaDuplicada = resultado.Registros.Count > 0;
    }

    private async Task Guardar()
    {
        try
        {
            await AsistenciaService.RegistrarAsistenciaAsync(modelo);
            Snackbar.Add("Asistencia registrada correctamente.", Severity.Success);

            modelo = new();
            beneficiarioSeleccionado = null;
            asistenciaDuplicada = false;
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (DuplicateException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar la asistencia. Intentá de nuevo.", Severity.Error);
        }
    }
}
