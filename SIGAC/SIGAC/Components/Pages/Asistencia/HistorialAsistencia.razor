@page "/asistencia/historial"
@attribute [Authorize(Policy = Permisos.Asistencia.Ver)]
@using SIGAC.Application.DTOs.Asistencia
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IAsistenciaService AsistenciaService
@inject IBeneficiariosService BeneficiariosService
@inject ISnackbar Snackbar

<EncabezadoPagina Titulo="Historial de asistencia"
                  Descripcion="Consulte la asistencia diaria al comedor."
                  TextoAccion="Registrar asistencia" HrefAccion="/asistencia/registrar"
                  PermisoAccion="@Permisos.Asistencia.Registrar" />

<ResumenAsistencia />

<MudCard Class="pa-4">
    <MudCardContent>
        @* Es un buscador, no un desplegable: no despliega nada hasta que se
           escriben MinimoCaracteresBusqueda caracteres. *@
        <MudAutocomplete T="BeneficiarioListaDto" Value="beneficiarioSeleccionado" ValueChanged="OnBeneficiarioCambiadoAsync"
                          SearchFunc="BuscarBeneficiariosAsync" ToStringFunc="@(b => b?.NombreCompleto)"
                          MinCharacters="FiltrosBeneficiarioDto.MinimoCaracteresBusqueda"
                          OpenOnFocus="false"
                          HelperText="@AyudaBusqueda"
                          Label="Beneficiario" Variant="Variant.Outlined" Class="mb-4" Clearable="true" />
        @* Lista cerrada: la fuente es SIGAC.Domain.TiemposComida, no la pantalla. *@
        <MudSelect T="string" Value="filtroTiempoComida" ValueChanged="OnTiempoComidaCambiadoAsync"
                   Label="Tiempo de comida" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            @foreach (var tiempoComida in TiemposComida.Todos)
            {
                <MudSelectItem T="string" Value="@tiempoComida">@tiempoComida</MudSelectItem>
            }
        </MudSelect>
        <MudDateRangePicker DateRange="rangoFechas" DateRangeChanged="OnRangoFechasCambiadoAsync"
                             Label="Rango de fechas" Variant="Variant.Outlined" Class="mb-4" />

        @* Los totales son del período completo, no de la página que se ve: vienen
           de un agregado en la base, junto con cada página. *@
        <MudText Typo="Typo.subtitle1" Class="mb-1">Total de asistencias del período: @TextoResumen.Numero(resultado.TotalRegistros)</MudText>
        @if (resultado.TotalesPorTiempoComida.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                @string.Join(" · ", resultado.TotalesPorTiempoComida.Select(kv => $"{kv.Key}: {TextoResumen.Numero(kv.Value)}"))
            </MudText>
        }

        @* ServerData en lugar de Items: el historial crece con cada día de servicio,
           así que la grilla pide una página por vez y el repositorio trae de la base
           solo esos registros. SortMode.None porque el orden (más reciente primero) lo
           fija la consulta en SQL: dejar ordenar por columna solo reordenaría la
           página visible, que sería engañoso. *@
        <MudDataGrid T="HistorialAsistenciaDto" @ref="grilla"
                     ServerData="CargarPaginaAsync"
                     RowsPerPage="FiltrosAsistenciaDto.TamanoPaginaPredeterminado"
                     SortMode="SortMode.None" Filterable="false">
            <Columns>
                <PropertyColumn Property="x => x.NombreBeneficiario" Title="Beneficiario" />
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.TiempoComida" Title="Tiempo de comida" />
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ninguna asistencia coincide con los filtros"
                                 Descripcion="Pruebe con otro beneficiario, tiempo de comida o rango de fechas." />
                }
                else
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.Restaurant"
                                 Titulo="Todavía no hay asistencias registradas"
                                 TextoAccion="Registrar asistencia" HrefAccion="/asistencia/registrar"
                                 PermisoAccion="@Permisos.Asistencia.Registrar" />
                }
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="HistorialAsistenciaDto"
                                  PageSizeOptions="@(new[] { FiltrosAsistenciaDto.TamanoPaginaPredeterminado, 50, FiltrosAsistenciaDto.TamanoPaginaMaximo })" />
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private MudDataGrid<HistorialAsistenciaDto>? grilla;

    // Lo último que devolvió el servicio: la grilla muestra su página y los totales
    // de arriba salen del mismo resultado.
    private HistorialAsistenciaResultadoDto resultado = new();
    private BeneficiarioListaDto? beneficiarioSeleccionado;
    private string? filtroTiempoComida;
    private DateRange? rangoFechas;

    private bool HayFiltro =>
        beneficiarioSeleccionado is not null || !string.IsNullOrWhiteSpace(filtroTiempoComida) || rangoFechas is not null;

    private static readonly string AyudaBusqueda =
        $"Escriba al menos {FiltrosBeneficiarioDto.MinimoCaracteresBusqueda} caracteres para buscar por nombre o número de identidad.";

    private async Task<IEnumerable<BeneficiarioListaDto>> BuscarBeneficiariosAsync(string valor, CancellationToken cancellationToken)
    {
        // MinCharacters ya evita la llamada, pero la guarda queda igual: es la que
        // garantiza que nunca se devuelva una lista sin haber buscado nada.
        if ((valor?.Trim().Length ?? 0) < FiltrosBeneficiarioDto.MinimoCaracteresBusqueda)
            return Array.Empty<BeneficiarioListaDto>();

        // Nombre es el campo de texto libre del filtro: el servicio lo busca en los
        // cuatro campos de nombre y también en el número de identidad.
        // El servicio pagina: al autocompletar alcanza con la primera página.
        var resultado = await BeneficiariosService.ObtenerBeneficiariosAsync(new FiltrosBeneficiarioDto { Nombre = valor });

        return resultado.Elementos;
    }

    private async Task OnBeneficiarioCambiadoAsync(BeneficiarioListaDto? valor)
    {
        beneficiarioSeleccionado = valor;
        await RecargarAsync();
    }

    private async Task OnTiempoComidaCambiadoAsync(string? valor)
    {
        filtroTiempoComida = valor;
        await RecargarAsync();
    }

    private async Task OnRangoFechasCambiadoAsync(DateRange? valor)
    {
        rangoFechas = valor;
        await RecargarAsync();
    }

    // La llama la grilla cada vez que cambia de página o se recarga. Devuelve solo
    // los registros de esa página más el total, que es lo que necesita el paginador.
    private async Task<GridData<HistorialAsistenciaDto>> CargarPaginaAsync(
        GridState<HistorialAsistenciaDto> estado, CancellationToken cancellationToken)
    {
        try
        {
            resultado = await AsistenciaService.ObtenerHistorialAsistenciaAsync(new FiltrosAsistenciaDto
            {
                BeneficiarioId = beneficiarioSeleccionado?.Id,
                TiempoComida = filtroTiempoComida,
                FechaDesde = rangoFechas?.Start,
                FechaHasta = rangoFechas?.End,
                Pagina = estado.Page,
                TamanoPagina = estado.PageSize
            });
        }
        catch (Exception)
        {
            resultado = new HistorialAsistenciaResultadoDto();
            Snackbar.Add("No se pudo cargar el historial de asistencia. Intente de nuevo.", Severity.Error);
        }

        // Los totales de arriba están fuera de la grilla: ella se vuelve a dibujar
        // sola al recibir la página, pero la pantalla no.
        StateHasChanged();

        return new GridData<HistorialAsistenciaDto>
        {
            Items = resultado.Registros,
            TotalItems = resultado.TotalRegistros
        };
    }

    // Al cambiar un filtro se vuelve a la primera página: la que se estaba viendo
    // puede no existir con el filtro nuevo (y quedaría vacía).
    //
    // NavigateTo cambia CurrentPage, y el setter de CurrentPage ya dispara
    // ServerData por dentro. Por eso solo se recarga a mano en la otra rama: así el
    // cambio de filtro cuesta una sola consulta y no dos.
    private async Task RecargarAsync()
    {
        if (grilla is null)
            return;

        if (grilla.CurrentPage != 0)
            grilla.NavigateTo(Page.First);
        else
            await grilla.ReloadServerData();
    }
}
