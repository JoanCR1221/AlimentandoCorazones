@page "/configuracion"
@using SIGAC.Application.DTOs.Seguridad
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject AparienciaService Apariencia
@inject IUsuariosService UsuariosService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Configuraciones — SIGAC</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Configuraciones</MudText>

<MudCard Class="pa-4">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-1">Apariencia</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            Elegí cómo se ve SIGAC en esta computadora.
        </MudText>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <div>
                <MudText Typo="Typo.subtitle1">Modo oscuro</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Reduce el brillo de la pantalla.</MudText>
            </div>
            <MudSwitch T="bool" Value="Apariencia.EsOscuro" ValueChanged="Apariencia.SetEsOscuroAsync"
                       Color="Color.Primary" aria-label="Alternar modo oscuro" />
        </MudStack>

        <MudDivider Class="mb-4" />

        <MudText Typo="Typo.subtitle1">Tamaño de letra</MudText>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
            Ajustá qué tan grande se ve el texto en toda la aplicación.
        </MudText>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@AparienciaService.TamanoFuenteMinimo%</MudText>
            <MudText Typo="Typo.body1" Color="Color.Primary">@Apariencia.TamanoFuente%</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@AparienciaService.TamanoFuenteMaximo%</MudText>
        </MudStack>
        <MudSlider T="int" Value="Apariencia.TamanoFuente" ValueChanged="Apariencia.SetTamanoFuenteAsync"
                   Min="AparienciaService.TamanoFuenteMinimo" Max="AparienciaService.TamanoFuenteMaximo"
                   Step="5" Color="Color.Primary" Class="mb-4"
                   aria-label="Ajustar tamaño de letra" />

        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.body1">
                Así se ve el texto con este tamaño: «María González, beneficiaria activa del comedor».
            </MudText>
        </MudPaper>
    </MudCardContent>
</MudCard>

@* Cambio de la propia contraseña: para cualquier usuario autenticado, sin
   permiso especial. Al cambiarla Identity renueva el security stamp, así que
   la sesión se cierra y hay que volver a entrar con la nueva. *@
<MudCard Class="pa-4 mt-4">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-1">Contraseña</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            Cambiá tu contraseña de acceso a SIGAC. Después del cambio vas a tener que iniciar sesión de nuevo.
        </MudText>

        <EditForm Model="cambioPassword" OnValidSubmit="CambiarPasswordAsync">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="cambioPassword.PasswordActual" For="@(() => cambioPassword.PasswordActual)"
                          Label="Contraseña actual" Variant="Variant.Outlined"
                          InputType="@(mostrarPassword ? InputType.Text : InputType.Password)" />

            <MudTextField @bind-Value="cambioPassword.PasswordNueva" For="@(() => cambioPassword.PasswordNueva)"
                          Label="Contraseña nueva" Variant="Variant.Outlined" Class="mt-4"
                          InputType="@(mostrarPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(mostrarPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentAriaLabel="Mostrar u ocultar las contraseñas"
                          OnAdornmentClick="@(() => mostrarPassword = !mostrarPassword)"
                          HelperText="@ReglasUsuario.DescripcionReglasPassword" />

            <MudTextField @bind-Value="cambioPassword.ConfirmarPassword" For="@(() => cambioPassword.ConfirmarPassword)"
                          Label="Repetir contraseña nueva" Variant="Variant.Outlined" Class="mt-4"
                          InputType="@(mostrarPassword ? InputType.Text : InputType.Password)" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       Disabled="cambiandoPassword">
                @(cambiandoPassword ? "Cambiando..." : "Cambiar contraseña")
            </MudButton>
        </EditForm>
    </MudCardContent>
</MudCard>

@code {
    private CambioPasswordDto cambioPassword = new();
    private bool cambiandoPassword;
    private bool mostrarPassword;

    protected override void OnInitialized()
    {
        Apariencia.OnChange += StateHasChanged;
    }

    private async Task CambiarPasswordAsync()
    {
        cambiandoPassword = true;

        try
        {
            await UsuariosService.CambiarPasswordAsync(cambioPassword);
            cambioPassword = new();

            // La cookie ya no vale (cambió el security stamp): se manda al login
            // con una carga completa para que el usuario entre con la nueva.
            Snackbar.Add("Contraseña cambiada. Iniciá sesión de nuevo con la contraseña nueva.", Severity.Success);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo cambiar la contraseña. Intentá de nuevo.", Severity.Error);
        }
        finally
        {
            cambiandoPassword = false;
        }
    }

    public void Dispose()
    {
        Apariencia.OnChange -= StateHasChanged;
    }
}
