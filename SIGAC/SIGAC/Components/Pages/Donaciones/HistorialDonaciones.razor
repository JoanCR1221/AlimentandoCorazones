@page "/donaciones/historial"
@attribute [Authorize(Policy = Permisos.Donaciones.VerHistorial)]
@using SIGAC.Application.DTOs
@using SIGAC.Application.DTOs.Donaciones
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IDonantesService DonantesService
@inject IDonacionesService DonacionesService
@inject ISnackbar Snackbar

<PageTitle>Historial de donaciones — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Historial de donaciones"
                  Descripcion="Consulte las donaciones recibidas en dinero y en especie." />

<ResumenDonaciones />

<MudCard Class="pa-4">
    <MudCardContent>
        @* Sin filtrar por Estado: una consulta de historial también tiene que
           poder encontrar donaciones de un donante que hoy está inactivo. *@
        <MudAutocomplete T="DonanteListaDto" Label="Donante" Variant="Variant.Outlined" Class="mb-4"
                          Value="donanteSeleccionado" ValueChanged="OnDonanteCambiadoAsync"
                          SearchFunc="BuscarDonantesAsync" ToStringFunc="@(d => d?.Nombre)" Clearable="true" />

        <MudSelect T="string" Value="filtroTipoDonacion" ValueChanged="OnTipoDonacionCambiadoAsync"
                   Label="Tipo de donación" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            <MudSelectItem T="string" Value="@("Dinero")">Dinero</MudSelectItem>
            <MudSelectItem T="string" Value="@("Especie")">Especie</MudSelectItem>
        </MudSelect>

        <MudDateRangePicker DateRange="rangoFechas" DateRangeChanged="OnRangoFechasCambiadoAsync"
                             Label="Rango de fechas" Variant="Variant.Outlined" Class="mb-4" />

        @* Un total por moneda y no un solo número: desde que el monto declara en
           qué moneda vino, sumar colones con dólares en una sola cifra no
           representaría nada. Cuando el período no tiene ninguna donación en
           dinero, la lista queda vacía y no se muestra nada acá. *@
        <MudText Typo="Typo.subtitle1" Class="mb-4">
            Total en dinero del período:
            @if (resultado.TotalesPorMoneda.Count == 0)
            {
                @:—
            }
            else
            {
                @string.Join("  ·  ", resultado.TotalesPorMoneda.Select(
                    t => $"{TiposMoneda.Simbolo(t.Moneda)} {t.Total:N2}"))
            }
        </MudText>

        @* ServerData en lugar de Items: el historial crece con cada donación, así que
           la grilla pide una página por vez y el repositorio trae de la base solo
           esos registros. SortMode.None porque el orden (más reciente primero) lo
           fija la consulta en SQL: dejar ordenar por columna solo reordenaría la
           página visible, que sería engañoso. El total de arriba es del período
           completo, no de la página: viene de un agregado en la base. *@
        <MudDataGrid T="HistorialDonacionDto" @ref="grilla"
                     ServerData="CargarPaginaAsync"
                     RowsPerPage="FiltrosHistorialDonacionDto.TamanoPaginaPredeterminado"
                     SortMode="SortMode.None" Filterable="false">
            <Columns>
                <PropertyColumn Property="x => x.TipoDonacion" Title="Tipo" />
                <PropertyColumn Property="x => x.NombreDonante" Title="Donante" />
                <TemplateColumn Title="Monto">
                    <CellTemplate>
                        @(context.Item.Monto is null
                            ? "—"
                            : $"{TiposMoneda.Simbolo(context.Item.Moneda)} {context.Item.Monto:N2}")
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Descripcion" Title="Descripción" />
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ninguna donación coincide con los filtros"
                                 Descripcion="Pruebe con otro donante, tipo de donación o rango de fechas." />
                }
                else
                {
                    @* Sin filtros no se consulta nada, así que acá no se sabe si hay
                       donaciones: se invita a buscar. *@
                    <EstadoVacio Icono="@Icons.Material.Filled.VolunteerActivism"
                                 Titulo="Busque un donante, o elija un tipo de donación o un rango de fechas"
                                 Descripcion="Así se consultan solo las donaciones que necesita, sin cargar el historial completo." />
                }
            </NoRecordsContent>
            <PagerContent>
                @* Sin filas no hay nada que paginar: el paginador solo estorbaba (F-16). *@
                @if (grilla?.GetFilteredItemsCount() > 0)
                {
                    <MudDataGridPager T="HistorialDonacionDto"
                                      PageSizeOptions="@(new[] { FiltrosHistorialDonacionDto.TamanoPaginaPredeterminado, 50, FiltrosHistorialDonacionDto.TamanoPaginaMaximo })" />
                }
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private MudDataGrid<HistorialDonacionDto>? grilla;

    // Lo último que devolvió el servicio: la grilla muestra su página y el total de
    // arriba sale del mismo resultado.
    private HistorialDonacionesResultadoDto resultado = new();
    private DonanteListaDto? donanteSeleccionado;
    private string? filtroTipoDonacion;
    private DateRange? rangoFechas;

    private bool HayFiltro =>
        donanteSeleccionado is not null || !string.IsNullOrWhiteSpace(filtroTipoDonacion) || rangoFechas is not null;

    private async Task<IEnumerable<DonanteListaDto>> BuscarDonantesAsync(string valor, CancellationToken cancellationToken)
    {
        var resultado = await DonantesService.ObtenerDonantesAsync(new FiltrosDonanteDto { Nombre = valor });
        return resultado.Elementos;
    }

    private async Task OnDonanteCambiadoAsync(DonanteListaDto? valor)
    {
        donanteSeleccionado = valor;
        await RecargarAsync();
    }

    private async Task OnTipoDonacionCambiadoAsync(string? valor)
    {
        filtroTipoDonacion = valor;
        await RecargarAsync();
    }

    private async Task OnRangoFechasCambiadoAsync(DateRange? valor)
    {
        rangoFechas = valor;
        await RecargarAsync();
    }

    // La llama la grilla cada vez que cambia de página o se recarga. Devuelve solo
    // las donaciones de esa página más el total, que es lo que necesita el paginador.
    private async Task<GridData<HistorialDonacionDto>> CargarPaginaAsync(
        GridState<HistorialDonacionDto> estado, CancellationToken cancellationToken)
    {
        // La pantalla abre sin consultar el historial: sin ningún criterio
        // no se va a la base y la grilla queda vacía, con la invitación a buscar.
        // Mismo criterio que ListadoGastos. Cubre también quitar todos los filtros.
        if (!HayFiltro)
        {
            resultado = new HistorialDonacionesResultadoDto();
            StateHasChanged();
            return new GridData<HistorialDonacionDto> { Items = Array.Empty<HistorialDonacionDto>(), TotalItems = 0 };
        }

        try
        {
            resultado = await DonacionesService.ObtenerPaginaHistorialDonacionesAsync(new FiltrosHistorialDonacionDto
            {
                DonanteId = donanteSeleccionado?.Id,
                TipoDonacion = filtroTipoDonacion,
                FechaDesde = rangoFechas?.Start,
                FechaHasta = rangoFechas?.End,
                Pagina = estado.Page,
                TamanoPagina = estado.PageSize
            });
        }
        catch (Exception)
        {
            resultado = new HistorialDonacionesResultadoDto();
            Snackbar.Add("No se pudo cargar el historial de donaciones. Intente de nuevo.", Severity.Error);
        }

        // El total de arriba está fuera de la grilla: ella se vuelve a dibujar sola al
        // recibir la página, pero la pantalla no.
        StateHasChanged();

        return new GridData<HistorialDonacionDto>
        {
            Items = resultado.Donaciones,
            TotalItems = resultado.TotalRegistros
        };
    }

    // Al cambiar un filtro se vuelve a la primera página: la que se estaba viendo
    // puede no existir con el filtro nuevo (y quedaría vacía).
    //
    // NavigateTo cambia CurrentPage, y el setter de CurrentPage ya dispara
    // ServerData por dentro. Por eso solo se recarga a mano en la otra rama: así el
    // cambio de filtro cuesta una sola consulta y no dos.
    private async Task RecargarAsync()
    {
        if (grilla is null)
            return;

        if (grilla.CurrentPage != 0)
            grilla.NavigateTo(Page.First);
        else
            await grilla.ReloadServerData();
    }
}
