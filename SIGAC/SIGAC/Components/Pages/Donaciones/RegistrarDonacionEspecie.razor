@page "/donaciones/especie/registrar"
@attribute [Authorize(Policy = Permisos.Donaciones.RegistrarEspecie)]
@using SIGAC.Application.DTOs
@using SIGAC.Application.DTOs.Donaciones
@using SIGAC.Application.DTOs.Inventario
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IDonantesService DonantesService
@inject IDonacionesService DonacionesService
@inject IInventarioService InventarioService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Registrar donación en especie</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            <MudAutocomplete T="DonanteListaDto" Label="Donante" Variant="Variant.Outlined"
                              Value="donanteSeleccionado" ValueChanged="OnDonanteSeleccionadoAsync"
                              SearchFunc="BuscarDonantesActivosAsync" ToStringFunc="@(d => d?.Nombre)"
                              MinCharacters="1" DebounceInterval="300" Clearable="true"
                              Disabled="panelNuevoDonanteAbierto"
                              HelperText="Escriba para buscar un donante ya registrado." />

            <MudExpansionPanels Class="mt-4">
                <MudExpansionPanel Text="Registrar donante nuevo" Expanded="panelNuevoDonanteAbierto" ExpandedChanged="OnPanelNuevoDonanteCambiadoAsync">
                    <MudTextField @bind-Value="nuevoDonante.Nombre" Label="Nombre" Variant="Variant.Outlined" />
                    <MudSelect T="string" @bind-Value="nuevoDonante.TipoPersona" Label="Tipo de persona" Variant="Variant.Outlined" Class="mt-4">
                        @foreach (var tipo in TiposPersonaDonante.Todos)
                        {
                            <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
                        }
                    </MudSelect>
                    <PhoneInput @bind-Value="nuevoDonante.Telefono" @bind-CodigoPais="nuevoDonante.CodigoPaisTelefono" Label="Teléfono (opcional)" Class="mt-4" />
                    <MudTextField @bind-Value="nuevoDonante.Correo" Label="Correo (opcional)" Variant="Variant.Outlined" Class="mt-4" />
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudDatePicker @bind-Date="fecha" Label="Fecha" Variant="Variant.Outlined" Class="mt-4" MaxDate="DateTime.Today" />
            <MudTextField @bind-Value="modelo.Observaciones" Label="Observaciones (opcional)" Variant="Variant.Outlined" Class="mt-4" Lines="2" />

            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">Artículos donados</MudText>

            @for (var i = 0; i < modelo.Articulos.Count; i++)
            {
                var indice = i;
                var articulo = modelo.Articulos[indice];

                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    @* Al salir del campo se busca el nombre en el inventario. Si el artículo
                       ya existe, la donación va a sumar a ESE artículo y a guardar SU
                       categoría y unidad (Inventario es quien decide), así que se
                       precargan y se bloquean para que lo que se ve sea lo que se guarda. *@
                    <MudTextField @bind-Value="articulo.NombreArticulo" @bind-Value:after="() => OnNombreArticuloCambiadoAsync(articulo)"
                                  Label="Nombre del artículo" Variant="Variant.Outlined" />

                    @if (existentePorLinea.TryGetValue(articulo, out var existente))
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            Ya existe este artículo en el inventario (stock actual: @existente.StockActual @existente.UnidadMedida).
                            Se usará su categoría y unidad de medida registradas.
                        </MudAlert>
                    }

                    <MudSelect T="string" Value="articulo.Categoria" ValueChanged="@(valor => OnCategoriaCambiada(indice, valor))"
                               Label="Categoría" Variant="Variant.Outlined" Class="mt-4"
                               Disabled="TieneCoincidencias(articulo)">
                        @foreach (var categoria in CategoriasArticulo.Todos)
                        {
                            <MudSelectItem T="string" Value="@categoria">@categoria</MudSelectItem>
                        }
                    </MudSelect>

                    @* Estado del Equipo donado: es el que llevará el artículo al entrar
                       al inventario, donde forma parte de su identidad. Solo aparece
                       para Equipo; el servicio lo exige ahí y lo descarta en el resto. *@
                    @if (EstadosArticulo.AplicaACategoria(articulo.Categoria))
                    {
                        <MudSelect T="string" @bind-Value="articulo.Estado" @bind-Value:after="() => ResolverExistente(articulo)"
                                   Label="Estado" Variant="Variant.Outlined" Class="mt-4"
                                   Required="true" HelperText="Obligatorio para Equipo.">
                            @foreach (var estado in EstadosArticulo.Todos)
                            {
                                <MudSelectItem T="string" Value="@estado">@estado</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    @* Mismas opciones que valida el servicio: filtradas por la categoría
                       elegida en esta línea, igual que en Inventario. *@
                    <MudSelect T="string" @bind-Value="articulo.UnidadMedida" Label="Unidad de medida" Variant="Variant.Outlined" Class="mt-4"
                               Disabled="@(string.IsNullOrWhiteSpace(articulo.Categoria) || existentePorLinea.ContainsKey(articulo))"
                               HelperText="@(string.IsNullOrWhiteSpace(articulo.Categoria) ? "Elija primero una categoría." : null)">
                        @foreach (var unidad in UnidadesMedidaArticulo.ObtenerUnidadesValidas(articulo.Categoria))
                        {
                            <MudSelectItem T="string" Value="@unidad">@unidad</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="int" @bind-Value="articulo.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Class="mt-4" Min="1" />

                    <MudButton Variant="Variant.Text" Color="Color.Error" Class="mt-2"
                               Disabled="modelo.Articulos.Count == 1"
                               OnClick="@(() => EliminarArticulo(indice))">
                        Quitar artículo
                    </MudButton>
                </MudPaper>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AgregarArticulo">Agregar artículo</MudButton>
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="guardando" Class="ml-2 mb-2">Guardar</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Href="/donaciones/historial" Class="mb-2">Cancelar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    // Se levanta antes del primer await y se baja en el finally: un doble clic
    // rápido dispara Guardar dos veces antes de que el servidor responda, y la
    // segunda llamada repetiría el registro (y, donde corresponde, el movimiento
    // de stock).
    private bool guardando;

    private DonacionEspecieCrearDto modelo = new();
    private DonanteListaDto? donanteSeleccionado;
    private bool panelNuevoDonanteAbierto;
    private NuevoDonanteDto nuevoDonante = new();

    // Filas del catálogo cuyo nombre coincide con el escrito en cada línea (una si no
    // es Equipo, una por estado si lo es), y la que además coincide con su estado: el
    // artículo al que realmente va a sumar la línea. Mismo criterio que
    // RegistrarEntradaInventario.
    private readonly Dictionary<DetalleArticuloDto, List<ArticuloExistenciaDto>> coincidenciasPorLinea = new();
    private readonly Dictionary<DetalleArticuloDto, ArticuloExistenciaDto> existentePorLinea = new();

    private bool TieneCoincidencias(DetalleArticuloDto articulo) =>
        coincidenciasPorLinea.TryGetValue(articulo, out var coincidencias) && coincidencias.Count > 0;

    private async Task OnNombreArticuloCambiadoAsync(DetalleArticuloDto articulo)
    {
        coincidenciasPorLinea.Remove(articulo);

        if (!string.IsNullOrWhiteSpace(articulo.NombreArticulo))
        {
            try
            {
                var nombre = articulo.NombreArticulo.Trim();
                var existencias = await InventarioService.ObtenerExistenciasAsync(new FiltrosExistenciaDto { Nombre = nombre });

                coincidenciasPorLinea[articulo] = existencias.Elementos
                    .Where(a => string.Equals(a.Nombre, nombre, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            catch (Exception)
            {
                // La precarga es una ayuda: si la consulta falla no se bloquea el
                // formulario, porque el servidor resuelve el artículo igual al guardar.
            }
        }

        ResolverExistente(articulo);
    }

    private void ResolverExistente(DetalleArticuloDto articulo)
    {
        existentePorLinea.Remove(articulo);

        if (!coincidenciasPorLinea.TryGetValue(articulo, out var coincidencias) || coincidencias.Count == 0)
            return;

        // Todas las filas de un mismo nombre son de la misma categoría.
        var hermano = coincidencias[0];
        articulo.Categoria = hermano.Categoria;

        var existente = EstadosArticulo.AplicaACategoria(hermano.Categoria)
            ? coincidencias.FirstOrDefault(a => a.Estado == articulo.Estado)
            : hermano;

        if (existente is not null)
        {
            articulo.Estado = existente.Estado;
            articulo.UnidadMedida = existente.UnidadMedida;
            existentePorLinea[articulo] = existente;
        }
        else if (string.IsNullOrWhiteSpace(articulo.UnidadMedida))
        {
            // Estado nuevo de un Equipo que ya existe: se parte de la unidad de sus
            // hermanos, que el usuario todavía puede cambiar.
            articulo.UnidadMedida = hermano.UnidadMedida;
        }
    }

    private DateTime? fecha
    {
        get => modelo.Fecha == default ? null : modelo.Fecha;
        set => modelo.Fecha = value ?? default;
    }

    protected override void OnInitialized()
    {
        modelo.Fecha = DateTime.Today;
        modelo.Articulos.Add(new DetalleArticuloDto());
    }

    private async Task<IEnumerable<DonanteListaDto>> BuscarDonantesActivosAsync(string valor, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return Array.Empty<DonanteListaDto>();

        var resultado = await DonantesService.ObtenerDonantesAsync(new FiltrosDonanteDto
        {
            Nombre = valor,
            Estado = true
        });

        return resultado.Elementos;
    }

    private Task OnDonanteSeleccionadoAsync(DonanteListaDto? valor)
    {
        donanteSeleccionado = valor;

        if (valor is not null && panelNuevoDonanteAbierto)
        {
            panelNuevoDonanteAbierto = false;
            nuevoDonante = new();
        }

        return Task.CompletedTask;
    }

    private Task OnPanelNuevoDonanteCambiadoAsync(bool abierto)
    {
        panelNuevoDonanteAbierto = abierto;

        if (abierto)
        {
            donanteSeleccionado = null;
        }

        return Task.CompletedTask;
    }

    // Al cambiar de categoría, la unidad ya elegida en ESA línea puede dejar de
    // pertenecer a la nueva lista. Mismo criterio que RegistrarEntradaInventario.
    private void OnCategoriaCambiada(int indice, string? categoria)
    {
        var articulo = modelo.Articulos[indice];
        articulo.Categoria = categoria ?? string.Empty;

        if (!UnidadesMedidaArticulo.EsValidaParaCategoria(articulo.Categoria, articulo.UnidadMedida))
            articulo.UnidadMedida = string.Empty;

        if (!EstadosArticulo.AplicaACategoria(articulo.Categoria))
            articulo.Estado = null;
    }

    private void AgregarArticulo()
    {
        modelo.Articulos.Add(new DetalleArticuloDto());
    }

    private void EliminarArticulo(int indice)
    {
        // Siempre queda al menos una línea: una donación en especie sin artículos
        // no registra nada, mismo mínimo que exige el servicio.
        if (modelo.Articulos.Count > 1)
        {
            var quitado = modelo.Articulos[indice];
            coincidenciasPorLinea.Remove(quitado);
            existentePorLinea.Remove(quitado);
            modelo.Articulos.RemoveAt(indice);
        }
    }

    private async Task Guardar()
    {
        modelo.DonanteId = panelNuevoDonanteAbierto ? null : donanteSeleccionado?.Id;
        modelo.NuevoDonante = panelNuevoDonanteAbierto ? nuevoDonante : null;

        if (guardando)
            return;

        guardando = true;

        try
        {
            await DonacionesService.RegistrarDonacionEspecieAsync(modelo);
            Snackbar.Add("Donación registrada correctamente.", Severity.Success);

            modelo = new() { Fecha = DateTime.Today };
            modelo.Articulos.Add(new DetalleArticuloDto());
            coincidenciasPorLinea.Clear();
            existentePorLinea.Clear();
            donanteSeleccionado = null;
            panelNuevoDonanteAbierto = false;
            nuevoDonante = new();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar la donación. Intente de nuevo.", Severity.Error);
        }
        finally
        {
            guardando = false;
        }
    }
}
