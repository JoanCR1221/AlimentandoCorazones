@page "/usuarios"
@attribute [Authorize(Policy = Permisos.Seguridad.GestionarUsuarios)]
@using System.Security.Claims
@using SIGAC.Application.DTOs.Seguridad
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@inject IUsuariosService UsuariosService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Usuarios — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Usuarios del sistema" Descripcion="Administre los usuarios del sistema, sus roles y sus permisos.">
    <Acciones>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/usuarios/registrar"
                   StartIcon="@Icons.Material.Filled.PersonAdd">
            Registrar usuario
        </MudButton>
    </Acciones>
</EncabezadoPagina>

<MudCard Class="pa-4">
    <MudCardContent>
        <MudTextField T="string" Value="filtroTexto" ValueChanged="OnFiltroTextoCambiado" Immediate="true" DebounceInterval="300"
                      Label="Buscar por nombre o correo" Variant="Variant.Outlined" Class="mb-4" />
        @* Lista cerrada: la fuente es SIGAC.Domain.RolesSistema, no la pantalla. *@
        <MudSelect T="string" Value="filtroRol" ValueChanged="OnFiltroRolCambiado" Label="Rol" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            @foreach (var rol in RolesSistema.Todos)
            {
                <MudSelectItem T="string" Value="@rol">@rol</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="bool?" Value="filtroEstado" ValueChanged="OnFiltroEstadoCambiado" Label="Estado" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            <MudSelectItem T="bool?" Value="true">Activo</MudSelectItem>
            <MudSelectItem T="bool?" Value="false">Inactivo</MudSelectItem>
        </MudSelect>

        @* Items y no ServerData: el listado completo cabe en memoria (decenas de
           usuarios) y el filtrado ya lo hace el servicio en SQL. *@
        @* Una sola grilla para los tres tamaños (ver ListadoBeneficiarios): en móvil
           (< 768px) solo se ve la celda "tarjeta"; en tableta y laptop chico, sin
           Registrado (va en el "Ver más" bajo el nombre); en escritorio, las
           seis columnas. *@
        <MudDataGrid T="UsuarioListaDto" Items="@usuarios" Loading="cargando"
                     Class="ac-grilla-tarjetas" Breakpoint="Breakpoint.None"
                     SortMode="SortMode.None" Filterable="false" Dense="true">
            <Columns>
                <TemplateColumn Title="Nombre" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        @context.Item.Nombre
                        <VerMasTabla>
                            <dt>Registrado</dt>
                            <dd>@context.Item.FechaRegistro.ToString("dd/MM/yyyy")</dd>
                        </VerMasTabla>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Correo" Title="Correo" CellClass="ac-col-clasica ac-celda-larga" HeaderClass="ac-col-clasica" />
                <PropertyColumn Property="x => x.Rol" Title="Rol" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <TemplateColumn Title="Estado" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        @EstadoDelUsuario(context.Item)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.FechaRegistro" Title="Registrado" Format="dd/MM/yyyy" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio" />
                <TemplateColumn Title="Acciones" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        @MenuAcciones(context.Item, false)
                    </CellTemplate>
                </TemplateColumn>
                @* Solo móvil: nombre y estado arriba, el correo (enlace para escribir)
                   y el rol siempre a la vista, la fecha de registro en "Ver más" y
                   el menú de acciones al pie, a todo el ancho. *@
                <TemplateColumn Title="Usuario" CellClass="ac-col-tarjeta" HeaderClass="ac-col-tarjeta">
                    <CellTemplate>
                        <TarjetaFila Titulo="@context.Item.Nombre">
                            <Estado>
                                @EstadoDelUsuario(context.Item)
                            </Estado>
                            <Lineas>
                                @if (!string.IsNullOrWhiteSpace(context.Item.Rol))
                                {
                                    <p class="ac-tarjeta-dato">@context.Item.Rol</p>
                                }
                                <EnlaceContacto Correo="@context.Item.Correo" />
                            </Lineas>
                            <Detalle>
                                <dt>Registrado</dt>
                                <dd>@context.Item.FechaRegistro.ToString("dd/MM/yyyy")</dd>
                            </Detalle>
                            <Acciones>
                                @MenuAcciones(context.Item, true)
                            </Acciones>
                        </TarjetaFila>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ningún usuario coincide con los filtros"
                                 Descripcion="Pruebe con otro nombre, correo, rol o estado." />
                }
                else
                {
                    @* Sin filtros no se consulta nada: se invita a buscar. *@
                    <EstadoVacio Icono="@Icons.Material.Filled.ManageAccounts"
                                 Titulo="Busque por nombre o correo, o elija un rol o un estado"
                                 Descripcion="Así se consultan solo los usuarios que necesita, sin cargar la lista completa." />
                }
            </NoRecordsContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    // Activo, inactivo o bloqueado temporalmente: la misma etiqueta en la tabla y
    // en la tarjeta de móvil.
    private RenderFragment EstadoDelUsuario(UsuarioListaDto item) => @<text>
        @if (!item.Estado)
        {
            <EstadoChip Activo="false" />
        }
        else if (item.BloqueadoTemporalmente)
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Lock"
                     title="@($"Demasiados intentos fallidos. El bloqueo dura {ReglasUsuario.MinutosBloqueo} minutos; restablecer la contraseña lo levanta.")">
                Bloqueado temporalmente
            </MudChip>
        }
        else
        {
            <EstadoChip Activo="true" />
        }
    </text>;

    // Un menú por fila y no cuatro botones. En la tarjeta de móvil el menú es
    // del tamaño normal y app.css lo estira a todo el ancho.
    private RenderFragment MenuAcciones(UsuarioListaDto item, bool tarjeta) => @<text>
        @{
            // El servicio rechaza igual estas acciones sobre uno mismo;
            // deshabilitarlas evita mostrar un error que ya se conoce.
            var esElMismo = item.Id == idUsuarioActual;
        }
        @* Un menú por fila y no cuatro botones: la columna no cabe en
           pantallas angostas y las acciones son poco frecuentes. *@
        <MudMenu Label="Acciones" Variant="Variant.Outlined" Color="Color.Primary" Size="@(tarjeta ? Size.Medium : Size.Small)"
                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                 AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                 aria-label="@($"Acciones para {item.Nombre}")">
            <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" Disabled="esElMismo"
                         OnClick="@(() => CambiarRolAsync(item))">
                Cambiar rol
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Tune"
                         Href="@($"/usuarios/{item.Id}/permisos")"
                         Disabled="@(!PermisosPorRol.AdmiteRevocaciones(item.Rol))">
                Permisos
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LockReset" Disabled="esElMismo"
                         OnClick="@(() => RestablecerPasswordAsync(item))">
                Restablecer contraseña
            </MudMenuItem>
            <MudDivider />
            @if (item.Estado)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Block" IconColor="Color.Error" Disabled="esElMismo"
                             OnClick="@(() => ConfirmarCambioEstadoAsync(item, false))">
                    Desactivar
                </MudMenuItem>
            }
            else
            {
                <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success"
                             OnClick="@(() => ConfirmarCambioEstadoAsync(item, true))">
                    Activar
                </MudMenuItem>
            }
            @if (esElMismo)
            {
                <MudDivider />
                <MudMenuItem Disabled="true">Su propio usuario: cambie su contraseña desde Configuración.</MudMenuItem>
            }
        </MudMenu>
    </text>;

    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private IReadOnlyList<UsuarioListaDto> usuarios = Array.Empty<UsuarioListaDto>();
    private bool cargando;
    private string? idUsuarioActual;

    private string? filtroTexto;
    private string? filtroRol;
    private bool? filtroEstado;

    private bool HayFiltro =>
        !string.IsNullOrWhiteSpace(filtroTexto) || !string.IsNullOrWhiteSpace(filtroRol) || filtroEstado.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is not null)
        {
            var estado = await EstadoAutenticacion;
            idUsuarioActual = estado.User.FindFirstValue(ClaimTypes.NameIdentifier);
        }

        // No se carga la lista acá: la pantalla abre sin consultar usuarios,
        // igual que ListadoProyectos. Se consulta al elegir un filtro.
    }

    private async Task CargarAsync()
    {
        // Sin ningún criterio no se va a la base. Cubre también quitar todos los
        // filtros: la grilla se vacía en vez de traer todos los usuarios.
        if (!HayFiltro)
        {
            usuarios = Array.Empty<UsuarioListaDto>();
            return;
        }

        cargando = true;

        try
        {
            usuarios = await UsuariosService.ObtenerUsuariosAsync(new FiltrosUsuarioDto
            {
                Texto = filtroTexto,
                Rol = filtroRol,
                Estado = filtroEstado
            });
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudieron cargar los usuarios. Intente de nuevo.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task OnFiltroTextoCambiado(string? valor)
    {
        filtroTexto = valor;
        await CargarAsync();
    }

    private async Task OnFiltroRolCambiado(string? valor)
    {
        filtroRol = valor;
        await CargarAsync();
    }

    private async Task OnFiltroEstadoCambiado(bool? valor)
    {
        filtroEstado = valor;
        await CargarAsync();
    }

    private async Task CambiarRolAsync(UsuarioListaDto usuario)
    {
        var parametros = new DialogParameters<CambiarRolDialog>
        {
            { d => d.NombreUsuario, usuario.Nombre },
            { d => d.RolActual, usuario.Rol }
        };

        var dialogo = await DialogService.ShowAsync<CambiarRolDialog>("Cambiar rol", parametros);
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled || resultado.Data is not string nuevoRol)
            return;

        await EjecutarAsync(
            () => UsuariosService.CambiarRolAsync(new CambioRolDto { UsuarioId = usuario.Id, NuevoRol = nuevoRol }),
            $"Rol de {usuario.Nombre} cambiado a {nuevoRol}. Su sesión se cierra en menos de un minuto.",
            "No se pudo cambiar el rol. Intente de nuevo.");
    }

    private async Task ConfirmarCambioEstadoAsync(UsuarioListaDto usuario, bool activar)
    {
        var pregunta = activar
            ? $"¿Seguro que desea activar a {usuario.Nombre}? Va a poder iniciar sesión de inmediato."
            : $"¿Seguro que desea desactivar a {usuario.Nombre}? No va a poder iniciar sesión y, si tiene una sesión abierta, se cierra en menos de un minuto. Su historial se conserva.";

        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Confirmar",
            pregunta,
            yesText: activar ? "Activar" : "Desactivar",
            cancelText: "Cancelar");

        if (confirmado != true)
            return;

        await EjecutarAsync(
            () => activar ? UsuariosService.ActivarUsuarioAsync(usuario.Id) : UsuariosService.DesactivarUsuarioAsync(usuario.Id),
            activar ? "Usuario activado." : "Usuario desactivado.",
            "No se pudo actualizar el estado del usuario. Intente de nuevo.");
    }

    private async Task RestablecerPasswordAsync(UsuarioListaDto usuario)
    {
        var parametros = new DialogParameters<RestablecerPasswordDialog>
        {
            { d => d.NombreUsuario, usuario.Nombre }
        };

        var dialogo = await DialogService.ShowAsync<RestablecerPasswordDialog>("Restablecer contraseña", parametros);
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled || resultado.Data is not RestablecerPasswordDto dto)
            return;

        dto.UsuarioId = usuario.Id;

        await EjecutarAsync(
            () => UsuariosService.RestablecerPasswordAsync(dto),
            $"Contraseña de {usuario.Nombre} restablecida. Indicale que la cambie desde Configuración al entrar.",
            "No se pudo restablecer la contraseña. Intente de nuevo.");
    }

    // Un solo lugar para el patrón "ejecutar, avisar, recargar": las cuatro
    // acciones del listado distinguen los mismos tipos de error.
    private async Task EjecutarAsync(Func<Task> accion, string mensajeExito, string mensajeError)
    {
        try
        {
            await accion();
            Snackbar.Add(mensajeExito, Severity.Success);
            await CargarAsync();
        }
        catch (UltimoAdministradorException ex)
        {
            // Mensaje específico (AB de fase 3): no es un error de datos, es una
            // regla del sistema que el administrador tiene que resolver antes.
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await CargarAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(mensajeError, Severity.Error);
        }
    }
}
