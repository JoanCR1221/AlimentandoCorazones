@using SIGAC.Application.DTOs.Seguridad

@* Contraseña temporal asignada por un administrador. Devuelve un
   RestablecerPasswordDto sin UsuarioId (lo completa el listado). *@
<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">
            Va a asignarle una contraseña temporal a <strong>@NombreUsuario</strong>.
            Si tenía una sesión abierta se cierra, y si estaba bloqueado por intentos fallidos, se desbloquea.
        </MudText>

        <MudTextField @bind-Value="modelo.PasswordTemporal" Label="Contraseña temporal" Variant="Variant.Outlined"
                      InputType="@(mostrar ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(mostrar ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      AdornmentAriaLabel="Mostrar u ocultar la contraseña"
                      OnAdornmentClick="@(() => mostrar = !mostrar)"
                      HelperText="@ReglasUsuario.DescripcionReglasPassword" />

        <MudTextField @bind-Value="modelo.ConfirmarPassword" Label="Repetir contraseña temporal" Variant="Variant.Outlined" Class="mt-4"
                      InputType="@(mostrar ? InputType.Text : InputType.Password)" />

        <MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary">
            Entréguesela en persona y pídale que la cambie desde Configuración al entrar.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirmar"
                   Disabled="@(string.IsNullOrEmpty(modelo.PasswordTemporal) || string.IsNullOrEmpty(modelo.ConfirmarPassword))">
            Restablecer
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string NombreUsuario { get; set; } = string.Empty;

    private readonly RestablecerPasswordDto modelo = new();
    private bool mostrar;

    private void Cancelar() => MudDialog.Cancel();

    private void Confirmar() => MudDialog.Close(DialogResult.Ok(modelo));
}
