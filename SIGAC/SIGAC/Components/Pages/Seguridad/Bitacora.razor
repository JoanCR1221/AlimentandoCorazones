@page "/bitacora"
@attribute [Authorize(Policy = Permisos.Seguridad.VerBitacora)]
@using SIGAC.Application.DTOs
@using SIGAC.Application.DTOs.Bitacora
@using SIGAC.Application.DTOs.Seguridad
@using SIGAC.Application.Interfaces
@inject IBitacoraService BitacoraService
@inject IUsuariosService UsuariosService
@inject ISnackbar Snackbar

<PageTitle>Bitácora — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Bitácora de acciones"
                  Descripcion="Registro de todo lo que se hizo en el sistema: quién, qué, en qué módulo y cuándo. Es de solo lectura: ninguna fila se puede editar ni borrar." />

<MudCard Class="pa-4">
    <MudCardContent>
        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="12" md="4">
                @* Autocompletado sobre la lista completa de usuarios (decenas, no
                   miles): filtra en memoria por nombre o correo. *@
                <MudAutocomplete T="UsuarioListaDto" Value="filtroUsuario" ValueChanged="OnFiltroUsuarioCambiado"
                                 SearchFunc="BuscarUsuariosAsync" ToStringFunc="@(u => u is null ? string.Empty : $"{u.Nombre} ({u.Correo})")"
                                 Label="Usuario" Variant="Variant.Outlined" Clearable="true" ResetValueOnEmptyText="true"
                                 CoerceText="false" MaxItems="20" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Value="filtroRol" ValueChanged="OnFiltroRolCambiado" Label="Rol" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var rol in RolesSistema.Todos)
                    {
                        <MudSelectItem T="string" Value="@rol">@rol</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Value="filtroModulo" ValueChanged="OnFiltroModuloCambiado" Label="Módulo" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var modulo in ModulosSistema.Todos)
                    {
                        <MudSelectItem T="string" Value="@modulo">@modulo</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDateRangePicker DateRange="rangoFechas" DateRangeChanged="OnRangoFechasCambiado"
                                    Label="Rango de fechas" Variant="Variant.Outlined" Clearable="true"
                                    DateFormat="dd/MM/yyyy" MaxDate="DateTime.Today" />
            </MudItem>
        </MudGrid>

        @* ServerData: la bitácora crece con cada operación del sistema, así que
           siempre se pide una página por vez. HierarchyColumn para desplegar el
           detalle completo de una fila sin ensanchar la tabla. *@
        @* Una sola grilla para los tres tamaños (ver ListadoBeneficiarios): en móvil
           (< 768px) solo se ve la celda "tarjeta", con el detalle completo en su
           "Ver más" (ahí no se usa la fila desplegable); en tableta y laptop chico,
           sin Rol (va en chico bajo el usuario) ni el resumen del Detalle (el
           detalle completo sigue en la fila desplegable); en escritorio, todas las
           columnas. Dense se queda: en tableta y en la tarjeta, app.css le corrige
           el relleno. *@
        <MudDataGrid T="BitacoraAccionDto" @ref="grilla" Class="ac-grilla-tarjetas" Breakpoint="Breakpoint.None"
                     ServerData="CargarPaginaAsync"
                     RowsPerPage="FiltrosBitacoraDto.TamanoPaginaPredeterminado"
                     SortMode="SortMode.None" Filterable="false" Dense="true">
            <Columns>
                @* HierarchyColumn no acepta CellClass: en móvil app.css oculta su celda
                   (la reconoce por el botón de icono) y la fila hija. *@
                <HierarchyColumn T="BitacoraAccionDto" ButtonDisabledFunc="@(x => string.IsNullOrEmpty(x.Detalle))" HeaderClass="ac-col-clasica" />
                @* El encabezado puede partirse en dos líneas en tableta (la regla
                   general de app.css lo deja en una); en escritorio sigue en una. *@
                <PropertyColumn Property="x => x.Fecha" Title="Fecha y hora" Format="dd/MM/yyyy HH:mm" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" HeaderStyle="white-space: normal" />
                @* En tableta la columna Rol se oculta y el rol va en chico bajo el
                   nombre (.ac-solo-tableta), sin un "Ver más": la fila ya tiene su
                   propio botón para desplegar. El nombre puede ser el correo de un
                   inicio de sesión fallido (hasta 256 caracteres): parte la línea. *@
                <TemplateColumn Title="Usuario" CellClass="ac-col-clasica ac-celda-larga" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        @context.Item.NombreUsuario
                        @if (!string.IsNullOrWhiteSpace(context.Item.Rol))
                        {
                            <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary ac-solo-tableta">@context.Item.Rol</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Rol" Title="Rol" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio" />
                <PropertyColumn Property="x => x.Accion" Title="Acción" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <PropertyColumn Property="x => x.Modulo" Title="Módulo" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <TemplateColumn Title="Detalle" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio">
                    <CellTemplate>
                        <span title="@context.Item.Detalle">@Resumir(context.Item.Detalle)</span>
                    </CellTemplate>
                </TemplateColumn>
                @* Solo móvil: el usuario arriba con el módulo como etiqueta; la fecha y
                   hora, la acción y el rol siempre a la vista, y el detalle completo
                   en "Ver más", que no aparece si la acción no tiene detalle (igual
                   que el botón de desplegar de la tabla, que queda deshabilitado). *@
                <TemplateColumn Title="Acción registrada" CellClass="ac-col-tarjeta" HeaderClass="ac-col-tarjeta">
                    <CellTemplate>
                        <TarjetaFila Titulo="@context.Item.NombreUsuario"
                                     Detalle="@(string.IsNullOrEmpty(context.Item.Detalle) ? null : DetalleCompleto(context.Item))">
                            <Estado>
                                <span class="ac-tarjeta-etiqueta">@context.Item.Modulo</span>
                            </Estado>
                            <Lineas>
                                <p class="ac-tarjeta-dato">@context.Item.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="ac-tarjeta-dato">Acción: @context.Item.Accion</p>
                                @if (!string.IsNullOrWhiteSpace(context.Item.Rol))
                                {
                                    <p class="ac-tarjeta-dato">Rol: @context.Item.Rol</p>
                                }
                            </Lineas>
                        </TarjetaFila>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowContent>
                <MudText Typo="Typo.body2" Class="pa-2" Style="white-space: pre-wrap;">@context.Item.Detalle</MudText>
            </ChildRowContent>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ninguna acción coincide con los filtros"
                                 Descripcion="Pruebe con otro usuario, rol, módulo o rango de fechas." />
                }
                else
                {
                    @* Sin filtros no se consulta nada: se invita a buscar. *@
                    <EstadoVacio Icono="@Icons.Material.Filled.History"
                                 Titulo="Elija un usuario, rol, módulo o rango de fechas"
                                 Descripcion="Así se consultan solo las acciones que necesita, sin cargar la bitácora completa." />
                }
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="BitacoraAccionDto"
                                  PageSizeOptions="@(new[] { FiltrosBitacoraDto.TamanoPaginaPredeterminado, 50, FiltrosBitacoraDto.TamanoPaginaMaximo })" />
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private const int LargoResumenDetalle = 70;

    private MudDataGrid<BitacoraAccionDto>? grilla;

    private IReadOnlyList<UsuarioListaDto> usuarios = Array.Empty<UsuarioListaDto>();

    private UsuarioListaDto? filtroUsuario;
    private string? filtroRol;
    private string? filtroModulo;
    private DateRange? rangoFechas;

    private bool HayFiltro =>
        filtroUsuario is not null || !string.IsNullOrWhiteSpace(filtroRol) ||
        !string.IsNullOrWhiteSpace(filtroModulo) || rangoFechas is not null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            usuarios = await UsuariosService.ObtenerUsuariosAsync(new FiltrosUsuarioDto());
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo cargar la lista de usuarios para el filtro.", Severity.Warning);
        }
    }

    private async Task<GridData<BitacoraAccionDto>> CargarPaginaAsync(
        GridState<BitacoraAccionDto> estado, CancellationToken cancellationToken)
    {
        // La pantalla abre sin consultar la bitácora: sin ningún criterio
        // no se va a la base y la grilla queda vacía, con la invitación a buscar.
        // Mismo criterio que ListadoGastos. Cubre también quitar todos los filtros.
        if (!HayFiltro)
            return new GridData<BitacoraAccionDto> { Items = Array.Empty<BitacoraAccionDto>(), TotalItems = 0 };

        try
        {
            var resultado = await BitacoraService.ObtenerBitacoraAsync(new FiltrosBitacoraDto
            {
                UsuarioId = filtroUsuario?.Id,
                Rol = filtroRol,
                Modulo = filtroModulo,
                FechaDesde = rangoFechas?.Start,
                FechaHasta = rangoFechas?.End,
                Pagina = estado.Page,
                TamanoPagina = estado.PageSize
            });

            return new GridData<BitacoraAccionDto>
            {
                Items = resultado.Elementos,
                TotalItems = resultado.TotalRegistros
            };
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo cargar la bitácora. Intente de nuevo.", Severity.Error);
            return new GridData<BitacoraAccionDto> { Items = Array.Empty<BitacoraAccionDto>(), TotalItems = 0 };
        }
    }

    private Task<IEnumerable<UsuarioListaDto>> BuscarUsuariosAsync(string? texto, CancellationToken cancellationToken)
    {
        IEnumerable<UsuarioListaDto> coincidencias = string.IsNullOrWhiteSpace(texto)
            ? usuarios
            : usuarios.Where(u =>
                u.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || u.Correo.Contains(texto, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(coincidencias);
    }

    private async Task OnFiltroUsuarioCambiado(UsuarioListaDto? valor)
    {
        filtroUsuario = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroRolCambiado(string? valor)
    {
        filtroRol = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroModuloCambiado(string? valor)
    {
        filtroModulo = valor;
        await RecargarAsync();
    }

    private async Task OnRangoFechasCambiado(DateRange? valor)
    {
        rangoFechas = valor;
        await RecargarAsync();
    }

    // Al cambiar un filtro se vuelve a la primera página (mismo criterio que
    // ListadoBeneficiarios): la página actual puede no existir con el filtro nuevo.
    private async Task RecargarAsync()
    {
        if (grilla is null)
            return;

        if (grilla.CurrentPage != 0)
            grilla.NavigateTo(Page.First);
        else
            await grilla.ReloadServerData();
    }

    private static string Resumir(string? detalle)
    {
        if (string.IsNullOrEmpty(detalle))
            return string.Empty;

        return detalle.Length <= LargoResumenDetalle ? detalle : detalle[..LargoResumenDetalle] + "…";
    }

    // El detalle completo en el "Ver más" de la tarjeta de móvil, con sus saltos
    // de línea, como en la fila desplegable de la tabla. Solo se pasa cuando hay
    // detalle: sin él, TarjetaFila no pinta el "Ver más".
    private RenderFragment DetalleCompleto(BitacoraAccionDto accion) => @<text>
        <dt>Detalle</dt>
        <dd style="white-space: pre-wrap;">@accion.Detalle</dd>
    </text>;
}
