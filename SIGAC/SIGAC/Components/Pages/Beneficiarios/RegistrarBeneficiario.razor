@page "/beneficiarios/registrar"
@attribute [Authorize(Policy = Permisos.Beneficiarios.Registrar)]
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@using SIGAC.Infrastructure.Identity
@inject IBeneficiariosService BeneficiariosService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Registrar beneficiario</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <MudCard Class="pa-4">
        <MudCardContent>
            <MudTextField @bind-Value="modelo.PrimerNombre" For="@(() => modelo.PrimerNombre)" Label="Primer nombre" Variant="Variant.Outlined"
                          MaxLength="ReglasBeneficiario.LongitudMaximaNombre" />
            <MudTextField @bind-Value="modelo.SegundoNombre" Label="Segundo nombre (opcional)" Variant="Variant.Outlined" Class="mt-4"
                          MaxLength="ReglasBeneficiario.LongitudMaximaNombre" />
            <MudTextField @bind-Value="modelo.PrimerApellido" For="@(() => modelo.PrimerApellido)" Label="Primer apellido" Variant="Variant.Outlined" Class="mt-4"
                          MaxLength="ReglasBeneficiario.LongitudMaximaApellido" />
            <MudTextField @bind-Value="modelo.SegundoApellido" Label="Segundo apellido (opcional)" Variant="Variant.Outlined" Class="mt-4"
                          MaxLength="ReglasBeneficiario.LongitudMaximaApellido" />
            <MudDatePicker @bind-Date="fechaNacimiento" Label="Fecha de nacimiento" Variant="Variant.Outlined" Class="mt-4" MaxDate="DateTime.Today" />

            @* La categoría ya no se elige: se deriva de la fecha de nacimiento. *@
            @if (modelo.FechaNacimiento != default)
            {
                <MudText Typo="Typo.body2" Class="mt-2">
                    Categoría: @CategoriasBeneficiario.DerivarDesdeFechaNacimiento(modelo.FechaNacimiento)
                </MudText>
            }

            <PhoneInput @bind-Value="modelo.Telefono" @bind-CodigoPais="modelo.CodigoPaisTelefono"
                        Label="Teléfono (opcional)" Class="mt-4" />
            <MudTextField @bind-Value="modelo.Direccion" Label="Dirección (opcional)" Variant="Variant.Outlined" Class="mt-4"
                          MaxLength="ReglasBeneficiario.LongitudMaximaDireccion" Lines="2"
                          HelperText="@($"Máximo {ReglasBeneficiario.LongitudMaximaDireccion} caracteres. Ej: Del parque 150 metros suroeste, casa verde.")" />

            @* Lista cerrada: la fuente es SIGAC.Domain.TiposDocumento, no la pantalla. *@
            <MudSelect T="string" Value="modelo.TipoDocumento" ValueChanged="OnTipoDocumentoCambiado" Label="Tipo de documento" Variant="Variant.Outlined" Class="mt-4">
                @foreach (var tipo in TiposDocumento.Todos)
                {
                    <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
                }
            </MudSelect>

            @* "Otro" pide además cómo se llama el documento. *@
            @if (TiposDocumento.RequiereNombreDelDocumento(modelo.TipoDocumento))
            {
                <MudTextField @bind-Value="modelo.TipoDocumentoOtro" Label="¿Cómo se llama el documento?" Variant="Variant.Outlined" Class="mt-4"
                              MaxLength="ReglasBeneficiario.LongitudMaximaTipoDocumentoOtro" />
            }

            @* "Sin documento" no pide número: el campo se oculta.
               MaxLength, teclado y ayuda salen de ReglasBeneficiario según el tipo
               elegido, que es la misma fuente que usa el validador. Sin atributo
               pattern: el navegador bloqueaba el envío con su propio globo, y el
               filtro de OnNumIdentidadCambiado ya descarta lo que no corresponde. *@
            @if (TiposDocumento.RequiereNumIdentidad(modelo.TipoDocumento))
            {
                <MudTextField T="string" Value="modelo.NumIdentidad" ValueChanged="OnNumIdentidadCambiado" Immediate="true"
                              Label="Número de identidad" Variant="Variant.Outlined" Class="mt-4"
                              MaxLength="ReglasBeneficiario.LongitudMaximaNumIdentidadPara(modelo.TipoDocumento)"
                              InputMode="@ModoEntradaNumIdentidad"
                              HelperText="@ReglasBeneficiario.DescribirNumIdentidad(modelo.TipoDocumento)" />
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Href="/beneficiarios" Class="mb-2">Cancelar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private BeneficiarioCrearDto modelo = new();

    private DateTime? fechaNacimiento
    {
        get => modelo.FechaNacimiento == default ? null : modelo.FechaNacimiento;
        set => modelo.FechaNacimiento = value ?? default;
    }

    // Teclado numérico en móvil para los tipos que solo admiten dígitos.
    private InputMode ModoEntradaNumIdentidad =>
        ReglasBeneficiario.NumIdentidadEsSoloDigitos(modelo.TipoDocumento) ? InputMode.numeric : InputMode.text;

    // Descarta lo que no corresponde al tipo mientras se escribe. Es comodidad: el
    // validador del servidor vuelve a comprobar el valor completo igual que antes.
    private void OnNumIdentidadCambiado(string? valor)
    {
        var filtrado = ReglasBeneficiario.FiltrarNumIdentidad(modelo.TipoDocumento, valor);
        modelo.NumIdentidad = filtrado.Length == 0 ? null : filtrado;
    }

    private void OnTipoDocumentoCambiado(string? valor)
    {
        modelo.TipoDocumento = valor;

        // Al registrar el número se limpia SIEMPRE, aunque siguiera siendo válido
        // con las reglas del tipo nuevo (un DIMEX de 12 dígitos también pasa como
        // pasaporte). Nadie tiene el mismo número en dos documentos distintos, así
        // que conservarlo solo invita a guardarlo bajo el tipo equivocado.
        //
        // En EditarBeneficiario la regla es a propósito la contraria: allá hay un
        // dato real cargado y un clic accidental no debe hacerlo perder.
        modelo.NumIdentidad = null;

        if (!TiposDocumento.RequiereNombreDelDocumento(valor))
            modelo.TipoDocumentoOtro = null;
    }

    private async Task Guardar()
    {
        try
        {
            await BeneficiariosService.RegistrarBeneficiarioAsync(modelo);
            Snackbar.Add("Beneficiario registrado correctamente.", Severity.Success);
            modelo = new();
        }
        catch (BeneficiarioDuplicadoException ex)
        {
            await AvisarDuplicadoAsync(ex);
        }
        catch (Exception ex) when (ex is ValidationException or DuplicateException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (BitacoraNoRegistradaException ex)
        {
            // El alta sí quedó guardada: se limpia el formulario igual que en el
            // caso exitoso, para que no se reintente y choque consigo misma.
            Snackbar.Add(ex.Message, Severity.Warning);
            modelo = new();
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo registrar el beneficiario. Intente de nuevo.", Severity.Error);
        }
    }

    // El aviso de duplicado ofrece ir al registro que ya existe, o reactivarlo si
    // está inactivo, en vez de dejar que se cargue a la misma persona de nuevo.
    // Cada acción aparece solo si el usuario tiene el permiso que la respalda.
    private async Task AvisarDuplicadoAsync(BeneficiarioDuplicadoException ex)
    {
        var usuario = EstadoAutenticacion is null ? null : (await EstadoAutenticacion).User;
        bool Tiene(string permiso) => usuario?.HasClaim(ClaimsSigac.Permiso, permiso) == true;

        var id = ex.BeneficiarioId;
        string? accion = null;
        Func<Task>? alHacerClic = null;

        if (!ex.Activo && Tiene(Permisos.Beneficiarios.CambiarEstado))
        {
            accion = "Reactivar";
            alHacerClic = () => ReactivarAsync(id, Tiene(Permisos.Beneficiarios.Editar));
        }
        else if (Tiene(Permisos.Beneficiarios.Editar))
        {
            accion = "Ver registro";
            alHacerClic = () =>
            {
                NavigationManager.NavigateTo($"/beneficiarios/editar/{id}");
                return Task.CompletedTask;
            };
        }

        Snackbar.Add(ex.Message, Severity.Warning, config =>
        {
            if (accion is null || alHacerClic is null)
                return;

            config.Action = accion;
            config.ActionColor = Color.Primary;
            config.OnClick = _ => alHacerClic();
        });
    }

    private async Task ReactivarAsync(int id, bool puedeEditar)
    {
        try
        {
            await BeneficiariosService.ActivarBeneficiarioAsync(id);
            Snackbar.Add("Beneficiario reactivado correctamente.", Severity.Success);

            // Se abre para revisar sus datos: si se estaba registrando de nuevo es
            // porque algo pudo haber cambiado (teléfono, dirección, documento).
            if (puedeEditar)
                NavigationManager.NavigateTo($"/beneficiarios/editar/{id}");
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo reactivar el beneficiario. Intente de nuevo.", Severity.Error);
        }
    }
}
