@page "/beneficiarios"
@attribute [Authorize(Policy = Permisos.Beneficiarios.Ver)]
@using SIGAC.Application.DTOs
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IBeneficiariosService BeneficiariosService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Beneficiarios registrados — SIGAC</PageTitle>

<EncabezadoPagina Titulo="Beneficiarios registrados"
                  Descripcion="Consulte, registre y administre a las personas atendidas por el comedor."
                  TextoAccion="Registrar beneficiario" HrefAccion="/beneficiarios/registrar"
                  PermisoAccion="@Permisos.Beneficiarios.Registrar" />

@* Panorama general del módulo (no depende de los filtros de la grilla). Si la
   consulta falla, las tarjetas simplemente no se muestran: el listado sigue. *@
@if (resumen is not null)
{
    <section class="ac-kpis" aria-label="Resumen de beneficiarios">
        <TarjetaResumen Titulo="Beneficiarios activos"
                        Valor="@TextoResumen.Numero(resumen.Activos)"
                        Detalle="@TextoResumen.Cantidad(resumen.Inactivos, "inactivo", "inactivos")"
                        Icono="@Icons.Material.Filled.People" />
        <TarjetaResumen Titulo="Registrados este mes"
                        Valor="@TextoResumen.Numero(resumen.NuevosEsteMes)"
                        Detalle="@TextoResumen.VsMesAnterior(resumen.NuevosEsteMes, resumen.NuevosMesAnterior)"
                        Icono="@Icons.Material.Filled.PersonAdd" />
        <TarjetaResumen Titulo="Registrados el mes anterior"
                        Valor="@TextoResumen.Numero(resumen.NuevosMesAnterior)"
                        Icono="@Icons.Material.Filled.History" />
    </section>
}

<MudCard Class="pa-4">
    <MudCardContent>
        @* Una sola caja: busca en los cuatro campos de nombre y en el número de
           identidad, para poder buscar por la cédula que trae la persona. *@
        <MudTextField T="string" Value="filtroTexto" ValueChanged="OnFiltroTextoCambiado" Immediate="true" DebounceInterval="300"
                      Label="Buscar por nombres, apellidos o número de identidad" Variant="Variant.Outlined" Class="mb-4" />
        <MudSelect T="string" Value="filtroCategoria" ValueChanged="OnFiltroCategoriaCambiado" Label="Categoría" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            @foreach (var categoria in CategoriasBeneficiario.Todas)
            {
                <MudSelectItem T="string" Value="@categoria">@categoria</MudSelectItem>
            }
        </MudSelect>
        @* Lista cerrada: la fuente es SIGAC.Domain.TiposDocumento, no la pantalla. *@
        <MudSelect T="string" Value="filtroTipoDocumento" ValueChanged="OnFiltroTipoDocumentoCambiado" Label="Tipo de documento" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            @foreach (var tipo in TiposDocumento.Todos)
            {
                <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="bool?" Value="filtroEstado" ValueChanged="OnFiltroEstadoCambiado" Label="Estado" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            <MudSelectItem T="bool?" Value="true">Activo</MudSelectItem>
            <MudSelectItem T="bool?" Value="false">Inactivo</MudSelectItem>
        </MudSelect>

        @* ServerData en lugar de Items: la grilla pide una página por vez y el
           repositorio trae de la base solo esos registros.
           SortMode.None porque el orden lo fija la consulta en SQL: dejar ordenar
           por columna solo reordenaría la página visible, que sería engañoso. *@
        @* Un solo MudDataGrid sirve a los tres tamaños, así la carga del servidor, el
           paginador y los estados vacío y de carga no se duplican. Lo que cambia es
           qué celdas se ven (reglas .ac-grilla-tarjetas en app.css):
           - móvil (< 768px): solo la columna "tarjeta"; cada fila es una tarjeta;
           - tableta y laptop chico (768px a 1439px): sin Documento ni Fecha de nacimiento, que van
             en el "Ver más" de la celda del nombre;
           - escritorio (1440px o más): las ocho columnas de siempre.
           Breakpoint.None apaga el modo apilado propio de Mud (corta en 600/960px). *@
        <MudDataGrid T="BeneficiarioListaDto" @ref="grilla" Class="ac-grilla-tarjetas" Breakpoint="Breakpoint.None"
                     ServerData="CargarPaginaAsync"
                     RowsPerPage="FiltrosBeneficiarioDto.TamanoPaginaPredeterminado"
                     SortMode="SortMode.None" Filterable="false">
            <Columns>
                <TemplateColumn Title="Nombre completo" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        @context.Item.NombreCompleto
                        <VerMasTabla>
                            <dt>Documento</dt>
                            <dd>@(DescribirDocumento(context.Item))</dd>
                            <dt>Fecha de nacimiento</dt>
                            <dd>@context.Item.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
                        </VerMasTabla>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Documento" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio">
                    <CellTemplate>
                        @DescribirDocumento(context.Item)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.NumIdentidad" Title="N.º de identidad" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <PropertyColumn Property="x => x.FechaNacimiento" Title="Fecha de nacimiento" Format="dd/MM/yyyy" CellClass="ac-col-clasica ac-col-escritorio" HeaderClass="ac-col-clasica ac-col-escritorio" />
                <PropertyColumn Property="x => x.Categoria" Title="Categoría" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <PropertyColumn Property="x => x.TelefonoCompleto" Title="Teléfono" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica" />
                <TemplateColumn Title="Estado" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        <EstadoChip Activo="@context.Item.Estado" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Acciones" CellClass="ac-col-clasica" HeaderClass="ac-col-clasica">
                    <CellTemplate>
                        <div class="ac-acciones-tabla">
                            @Acciones(context.Item, false)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                @* Solo móvil: toda la fila en una tarjeta. Nombre y estado arriba, el
                   documento con su número y el teléfono siempre a la vista, el resto
                   en "Ver más" y las acciones al pie (botones de 48px). *@
                <TemplateColumn Title="Beneficiario" CellClass="ac-col-tarjeta" HeaderClass="ac-col-tarjeta">
                    <CellTemplate>
                        <TarjetaFila Titulo="@context.Item.NombreCompleto">
                            <Estado>
                                <EstadoChip Activo="@context.Item.Estado" />
                            </Estado>
                            <Lineas>
                                @if (LineaIdentidad(context.Item) is { Length: > 0 } identidad)
                                {
                                    <p class="ac-tarjeta-dato">@identidad</p>
                                }
                                <EnlaceContacto Telefono="@context.Item.TelefonoCompleto" />
                            </Lineas>
                            <Detalle>
                                <dt>Categoría</dt>
                                <dd>@context.Item.Categoria</dd>
                                <dt>Fecha de nacimiento</dt>
                                <dd>@context.Item.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
                            </Detalle>
                            <Acciones>
                                @Acciones(context.Item, true)
                            </Acciones>
                        </TarjetaFila>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ningún beneficiario coincide con los filtros"
                                 Descripcion="Pruebe con otro nombre, número de identidad o categoría." />
                }
                else if (NoHayBeneficiarios)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.PeopleOutline"
                                 Titulo="Todavía no hay beneficiarios registrados"
                                 TextoAccion="Registrar beneficiario" HrefAccion="/beneficiarios/registrar"
                                 PermisoAccion="@Permisos.Beneficiarios.Registrar" />
                }
                else
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.PersonSearch"
                                 Titulo="Busque por nombre o número de identidad, o elija un filtro"
                                 Descripcion="Así se consultan solo los beneficiarios que necesita, sin cargar la lista completa." />
                }
            </NoRecordsContent>
            <PagerContent>
                @* Sin filas no hay nada que paginar: el paginador solo estorbaba (F-16). *@
                @if (grilla?.GetFilteredItemsCount() > 0)
                {
                    <MudDataGridPager T="BeneficiarioListaDto"
                                      PageSizeOptions="@(new[] { FiltrosBeneficiarioDto.TamanoPaginaPredeterminado, 50, FiltrosBeneficiarioDto.TamanoPaginaMaximo })" />
                }
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private MudDataGrid<BeneficiarioListaDto>? grilla;

    private string? filtroTexto;
    private string? filtroCategoria;
    private string? filtroTipoDocumento;
    private bool? filtroEstado;

    // IsNullOrWhiteSpace, el mismo criterio con el que el repositorio decide si
    // aplica cada filtro: un texto con solo espacios allá se ignora, así que acá
    // tampoco cuenta como búsqueda (si contara, traería la lista completa).
    private bool HayFiltro =>
        !string.IsNullOrWhiteSpace(filtroTexto) || !string.IsNullOrWhiteSpace(filtroCategoria) ||
        !string.IsNullOrWhiteSpace(filtroTipoDocumento) || filtroEstado.HasValue;

    private ResumenRegistrosDto? resumen;

    // Sale del resumen de las tarjetas (un conteo, no filas): permite decir
    // "todavía no hay beneficiarios" sin consultar la lista.
    private bool NoHayBeneficiarios => resumen is { Activos: 0, Inactivos: 0 };

    protected override async Task OnInitializedAsync() => await CargarResumenAsync();

    // Las tarjetas son un complemento del listado: si la consulta falla se
    // ocultan, en vez de romper la pantalla.
    private async Task CargarResumenAsync()
    {
        try
        {
            resumen = await BeneficiariosService.ObtenerResumenAsync();
        }
        catch (Exception)
        {
            resumen = null;
        }
    }

    // La llama la grilla cada vez que cambia de página o se recarga. Devuelve solo
    // los registros de esa página más el total, que es lo que necesita el paginador.
    private async Task<GridData<BeneficiarioListaDto>> CargarPaginaAsync(
        GridState<BeneficiarioListaDto> estado, CancellationToken cancellationToken)
    {
        // La pantalla abre sin consultar la lista: sin ningún criterio no se va a
        // la base y la grilla queda vacía, con la invitación a buscar. Antes
        // cargaba la primera página de todos los beneficiarios sin que nadie
        // hubiera buscado nada. Mismo criterio que ExistenciasInventario.
        // Cubre también borrar todos los filtros: la grilla se vacía en vez de
        // volver a traer la lista completa.
        if (!HayFiltro)
            return new GridData<BeneficiarioListaDto> { Items = Array.Empty<BeneficiarioListaDto>(), TotalItems = 0 };

        try
        {
            var resultado = await BeneficiariosService.ObtenerBeneficiariosAsync(new FiltrosBeneficiarioDto
            {
                Nombre = filtroTexto,
                Categoria = filtroCategoria,
                TipoDocumento = filtroTipoDocumento,
                Estado = filtroEstado,
                Pagina = estado.Page,
                TamanoPagina = estado.PageSize
            });

            return new GridData<BeneficiarioListaDto>
            {
                Items = resultado.Elementos,
                TotalItems = resultado.TotalRegistros
            };
        }
        catch (Exception)
        {
            // Una base caída no debe tumbar la pantalla con el error sin controlar:
            // mismo tratamiento que el historial de asistencia.
            Snackbar.Add("No se pudo cargar el listado de beneficiarios. Intente de nuevo.", Severity.Error);
            return new GridData<BeneficiarioListaDto> { Items = Array.Empty<BeneficiarioListaDto>(), TotalItems = 0 };
        }
    }

    private async Task OnFiltroTextoCambiado(string? valor)
    {
        filtroTexto = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroCategoriaCambiado(string? valor)
    {
        filtroCategoria = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroTipoDocumentoCambiado(string? valor)
    {
        filtroTipoDocumento = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroEstadoCambiado(bool? valor)
    {
        filtroEstado = valor;
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        if (grilla is null)
            return;

        // Al cambiar un filtro se vuelve a la primera página: la que se estaba
        // viendo puede no existir con el filtro nuevo (y quedaría vacía).
        //
        // NavigateTo cambia CurrentPage, y el setter de CurrentPage ya dispara
        // ServerData por dentro. Por eso solo se recarga a mano en la otra rama:
        // así el cambio de filtro cuesta una sola consulta y no dos.
        if (grilla.CurrentPage != 0)
            grilla.NavigateTo(Page.First);
        else
            await grilla.ReloadServerData();
    }

    // Cada acción solo si el usuario tiene su permiso (fase 4 del módulo de
    // seguridad). Context="auth" para no pisar el context de la celda. La misma
    // pieza sirve a la tabla (Editar plano, Activar/Desactivar chico) y a la
    // tarjeta de móvil (botones del tamaño normal; los estira app.css).
    private RenderFragment Acciones(BeneficiarioListaDto item, bool tarjeta) => @<text>
        <AuthorizeView Policy="@Permisos.Beneficiarios.Editar" Context="auth">
            <MudButton Variant="@(tarjeta ? Variant.Outlined : Variant.Text)" Color="Color.Primary" Href="@($"/beneficiarios/editar/{item.Id}")">Editar</MudButton>
        </AuthorizeView>
        <AuthorizeView Policy="@Permisos.Beneficiarios.CambiarEstado" Context="auth">
            @if (item.Estado)
            {
                <MudButton Variant="Variant.Outlined" Size="@(tarjeta ? Size.Medium : Size.Small)" Color="Color.Error" Class="@(tarjeta ? "ac-btn-inactivar" : "ac-btn-inactivar ml-1")" OnClick="@(() => ConfirmarCambioEstadoAsync(item.Id, item.NombreCompleto, false))">Desactivar</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Size="@(tarjeta ? Size.Medium : Size.Small)" Color="Color.Success" Class="@(tarjeta ? "ac-btn-activar" : "ac-btn-activar ml-1")" OnClick="@(() => ConfirmarCambioEstadoAsync(item.Id, item.NombreCompleto, true))">Activar</MudButton>
            }
        </AuthorizeView>
    </text>;

    // "Cédula · 1-2345-6789" en una línea: en la tarjeta el tipo de documento solo
    // no dice nada y el número solo tampoco.
    private static string LineaIdentidad(BeneficiarioListaDto beneficiario) =>
        string.Join(" · ", new[] { DescribirDocumento(beneficiario), beneficiario.NumIdentidad }
            .Where(texto => !string.IsNullOrWhiteSpace(texto)));

    // "Otro" por sí solo no dice nada: se muestra cómo se llama el documento.
    private static string DescribirDocumento(BeneficiarioListaDto beneficiario)
    {
        if (beneficiario.TipoDocumento == TiposDocumento.Otro && !string.IsNullOrWhiteSpace(beneficiario.TipoDocumentoOtro))
            return beneficiario.TipoDocumentoOtro;

        return beneficiario.TipoDocumento ?? string.Empty;
    }

    private async Task ConfirmarCambioEstadoAsync(int id, string nombre, bool activar)
    {
        var accion = activar ? "activar" : "desactivar";
        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Confirmar",
            $"¿Seguro que desea {accion} a {nombre}?",
            yesText: "Confirmar",
            cancelText: "Cancelar");

        if (confirmado == true)
        {
            await CambiarEstadoAsync(id, activar);
        }
    }

    private async Task CambiarEstadoAsync(int id, bool activar)
    {
        try
        {
            if (activar)
                await BeneficiariosService.ActivarBeneficiarioAsync(id);
            else
                await BeneficiariosService.DesactivarBeneficiarioAsync(id);

            Snackbar.Add(activar ? "Beneficiario activado." : "Beneficiario desactivado.", Severity.Success);

            // Activar o desactivar mueve los conteos de las tarjetas.
            await CargarResumenAsync();

            // Se recarga la página actual, no la primera: el filtro no cambió.
            if (grilla is not null)
                await grilla.ReloadServerData();
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo actualizar el estado del beneficiario. Intente de nuevo.", Severity.Error);
        }
    }
}
