@page "/beneficiarios"
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Interfaces
@inject IBeneficiariosService BeneficiariosService

<MudText Typo="Typo.h4" Class="mb-4">Beneficiarios registrados</MudText>

<MudCard Class="pa-4">
    <MudCardContent>
        <MudTextField @bind-Value="filtroNombre" Label="Buscar por nombre" Variant="Variant.Outlined" Class="mb-4" />
        <MudSelect T="string" @bind-Value="filtroCategoria" Label="Categoría" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            <MudSelectItem T="string" Value="@("Niño")">Niño</MudSelectItem>
            <MudSelectItem T="string" Value="@("Adulto mayor")">Adulto mayor</MudSelectItem>
            <MudSelectItem T="string" Value="@("Familia")">Familia</MudSelectItem>
            <MudSelectItem T="string" Value="@("Jefa de hogar")">Jefa de hogar</MudSelectItem>
        </MudSelect>
        <MudSelect T="bool?" @bind-Value="filtroEstado" Label="Estado" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            <MudSelectItem T="bool?" Value="true">Activo</MudSelectItem>
            <MudSelectItem T="bool?" Value="false">Inactivo</MudSelectItem>
        </MudSelect>
        <MudDataGrid T="BeneficiarioListaDto" Items="@beneficiarios">
            <Columns>
                <PropertyColumn Property="x => x.Nombre" Title="Nombre" />
                <PropertyColumn Property="x => x.FechaNacimiento" Title="Fecha de nacimiento" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.Categoria" Title="Categoría" />
                <PropertyColumn Property="x => x.Telefono" Title="Teléfono" />
                <TemplateColumn Title="Estado">
                    <CellTemplate>
                        @(context.Item.Estado ? "Activo" : "Inactivo")
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText>Todavía no hay beneficiarios registrados.</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private IEnumerable<BeneficiarioListaDto> beneficiarios = new List<BeneficiarioListaDto>();
    private string? filtroNombre;
    private string? filtroCategoria;
    private bool? filtroEstado;

    protected override async Task OnInitializedAsync()
    {
        beneficiarios = await BeneficiariosService.ObtenerBeneficiariosAsync(new FiltrosBeneficiarioDto());
    }
}
