@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Domain
@* Campos del beneficiario, compartidos por RegistrarBeneficiario y
   EditarBeneficiario para que las dos pantallas no puedan divergir en límites,
   ayudas ni filtros. Va dentro del EditForm de cada pantalla, que pone el
   validador, el botón Guardar y el manejo de errores.

   Lo único que cambia entre las dos es qué pasa con el número al cambiar el
   tipo de documento (al registrar se limpia siempre, al editar se conserva si
   sigue siendo válido): por eso ese cambio lo resuelve la pantalla, vía
   AlCambiarTipoDocumento.

   El documento va PRIMERO, antes de los nombres: con "Cédula nacional" y los 9
   dígitos completos se consulta Hacienda y se rellenan los nombres y apellidos,
   así que el número tiene que estar antes de lo que completa. Todo eso vive en
   CamposDocumento, que comparten también donantes y arrendatarios. *@

<CamposDocumento Tipos="TiposDocumento.Todos" Origen="Modelo"
                 TipoDocumento="@Modelo.TipoDocumento" AlCambiarTipoDocumento="AlCambiarTipoDocumento"
                 @bind-TipoDocumentoOtro="Modelo.TipoDocumentoOtro"
                 @bind-NumIdentidad="Modelo.NumIdentidad"
                 AplicarNombre="AplicarNombre" />

<MudTextField @bind-Value="Modelo.PrimerNombre" For="@(() => Modelo.PrimerNombre)" Label="Primer nombre" Variant="Variant.Outlined" Class="mt-4"
              MaxLength="ReglasBeneficiario.LongitudMaximaNombre" />
<MudTextField @bind-Value="Modelo.SegundoNombre" Label="Segundo nombre (opcional)" Variant="Variant.Outlined" Class="mt-4"
              MaxLength="ReglasBeneficiario.LongitudMaximaNombre" />
<MudTextField @bind-Value="Modelo.PrimerApellido" For="@(() => Modelo.PrimerApellido)" Label="Primer apellido" Variant="Variant.Outlined" Class="mt-4"
              MaxLength="ReglasBeneficiario.LongitudMaximaApellido" />
<MudTextField @bind-Value="Modelo.SegundoApellido" Label="Segundo apellido (opcional)" Variant="Variant.Outlined" Class="mt-4"
              MaxLength="ReglasBeneficiario.LongitudMaximaApellido" />
<MudDatePicker Culture="CulturaSigac.EsCr" @bind-Date="FechaNacimiento" Label="Fecha de nacimiento" Variant="Variant.Outlined" Class="mt-4" MaxDate="DateTime.Today" />

@* La categoría no se elige: se deriva de la fecha de nacimiento. *@
@if (Modelo.FechaNacimiento != default)
{
    <MudText Typo="Typo.body2" Class="mt-2">
        Categoría: @CategoriasBeneficiario.DerivarDesdeFechaNacimiento(Modelo.FechaNacimiento)
    </MudText>
}

<PhoneInput @bind-Value="Modelo.Telefono" @bind-CodigoPais="Modelo.CodigoPaisTelefono"
            Label="Teléfono (opcional)" Class="mt-4" />
<MudTextField @bind-Value="Modelo.Direccion" Label="Dirección (opcional)" Variant="Variant.Outlined" Class="mt-4"
              MaxLength="ReglasBeneficiario.LongitudMaximaDireccion" Lines="2"
              HelperText="@($"Máximo {ReglasBeneficiario.LongitudMaximaDireccion} caracteres. Ej: Del parque 150 metros suroeste, casa verde.")" />

@code {
    [Parameter, EditorRequired]
    public IDatosBeneficiario Modelo { get; set; } = default!;

    // La pantalla decide qué pasa con el número y el nombre del documento al
    // cambiar el tipo; tiene que asignar Modelo.TipoDocumento.
    [Parameter, EditorRequired]
    public EventCallback<string?> AlCambiarTipoDocumento { get; set; }

    private DateTime? FechaNacimiento
    {
        get => Modelo.FechaNacimiento == default ? null : Modelo.FechaNacimiento;
        set => Modelo.FechaNacimiento = value ?? default;
    }

    // Rellena los cuatro campos solo si están vacíos: si la persona ya escribió algo,
    // no se le pisa; se le muestra lo que dice Hacienda y decide ella.
    private string AplicarNombre(string nombreHacienda, string tipoDocumento)
    {
        var hayNombresEscritos = !string.IsNullOrWhiteSpace(Modelo.PrimerNombre)
            || !string.IsNullOrWhiteSpace(Modelo.SegundoNombre)
            || !string.IsNullOrWhiteSpace(Modelo.PrimerApellido)
            || !string.IsNullOrWhiteSpace(Modelo.SegundoApellido);

        if (hayNombresEscritos)
            return $"Hacienda registra esta cédula a nombre de {nombreHacienda}. No se cambió lo que ya escribió.";

        var partes = DivisorNombreCompleto.Dividir(nombreHacienda);
        if (partes is null)
            return $"Hacienda registra esta cédula a nombre de {nombreHacienda}. Escriba los nombres y apellidos a mano.";

        Modelo.PrimerNombre = partes.Value.PrimerNombre;
        Modelo.SegundoNombre = partes.Value.SegundoNombre ?? string.Empty;
        Modelo.PrimerApellido = partes.Value.PrimerApellido;
        Modelo.SegundoApellido = partes.Value.SegundoApellido ?? string.Empty;

        // Esto corre desde CamposDocumento (el hijo), que solo se redibuja a sí mismo:
        // sin avisar acá, los campos de nombre de esta pantalla quedarían mostrando
        // los valores viejos aunque el modelo ya cambió.
        StateHasChanged();

        return $"Nombre completado con los datos de Hacienda ({nombreHacienda}). Verifíquelo antes de guardar.";
    }
}
