@page "/beneficiarios/editar/{Id:int}"
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Interfaces
@inject IBeneficiariosService BeneficiariosService
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" Class="mb-4">Editar beneficiario</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            <MudTextField @bind-Value="modelo.Nombre" For="@(() => modelo.Nombre)" Label="Nombre" Variant="Variant.Outlined" />
            <MudDatePicker @bind-Date="fechaNacimiento" Label="Fecha de nacimiento" Variant="Variant.Outlined" Class="mt-4" />
            <MudSelect T="string" @bind-Value="modelo.Categoria" For="@(() => modelo.Categoria)" Label="Categoría" Variant="Variant.Outlined" Class="mt-4">
                <MudSelectItem T="string" Value="@("Niño")">Niño</MudSelectItem>
                <MudSelectItem T="string" Value="@("Adulto mayor")">Adulto mayor</MudSelectItem>
                <MudSelectItem T="string" Value="@("Familia")">Familia</MudSelectItem>
                <MudSelectItem T="string" Value="@("Jefa de hogar")">Jefa de hogar</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="modelo.Telefono" Label="Teléfono" Variant="Variant.Outlined" Class="mt-4" />
            <MudTextField @bind-Value="modelo.Direccion" Label="Dirección" Variant="Variant.Outlined" Class="mt-4" />
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private BeneficiarioEditarDto modelo = new();

    private DateTime? fechaNacimiento
    {
        get => modelo.FechaNacimiento == default ? null : modelo.FechaNacimiento;
        set => modelo.FechaNacimiento = value ?? default;
    }

    protected override async Task OnInitializedAsync()
    {
        var datos = await BeneficiariosService.ObtenerParaEditarAsync(Id);
        if (datos is null)
        {
            NavigationManager.NavigateTo("/beneficiarios");
            return;
        }

        modelo = datos;
    }

    private async Task Guardar()
    {
        await BeneficiariosService.ActualizarBeneficiarioAsync(Id, modelo);
    }
}
