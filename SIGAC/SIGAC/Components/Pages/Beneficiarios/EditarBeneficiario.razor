@page "/beneficiarios/editar/{Id:int}"
@attribute [Authorize(Policy = Permisos.Beneficiarios.Editar)]
@using SIGAC.Application.DTOs.Beneficiarios
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IBeneficiariosService BeneficiariosService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<EncabezadoPagina Titulo="Editar beneficiario"
                  Descripcion="Corrija o actualice los datos del beneficiario." />

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <MudCard Class="pa-4">
        <MudCardContent>
            <CamposBeneficiario Modelo="modelo" AlCambiarTipoDocumento="OnTipoDocumentoCambiado" />
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Href="/beneficiarios" Class="mb-2">Cancelar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private BeneficiarioEditarDto modelo = new();

    // Documento con el que se abrió la pantalla. Sirve para devolver el número y
    // el nombre del documento si el usuario pasa por otro tipo y vuelve al original.
    private string? tipoDocumentoOriginal;
    private string? numIdentidadOriginal;
    private string? tipoDocumentoOtroOriginal;

    private void OnTipoDocumentoCambiado(string? valor)
    {
        modelo.TipoDocumento = valor;

        // Al editar el número se conserva mientras siga siendo válido: acá hay un
        // dato real cargado y un clic accidental en el desplegable no debe hacérselo
        // perder al usuario. En RegistrarBeneficiario la regla es a propósito la
        // contraria, porque ahí no hay nada guardado que proteger.
        if (!TiposDocumento.RequiereNumIdentidad(valor))
        {
            // "Sin documento": el número se borra en lugar de quedar huérfano.
            modelo.NumIdentidad = null;
        }
        else if (string.IsNullOrEmpty(modelo.NumIdentidad) && valor == tipoDocumentoOriginal)
        {
            // Se volvió al tipo con el que se abrió la pantalla y el número estaba
            // limpio: se recupera el que ya estaba guardado.
            modelo.NumIdentidad = numIdentidadOriginal;
        }
        else if (!string.IsNullOrEmpty(modelo.NumIdentidad) &&
                 !ReglasBeneficiario.TieneFormatoNumIdentidad(valor, modelo.NumIdentidad))
        {
            // Lo que estaba escrito no sirve para el tipo nuevo (por ejemplo una
            // cédula de 9 dígitos al pasar a DIMEX). Se limpia en vez de dejar un
            // valor inválido que el usuario descubriría recién al guardar.
            modelo.NumIdentidad = null;
        }

        if (!TiposDocumento.RequiereNombreDelDocumento(valor))
        {
            // La especificación solo tiene sentido con el tipo "Otro".
            modelo.TipoDocumentoOtro = null;
        }
        else if (string.IsNullOrWhiteSpace(modelo.TipoDocumentoOtro) && valor == tipoDocumentoOriginal)
        {
            // Mismo criterio que el número: se volvió al tipo con el que se abrió la
            // pantalla y el campo estaba vacío, así que se recupera lo guardado. Si
            // el usuario escribió algo, esta rama no se toca y se respeta lo suyo.
            modelo.TipoDocumentoOtro = tipoDocumentoOtroOriginal;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var datos = await BeneficiariosService.ObtenerParaEditarAsync(Id);
        if (datos is null)
        {
            NavigationManager.NavigateTo("/beneficiarios");
            return;
        }

        modelo = datos;
        tipoDocumentoOriginal = datos.TipoDocumento;
        numIdentidadOriginal = datos.NumIdentidad;
        tipoDocumentoOtroOriginal = datos.TipoDocumentoOtro;
    }

    private async Task Guardar()
    {
        try
        {
            await BeneficiariosService.ActualizarBeneficiarioAsync(Id, modelo);
            Snackbar.Add("Beneficiario actualizado correctamente.", Severity.Success);
            NavigationManager.NavigateTo("/beneficiarios");
        }
        catch (Exception ex) when (ex is ValidationException or DuplicateException or NotFoundException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo actualizar el beneficiario. Intente de nuevo.", Severity.Error);
        }
    }
}
