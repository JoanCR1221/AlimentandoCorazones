@page "/proyectos"
@attribute [Authorize(Policy = Permisos.Proyectos.Ver)]
@using SIGAC.Application.DTOs.Proyectos
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain.Entities
@inject IProyectosService ProyectosService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<EncabezadoPagina Titulo="Proyectos comunitarios"
                  Descripcion="Planifique proyectos y actividades de la asociación y registre a sus participantes."
                  TextoAccion="Registrar proyecto" HrefAccion="/proyectos/registrar"
                  PermisoAccion="@Permisos.Proyectos.Registrar" />

<ResumenProyectos />

<MudCard Class="pa-4">
    <MudCardContent>
        <MudTextField T="string" Value="filtroNombre" ValueChanged="OnFiltroNombreCambiadoAsync" Immediate="true" DebounceInterval="300"
                      Label="Buscar por nombre del proyecto" Variant="Variant.Outlined" Class="mb-4" Clearable="true" />

        @* Lista cerrada: la fuente es el enum SIGAC.Domain.Entities.EstadoProyecto,
           no la pantalla. Mismo criterio que el filtro de categoría en
           ListadoGastos.razor: si esta lista tuviera sus propios literales, podría
           ofrecer un estado que el servicio no reconoce. *@
        <MudSelect T="EstadoProyecto?" Value="filtroEstado" ValueChanged="OnFiltroEstadoCambiadoAsync"
                   Label="Estado" Variant="Variant.Outlined" Class="mb-4" Clearable="true">
            @foreach (var estado in Enum.GetValues<EstadoProyecto>())
            {
                <MudSelectItem T="EstadoProyecto?" Value="@((EstadoProyecto?)estado)">@EtiquetaEstado(estado)</MudSelectItem>
            }
        </MudSelect>

        @* Items y no ServerData, a diferencia de ListadoBeneficiarios: el servicio
           devuelve IReadOnlyList sin paginar, con el mismo criterio que Gastos (el
           volumen de proyectos de la asociación no la justifica). Si algún día se
           agrega paginación al repositorio, esta grilla pasa a ServerData. *@
        <MudDataGrid T="ProyectoListaDto" Items="@proyectos" Loading="cargando">
            <Columns>
                @* El nombre abre la ficha del proyecto, donde están los participantes. *@
                <TemplateColumn Title="Nombre">
                    <CellTemplate>
                        <MudLink Href="@($"/proyectos/{context.Item.Id}")">@context.Item.Nombre</MudLink>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.FechaInicio" Title="Inicio" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.FechaEstimadaFin" Title="Fin estimado" Format="dd/MM/yyyy" />
                <TemplateColumn Title="Estado">
                    <CellTemplate>
                        @* El DTO trae el estado ya como string (Estado.ToString()),
                           así que se traduce desde el texto y no desde el enum. *@
                        @EtiquetaEstado(context.Item.Estado)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.TotalParticipantes" Title="Participantes" />
                <TemplateColumn Title="Acciones">
                    <CellTemplate>
                        @* Ver siempre, también en un proyecto cerrado: la ficha es de
                           consulta. Los participantes se agregan y quitan desde ahí. *@
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="@($"/proyectos/{context.Item.Id}")">Ver</MudButton>

                        @* Finalizado y Cancelado son estados de cierre: el servicio
                           rechaza editarlos, así que los botones se ocultan en vez de
                           dejar que el usuario descubra el error al guardar. Mismo
                           criterio que ListadoGastos.razor con el botón Anular de un
                           gasto ya anulado. *@
                        @if (!EsEstadoTerminal(context.Item.Estado))
                        {
                            @* Cada acción solo si el usuario tiene su permiso (módulo de
                               seguridad). Context="auth" para no pisar el context de la celda. *@
                            <AuthorizeView Policy="@Permisos.Proyectos.Editar" Context="auth">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/proyectos/editar/{context.Item.Id}")">Editar</MudButton>
                            </AuthorizeView>
                            @* Cancelado no aparece acá aunque también sea terminal:
                               un proyecto cancelado no se finaliza (el servicio lo
                               rechaza), se queda cancelado. *@
                            <AuthorizeView Policy="@Permisos.Proyectos.Finalizar" Context="auth">
                                <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="@(() => FinalizarAsync(context.Item.Id, context.Item.Nombre))">Finalizar</MudButton>
                            </AuthorizeView>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <CargandoGrilla />
            </LoadingContent>
            <NoRecordsContent>
                @if (HayFiltro)
                {
                    <EstadoVacio Icono="@Icons.Material.Filled.SearchOff"
                                 Titulo="Ningún proyecto coincide con la búsqueda"
                                 Descripcion="Pruebe con otro nombre o estado." />
                }
                else
                {
                    @* Sin filtros no se consulta nada, así que acá no se sabe si hay
                       proyectos: la invitación a buscar también ofrece registrar
                       uno, para cuando todavía no hay ninguno. *@
                    <EstadoVacio Icono="@Icons.Material.Filled.Groups"
                                 Titulo="Busque un proyecto por nombre o elija un estado"
                                 Descripcion="Así se consultan solo los proyectos que necesita, sin cargar la lista completa."
                                 TextoAccion="Registrar proyecto" HrefAccion="/proyectos/registrar"
                                 PermisoAccion="@Permisos.Proyectos.Registrar" />
                }
            </NoRecordsContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private IReadOnlyList<ProyectoListaDto> proyectos = Array.Empty<ProyectoListaDto>();
    private string? filtroNombre;
    private EstadoProyecto? filtroEstado;
    private bool cargando;

    // IsNullOrWhiteSpace, el mismo criterio con el que el repositorio decide si
    // aplica el filtro: un texto con solo espacios no cuenta como búsqueda.
    private bool HayFiltro => !string.IsNullOrWhiteSpace(filtroNombre) || filtroEstado.HasValue;

    // Sin OnInitializedAsync a propósito: la pantalla abre sin consultar la lista,
    // igual que Ver Beneficiarios y Existencias de inventario. Las tarjetas de
    // arriba (ResumenProyectos) siguen mostrando los conteos por estado.

    private async Task OnFiltroNombreCambiadoAsync(string? valor)
    {
        filtroNombre = valor;
        await CargarAsync();
    }

    private async Task OnFiltroEstadoCambiadoAsync(EstadoProyecto? valor)
    {
        filtroEstado = valor;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        // Sin ningún criterio no se va a la base. Cubre también borrar el texto y
        // quitar el estado: la grilla se vacía en vez de traer todos los proyectos.
        if (!HayFiltro)
        {
            proyectos = Array.Empty<ProyectoListaDto>();
            return;
        }

        cargando = true;

        try
        {
            proyectos = await ProyectosService.ObtenerProyectosAsync(new FiltrosProyectoDto
            {
                Nombre = filtroNombre,
                Estado = filtroEstado
            });
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudieron cargar los proyectos. Intente de nuevo.", Severity.Error);
            proyectos = Array.Empty<ProyectoListaDto>();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task FinalizarAsync(int proyectoId, string nombre)
    {
        // ShowMessageBoxAsync y no un diálogo propio como AnularGastoDialog:
        // finalizar no pide ningún dato adicional, solo la confirmación. Mismo
        // criterio que Aprobar en GestionSolicitudesPrestamo.razor.
        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Confirmar",
            $"¿Finalizar el proyecto \"{nombre}\"? Se registrará la fecha de finalización real y " +
            "el proyecto ya no podrá editarse ni recibir participantes.",
            yesText: "Finalizar",
            cancelText: "Cancelar");

        if (confirmado != true)
            return;

        try
        {
            await ProyectosService.FinalizarProyectoAsync(proyectoId);
            Snackbar.Add("Proyecto finalizado correctamente.", Severity.Success);
            await CargarAsync();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo finalizar el proyecto. Intente de nuevo.", Severity.Error);
        }
    }

    // Los valores internos del enum son PascalCase sin espacios; acá solo se
    // traducen para mostrarse. Mismo criterio que EtiquetaCategoria en
    // ListadoGastos.razor / RegistrarGasto.razor.
    private static string EtiquetaEstado(EstadoProyecto estado) => estado switch
    {
        EstadoProyecto.EnCurso => "En curso",
        _ => estado.ToString()
    };

    // Sobrecarga para el texto que llega en ProyectoListaDto.Estado, que es el
    // ToString() del enum y no el enum en sí.
    private static string EtiquetaEstado(string estado) =>
        estado == nameof(EstadoProyecto.EnCurso) ? "En curso" : estado;

    private static bool EsEstadoTerminal(string estado) =>
        estado == nameof(EstadoProyecto.Finalizado) || estado == nameof(EstadoProyecto.Cancelado);
}
