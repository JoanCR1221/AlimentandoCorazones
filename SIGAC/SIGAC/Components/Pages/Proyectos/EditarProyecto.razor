@page "/proyectos/editar/{Id:int}"
@attribute [Authorize(Policy = Permisos.Proyectos.Editar)]
@using SIGAC.Application.DTOs.Proyectos
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Application.Validators
@using SIGAC.Domain.Entities
@inject IProyectosService ProyectosService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<EncabezadoPagina Titulo="Editar proyecto comunitario"
                  Descripcion="Actualice los datos, las fechas o el estado del proyecto." />

@if (!cargado)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudCard Class="pa-4">
            <MudCardContent>
                <MudTextField @bind-Value="modelo.Nombre" For="@(() => modelo.Nombre)" Label="Nombre" Variant="Variant.Outlined"
                              MaxLength="ProyectoValidator.LongitudMaximaNombre"
                              HelperText="@($"Máximo {ProyectoValidator.LongitudMaximaNombre} caracteres.")" />

                <MudTextField @bind-Value="modelo.Descripcion" For="@(() => modelo.Descripcion)" Label="Descripción" Variant="Variant.Outlined" Class="mt-4" Lines="3"
                              MaxLength="ProyectoValidator.LongitudMaximaDescripcion"
                              HelperText="@($"Máximo {ProyectoValidator.LongitudMaximaDescripcion} caracteres.")" />

                @* Sin MaxDate, igual que en el alta: un proyecto puede replanificarse
                   hacia adelante. *@
                <MudDatePicker @bind-Date="fechaInicio" @bind-Date:after="OnFechaInicioCambiada"
                               Label="Fecha de inicio" Variant="Variant.Outlined" Class="mt-4" />

                <MudDatePicker @bind-Date="fechaEstimadaFin"
                               Label="Fecha estimada de finalización" Variant="Variant.Outlined" Class="mt-4"
                               MinDate="fechaInicio"
                               HelperText="No puede ser anterior a la fecha de inicio." />

                @* Finalizado NO aparece en la lista a propósito:
                   ProyectoValidator.ValidarEstadoParaEdicion lo rechaza, porque esa
                   transición además registra FechaFinalizacionReal y eso solo lo hace
                   FinalizarProyectoAsync. La acción vive en el listado, separada del
                   formulario. Mismo criterio que la anulación de un gasto: el cierre
                   del ciclo no es un campo más del formulario de edición. *@
                <MudSelect T="EstadoProyecto" @bind-Value="modelo.Estado" Label="Estado" Variant="Variant.Outlined" Class="mt-4"
                           HelperText="Para finalizar el proyecto use la acción «Finalizar» del listado.">
                    @foreach (var estado in EstadosEditables)
                    {
                        <MudSelectItem T="EstadoProyecto" Value="@estado">@EtiquetaEstado(estado)</MudSelectItem>
                    }
                </MudSelect>
            </MudCardContent>
            <MudCardActions>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2 mb-2">Guardar</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" Href="@($"/proyectos/{Id}")" Class="mb-2">Cancelar</MudButton>
            </MudCardActions>
        </MudCard>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ProyectoEditarDto modelo = new();
    private bool cargado;

    // Los tres estados que la edición sí puede asignar. Se deriva del enum y no se
    // escribe a mano para que un estado nuevo aparezca solo; Finalizado se excluye
    // por la regla de ValidarEstadoParaEdicion.
    private static readonly EstadoProyecto[] EstadosEditables =
        Enum.GetValues<EstadoProyecto>().Where(e => e != EstadoProyecto.Finalizado).ToArray();

    private DateTime? fechaInicio
    {
        get => modelo.FechaInicio == default ? null : modelo.FechaInicio;
        set => modelo.FechaInicio = value ?? default;
    }

    private DateTime? fechaEstimadaFin
    {
        get => modelo.FechaEstimadaFin == default ? null : modelo.FechaEstimadaFin;
        set => modelo.FechaEstimadaFin = value ?? default;
    }

    private void OnFechaInicioCambiada()
    {
        if (fechaEstimadaFin.HasValue && fechaInicio.HasValue && fechaEstimadaFin.Value.Date < fechaInicio.Value.Date)
            fechaEstimadaFin = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var datos = await ProyectosService.ObtenerParaEditarAsync(Id);

            if (datos is null)
            {
                // Mismo destino que EditarBeneficiario con un id inexistente: se
                // vuelve al listado del módulo.
                NavigationManager.NavigateTo("/proyectos");
                return;
            }

            // Un proyecto finalizado o cancelado es un registro cerrado y
            // EditarProyectoAsync lo rechaza. Se avisa acá en vez de dejar que el
            // usuario llene el formulario para chocar recién al guardar.
            if (datos.Estado is EstadoProyecto.Finalizado or EstadoProyecto.Cancelado)
            {
                Snackbar.Add("No se puede editar un proyecto finalizado o cancelado.", Severity.Warning);
                NavigationManager.NavigateTo($"/proyectos/{Id}");
                return;
            }

            modelo = datos;
            cargado = true;
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo cargar el proyecto. Intente de nuevo.", Severity.Error);
            NavigationManager.NavigateTo("/proyectos");
        }
    }

    private static string EtiquetaEstado(EstadoProyecto estado) => estado switch
    {
        EstadoProyecto.EnCurso => "En curso",
        _ => estado.ToString()
    };

    // Al guardar vuelve a la ficha del proyecto, que es desde donde se llega a
    // editar y donde se ve el resultado.
    private async Task Guardar()
    {
        try
        {
            await ProyectosService.EditarProyectoAsync(Id, modelo);
            Snackbar.Add("Proyecto comunitario actualizado correctamente.", Severity.Success);
            NavigationManager.NavigateTo($"/proyectos/{Id}");
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo actualizar el proyecto comunitario. Intente de nuevo.", Severity.Error);
        }
    }
}
