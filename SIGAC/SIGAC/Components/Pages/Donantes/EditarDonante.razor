@page "/donantes/editar/{Id:int}"
@attribute [Authorize(Policy = Permisos.Donaciones.EditarDonante)]
@using SIGAC.Application.DTOs.Donaciones
@using SIGAC.Application.Exceptions
@using SIGAC.Application.Interfaces
@using SIGAC.Domain
@inject IDonantesService DonantesService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Editar donante — SIGAC</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Editar donante</MudText>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            @* Mismo bloque que al registrar: el documento va primero y, con cédula
               nacional o jurídica completa, consulta Hacienda. *@
            <CamposDocumento Tipos="TiposDocumento.TodosParaOrganizaciones" Origen="modelo"
                             TipoDocumento="@modelo.TipoDocumento" AlCambiarTipoDocumento="OnTipoDocumentoCambiado"
                             @bind-TipoDocumentoOtro="modelo.TipoDocumentoOtro"
                             @bind-NumIdentidad="modelo.Identificacion"
                             @bind-Nombre="modelo.Nombre" />

            <MudTextField @bind-Value="modelo.Nombre" For="@(() => modelo.Nombre)" Label="Nombre" Variant="Variant.Outlined" Class="mt-4" />

            <MudSelect @bind-Value="modelo.TipoPersona" For="@(() => modelo.TipoPersona)" Label="Tipo de persona" Variant="Variant.Outlined" Class="mt-4">
                @foreach (var tipo in TiposPersonaDonante.Todos)
                {
                    <MudSelectItem T="string" Value="@tipo">@tipo</MudSelectItem>
                }
            </MudSelect>

            <PhoneInput @bind-Value="modelo.Telefono" @bind-CodigoPais="modelo.CodigoPaisTelefono" Label="Teléfono (opcional)" Class="mt-4" />
            <MudTextField @bind-Value="modelo.Correo" For="@(() => modelo.Correo)" Label="Correo (opcional)" Variant="Variant.Outlined" Class="mt-4" />
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="guardando" Class="ml-2 mb-2">Guardar</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Href="/donantes" Class="mb-2">Cancelar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    // Se levanta antes del primer await y se baja en el finally: un doble clic
    // rápido dispara Guardar dos veces antes de que el servidor responda, y la
    // segunda llamada repetiría el registro (y, donde corresponde, el movimiento
    // de stock).
    private bool guardando;

    [Parameter]
    public int Id { get; set; }

    private DonanteEditarDto modelo = new();

    // Documento con el que se abrió la pantalla. Sirve para devolver el número y el
    // nombre del documento si el usuario pasa por otro tipo y vuelve al original.
    private string? tipoDocumentoOriginal;
    private string? identificacionOriginal;
    private string? tipoDocumentoOtroOriginal;

    private void OnTipoDocumentoCambiado(string? valor)
    {
        modelo.TipoDocumento = valor ?? TiposDocumento.SinDocumento;

        // El tipo de persona sale del documento (cédula jurídica = Jurídica, el resto
        // de los documentos de personas = Física); con "Otro" o "Sin documento" queda
        // lo que ya estaba. Sigue siendo editable. Solo se mueve cuando la persona
        // cambia el tipo, no al abrir la pantalla con un donante ya guardado.
        var persona = TiposDocumento.TipoPersonaSugerido(valor);
        if (persona is not null)
            modelo.TipoPersona = persona;

        // Al editar el número se conserva mientras siga siendo válido: acá hay un dato
        // real cargado y un clic accidental en el desplegable no debe hacérselo perder
        // (mismo criterio que EditarBeneficiario).
        if (!TiposDocumento.RequiereNumIdentidad(valor))
        {
            modelo.Identificacion = null;
        }
        else if (string.IsNullOrEmpty(modelo.Identificacion) && valor == tipoDocumentoOriginal)
        {
            // Se volvió al tipo con el que se abrió y el número estaba limpio: se
            // recupera el que ya estaba guardado.
            modelo.Identificacion = identificacionOriginal;
        }
        else if (!string.IsNullOrEmpty(modelo.Identificacion) &&
                 !ReglasBeneficiario.TieneFormatoNumIdentidad(valor, modelo.Identificacion))
        {
            // Lo escrito no sirve para el tipo nuevo (una cédula de 9 dígitos al pasar a
            // jurídica): se limpia en vez de dejar un valor inválido.
            modelo.Identificacion = null;
        }

        if (!TiposDocumento.RequiereNombreDelDocumento(valor))
        {
            modelo.TipoDocumentoOtro = null;
        }
        else if (string.IsNullOrWhiteSpace(modelo.TipoDocumentoOtro) && valor == tipoDocumentoOriginal)
        {
            modelo.TipoDocumentoOtro = tipoDocumentoOtroOriginal;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var datos = await DonantesService.ObtenerParaEditarAsync(Id);
        if (datos is null)
        {
            NavigationManager.NavigateTo("/donantes");
            return;
        }

        modelo = datos;
        tipoDocumentoOriginal = datos.TipoDocumento;
        identificacionOriginal = datos.Identificacion;
        tipoDocumentoOtroOriginal = datos.TipoDocumentoOtro;
    }

    private async Task Guardar()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            await DonantesService.ActualizarDonanteAsync(Id, modelo);
            Snackbar.Add("Donante actualizado correctamente.", Severity.Success);
            NavigationManager.NavigateTo("/donantes");
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (DuplicateException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo actualizar el donante. Intente de nuevo.", Severity.Error);
        }
        finally
        {
            guardando = false;
        }
    }
}
