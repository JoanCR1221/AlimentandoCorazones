@page "/"
@using System.Security.Claims
@using SIGAC.Application.Interfaces
@using SIGAC.Infrastructure.Identity
@inject IInventarioService InventarioService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Inicio — SIGAC</PageTitle>

@* Cabecera de la portada. El banner vive en su propia página (/bienvenida),
   a la que lleva el inicio de sesión. *@
<section class="ac-hero" aria-labelledby="inicio-titulo">
    <div class="ac-hero-texto">
        <span class="ac-hero-antetitulo">UN PUENTE DE ESPERANZA</span>
        <h1 id="inicio-titulo" class="ac-hero-titulo">SISTEMA DE GESTIÓN ALIMENTANDO CORAZONES</h1>
    </div>
</section>

@* Cada tarjeta y cada botón se muestran solo si la cookie del usuario trae el
   permiso correspondiente (AB de fase 4): un Asistente ve dos tarjetas con un
   botón cada una, no una portada llena de accesos que terminan en "acceso
   denegado". Los permisos salen de los claims (PermisosClaimsPrincipalFactory),
   sin consultar la base. *@
<MudGrid Spacing="3">
    @if (Tiene(Permisos.Beneficiarios.Ver) || Tiene(Permisos.Beneficiarios.Registrar))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 ac-card-modulo">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Beneficiarios</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Consulte, registre y administre a las personas atendidas por el comedor.
                    </MudText>
                    @if (Tiene(Permisos.Beneficiarios.Ver))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/beneficiarios" Class="mt-2">
                            Ver listado
                        </MudButton>
                    }
                    @if (Tiene(Permisos.Beneficiarios.Registrar))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/beneficiarios/registrar">
                            Registrar nuevo
                        </MudButton>
                    }
                </MudStack>
            </MudCard>
        </MudItem>
    }

    @if (Tiene(Permisos.Asistencia.Registrar) || Tiene(Permisos.Asistencia.Ver))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 ac-card-modulo">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Restaurant" Color="Color.Secondary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Asistencia al comedor</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Registre la asistencia diaria y consulte el historial de comidas servidas.
                    </MudText>
                    @if (Tiene(Permisos.Asistencia.Registrar))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/asistencia/registrar" Class="mt-2">
                            Agregar asistencia
                        </MudButton>
                    }
                    @if (Tiene(Permisos.Asistencia.Ver))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/asistencia/historial">
                            Ver historial
                        </MudButton>
                    }
                </MudStack>
            </MudCard>
        </MudItem>
    }

    @if (Tiene(Permisos.Inventario.VerExistencias) || Tiene(Permisos.Inventario.RegistrarEntrada))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 ac-card-modulo">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Info" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Inventario</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Consulte las existencias y registre nuevas entradas de artículos.
                    </MudText>
                    @if (Tiene(Permisos.Inventario.VerExistencias))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Info" Href="/inventario/existencias" Class="mt-2">
                            Ver existencias
                        </MudButton>
                    }
                    @if (Tiene(Permisos.Inventario.RegistrarEntrada))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Href="/inventario/entradas/registrar">
                            Registrar entrada
                        </MudButton>
                    }
                </MudStack>
            </MudCard>
        </MudItem>
    }

    @if (Tiene(Permisos.Donaciones.VerHistorial) || Tiene(Permisos.Donaciones.RegistrarDinero) || Tiene(Permisos.Donaciones.RegistrarEspecie))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 ac-card-modulo">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Color="Color.Warning" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Donaciones</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Consulte el historial de donaciones recibidas y registre donantes, dinero o artículos donados.
                    </MudText>
                    @if (Tiene(Permisos.Donaciones.VerHistorial))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Href="/donaciones/historial" Class="mt-2">
                            Ver donaciones
                        </MudButton>
                    }
                    @if (Tiene(Permisos.Donaciones.RegistrarDinero) || Tiene(Permisos.Donaciones.RegistrarEspecie))
                    {
                        @* MudMenu y no un MudButton: "registrar una donación" son en
                           realidad dos formularios distintos (dinero y especie), y un
                           solo botón no puede llevar a los dos. Ver el historial de
                           este archivo para el porqué del Style del activador. *@
                        <MudMenu Style="width:100%;">
                            <ActivatorContent Context="menu">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                           OnClick="@(e => menu.ToggleAsync(e))">
                                    Registrar dinero/artículo
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                @if (Tiene(Permisos.Donaciones.RegistrarDinero))
                                {
                                    <MudMenuItem Href="/donaciones/dinero/registrar">Donación en dinero</MudMenuItem>
                                }
                                @if (Tiene(Permisos.Donaciones.RegistrarEspecie))
                                {
                                    <MudMenuItem Href="/donaciones/especie/registrar">Donación en artículos</MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    }
                </MudStack>
            </MudCard>
        </MudItem>
    }

    @if (Tiene(Permisos.Gastos.Ver) || Tiene(Permisos.Gastos.Registrar))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 ac-card-modulo">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Success" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Gastos Operativos</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Registre y consulte los gastos operativos de la asociación.
                    </MudText>
                    @if (Tiene(Permisos.Gastos.Ver))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Href="/gastos" Class="mt-2">
                            Ver gastos
                        </MudButton>
                    }
                    @if (Tiene(Permisos.Gastos.Registrar))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Success" Href="/gastos/registrar">
                            Registrar gasto
                        </MudButton>
                    }
                </MudStack>
            </MudCard>
        </MudItem>
    }

    @if (Tiene(Permisos.Proyectos.Ver) || Tiene(Permisos.Proyectos.Registrar))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 ac-card-modulo">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Tertiary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Proyectos comunitarios</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Planifique proyectos y actividades de la asociación y registre a sus participantes.
                    </MudText>
                    @if (Tiene(Permisos.Proyectos.Ver))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Href="/proyectos" Class="mt-2">
                            Ver proyectos
                        </MudButton>
                    }
                    @if (Tiene(Permisos.Proyectos.Registrar))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Href="/proyectos/registrar">
                            Registrar proyecto
                        </MudButton>
                    }
                </MudStack>
            </MudCard>
        </MudItem>
    }

    @if (Tiene(Permisos.Seguridad.GestionarUsuarios) || Tiene(Permisos.Seguridad.VerBitacora))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-4 ac-card-modulo">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Error" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Seguridad</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Administre los usuarios del sistema, sus roles y sus permisos, y consulte la bitácora.
                    </MudText>
                    @if (Tiene(Permisos.Seguridad.GestionarUsuarios))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Href="/usuarios" Class="mt-2">
                            Ver usuarios
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Href="/usuarios/registrar">
                            Registrar usuario
                        </MudButton>
                    }
                    @if (Tiene(Permisos.Seguridad.VerBitacora))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Href="/bitacora">
                            Ver bitácora
                        </MudButton>
                    }
                </MudStack>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private ClaimsPrincipal usuario = new(new ClaimsIdentity());

    private bool Tiene(string permiso) => usuario.HasClaim(ClaimsSigac.Permiso, permiso);

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is not null)
            usuario = (await EstadoAutenticacion).User;

        // El aviso de stock bajo lleva a Existencias: solo tiene sentido para
        // quien puede verlas.
        if (!Tiene(Permisos.Inventario.VerExistencias))
            return;

        var articulosStockBajo = await InventarioService.ContarArticulosStockBajoAsync();

        if (articulosStockBajo > 0)
        {
            // Notificación (Snackbar) y no un MudAlert fijo en la página: se
            // muestra y se retira sola, sin el temporizador manual que antes
            // hacía falta para ocultar el aviso a los pocos segundos.
            Snackbar.Add(
                $"Hay {articulosStockBajo} artículo{(articulosStockBajo == 1 ? "" : "s")} con stock bajo.",
                Severity.Warning,
                config =>
                {
                    // Más corta que el default de MudBlazor (5000ms): es un aviso
                    // informativo con acción propia, no algo que deba quedarse en
                    // pantalla tanto tiempo como un error o una confirmación.
                    config.VisibleStateDuration = 2500;

                    // RequireInteraction explícito en false: por defecto, MudBlazor
                    // exige cierre manual en CUALQUIER snackbar que tenga Action (ver
                    // MudBlazor.CommonSnackbarOptions.RequireInteraction), así que sin
                    // esto VisibleStateDuration de arriba no tendría ningún efecto y
                    // la notificación se quedaría en pantalla hasta que alguien la
                    // cierre a mano.
                    config.RequireInteraction = false;
                    config.Action = "Ver existencias";
                    config.ActionColor = Color.Inherit;
                    config.OnClick = _ =>
                    {
                        // stockBajo=true: ExistenciasInventario.razor lo lee para activar
                        // de entrada el interruptor "Solo artículos con stock bajo", así
                        // que tocar la notificación muestra ya esos artículos y no una
                        // pantalla en blanco a la espera de que alguien busque algo.
                        Navigation.NavigateTo("/inventario/existencias?stockBajo=true");
                        return Task.CompletedTask;
                    };
                });
        }
    }
}
